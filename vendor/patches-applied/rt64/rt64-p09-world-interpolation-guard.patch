diff --git a/src/render/rt64_p09_closure_guard.h b/src/render/rt64_p09_closure_guard.h
new file mode 100644
index 0000000..1509225
--- /dev/null
+++ b/src/render/rt64_p09_closure_guard.h
@@ -0,0 +1,162 @@
+//
+// RT64
+//
+// P09 articulated-closure guard for AUTO WORLD interpolation.
+//
+// A game that composes skeletal bone matrices on the CPU hands RT64 one
+// composed WORLD matrix per bone. RigidBody::lerp interpolates each of them
+// independently: translation along a chord, rotation along an arc, each about
+// its own origin. Every triangle that spans two WORLD slots (a joint) then
+// connects two vertices that are interpolated by unrelated rigid motions.
+// When the bones rotate by a large angle between the two frames the vertices
+// separate and the triangle becomes a long sliver (a "rod") that exists in
+// neither endpoint pose.
+//
+// Component-wise (elementwise) matrix lerp has the opposite property: vertex
+// positions are convex combinations of their endpoint positions, so no edge
+// can ever be longer than the longer of its endpoint edges. It is not rigid
+// (it shrinks a bone slightly while it rotates) but it can never tear a joint.
+//
+// The guard keeps the rigid interpolation wherever it is closed and switches a
+// transform to elementwise lerp only when rigid interpolation would make an
+// edge of a triangle that spans several WORLD slots longer than both of its
+// endpoint lengths. A switch propagates to the other end of the offending edge
+// until no such edge remains. Transforms for which the two interpolations agree
+// are never switched. No game, model, bone or display-list knowledge is used.
+//
+// Default ON. TOOIE_TEST_P09_CLOSURE_GUARD=0 restores the unguarded rigid
+// interpolation for paired A/B tests.
+//
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <vector>
+
+#include "common/rt64_common.h"
+
+namespace RT64 {
+    namespace p09ClosureGuard {
+        inline bool enabled() {
+            static int cached = -1;
+            if (cached < 0) {
+                const char *env = std::getenv("TOOIE_TEST_P09_CLOSURE_GUARD");
+                cached = (env != nullptr && env[0] == '0' && env[1] == '\0') ? 0 : 1;
+            }
+            return cached != 0;
+        }
+
+        struct Vec3 {
+            float x = 0.0f, y = 0.0f, z = 0.0f;
+        };
+
+        inline Vec3 transformPoint(const hlslpp::float4x4 &m, float x, float y, float z) {
+            const hlslpp::float4 r = hlslpp::mul(hlslpp::float4(x, y, z, 1.0f), m);
+            const float w = (std::fabs(float(r.w)) > 1e-12f) ? float(r.w) : 1.0f;
+            return { float(r.x) / w, float(r.y) / w, float(r.z) / w };
+        }
+
+        inline float distance(const Vec3 &a, const Vec3 &b) {
+            const float dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
+            return std::sqrt(dx * dx + dy * dy + dz * dz);
+        }
+
+        constexpr float CandidateDeviation = 1.0f; // rigid vs elementwise probe-point gap that makes a transform a candidate
+        constexpr float EdgeRatio = 1.25f;         // interpolated edge vs longer endpoint edge
+        constexpr float EdgeSlack = 1.0f;          // ... plus this absolute slack (world units)
+        constexpr int MaxIterations = 8;
+
+        // mapped[t]: transform t interpolates (paired with a previous transform); other transforms are CURRENT and must
+        // carry prev == cur == rigid == elementwise (they stay fixed and can only be neighbours of a switched transform).
+        // prev/cur: endpoint matrices. rigid/elementwise: both interpolations at the same weight.
+        // useElementwise[t] is set for each transform that must use the elementwise matrix.
+        // Returns the number of transforms switched.
+        inline uint32_t compute(size_t worldCount, const uint32_t *faceIndices, size_t faceIndexCount,
+            const uint16_t *worldIndices, uint32_t vertexCount, const float *posFloats, const std::vector<uint8_t> &mapped,
+            const std::vector<hlslpp::float4x4> &prev, const std::vector<hlslpp::float4x4> &cur,
+            const std::vector<hlslpp::float4x4> &rigid, const std::vector<hlslpp::float4x4> &elementwise,
+            std::vector<uint8_t> &useElementwise)
+        {
+            useElementwise.assign(worldCount, 0);
+            if (faceIndices == nullptr || worldIndices == nullptr || posFloats == nullptr) {
+                return 0;
+            }
+
+            // Candidates: transforms where rigid and elementwise interpolation visibly differ.
+            constexpr float Lever = 64.0f;
+            const float probes[4][3] = { { 0, 0, 0 }, { Lever, 0, 0 }, { 0, Lever, 0 }, { 0, 0, Lever } };
+            std::vector<uint8_t> candidate(worldCount, 0);
+            bool anyCandidate = false;
+            for (size_t t = 0; t < worldCount; t++) {
+                if (t >= mapped.size() || mapped[t] == 0) continue;
+                for (const auto &q : probes) {
+                    if (distance(transformPoint(rigid[t], q[0], q[1], q[2]), transformPoint(elementwise[t], q[0], q[1], q[2])) > CandidateDeviation) {
+                        candidate[t] = 1;
+                        anyCandidate = true;
+                        break;
+                    }
+                }
+            }
+            if (!anyCandidate) {
+                return 0;
+            }
+
+            // Triangles that span several WORLD slots, at least one of them a candidate.
+            struct Edge {
+                uint32_t a, b;          // WORLD slots of the two end vertices
+                float refLength;        // longer endpoint (prev/cur) length
+                Vec3 rigidA, rigidB, elemA, elemB;
+            };
+            std::vector<Edge> edges;
+            for (size_t f = 0; f + 2 < faceIndexCount; f += 3) {
+                const uint32_t v[3] = { faceIndices[f], faceIndices[f + 1], faceIndices[f + 2] };
+                if (v[0] >= vertexCount || v[1] >= vertexCount || v[2] >= vertexCount) continue;
+                const uint32_t w[3] = { worldIndices[v[0]], worldIndices[v[1]], worldIndices[v[2]] };
+                if (w[0] >= worldCount || w[1] >= worldCount || w[2] >= worldCount) continue;
+                if (w[0] == w[1] && w[1] == w[2]) continue;
+                if (!(candidate[w[0]] || candidate[w[1]] || candidate[w[2]])) continue;
+                Vec3 pPrev[3], pCur[3], pRigid[3], pElem[3];
+                for (int i = 0; i < 3; i++) {
+                    const float x = posFloats[size_t(v[i]) * 3], y = posFloats[size_t(v[i]) * 3 + 1], z = posFloats[size_t(v[i]) * 3 + 2];
+                    pPrev[i] = transformPoint(prev[w[i]], x, y, z);
+                    pCur[i] = transformPoint(cur[w[i]], x, y, z);
+                    pRigid[i] = transformPoint(rigid[w[i]], x, y, z);
+                    pElem[i] = transformPoint(elementwise[w[i]], x, y, z);
+                }
+                for (int e = 0; e < 3; e++) {
+                    const int a = e, b = (e + 1) % 3;
+                    if (w[a] == w[b]) continue;
+                    edges.push_back({ w[a], w[b], std::max(distance(pPrev[a], pPrev[b]), distance(pCur[a], pCur[b])),
+                        pRigid[a], pRigid[b], pElem[a], pElem[b] });
+                }
+            }
+
+            uint32_t switched = 0;
+            for (int iteration = 0; iteration < MaxIterations; iteration++) {
+                bool changed = false;
+                for (const Edge &e : edges) {
+                    if (useElementwise[e.a] && useElementwise[e.b]) continue;
+                    const Vec3 &pa = useElementwise[e.a] ? e.elemA : e.rigidA;
+                    const Vec3 &pb = useElementwise[e.b] ? e.elemB : e.rigidB;
+                    const float length = distance(pa, pb);
+                    const float ref = std::max(e.refLength, 1e-3f);
+                    if (length > EdgeRatio * ref && (length - ref) > EdgeSlack) {
+                        for (const uint32_t t : { e.a, e.b }) {
+                            if (candidate[t] && !useElementwise[t]) {
+                                useElementwise[t] = 1;
+                                switched++;
+                                changed = true;
+                            }
+                        }
+                    }
+                }
+                if (!changed) break;
+            }
+            return switched;
+        }
+    }
+}
diff --git a/src/render/rt64_p09_translation_coherence.h b/src/render/rt64_p09_translation_coherence.h
new file mode 100644
index 0000000..a37f363
--- /dev/null
+++ b/src/render/rt64_p09_translation_coherence.h
@@ -0,0 +1,147 @@
+//
+// RT64
+//
+// P09 articulated-translation coherence for AUTO WORLD interpolation.
+//
+// RigidBody::updateLinear (AUTO) may "hold" a transform's translation at
+// CURRENT (lerpTranslation == false) while rotation/scale/skew still
+// interpolate. That heuristic is meant to suppress interpolation across a
+// teleport of a whole object. It is evaluated per transform, so for an
+// articulated mesh a single bone whose velocity direction reverses (or whose
+// speed ratio jumps) is held while its neighbours keep interpolating. Any
+// triangle that spans such a bone and a neighbour (a joint) then pairs a
+// vertex placed with CURRENT translation and an interpolated rotation about
+// the CURRENT origin with a vertex that is fully interpolated; the edge
+// grows beyond both endpoint lengths (a stretched sliver).
+//
+// A teleport moves the whole object, so every transform of that object is
+// held. Transforms connected by a triangle that references several WORLD
+// slots are one rigid-articulated object. If at least one mapped transform
+// of such a connected set still interpolates translation, the object is
+// moving continuously and the held members are heuristic false positives:
+// they must interpolate translation too. Sets whose mapped transforms are
+// all held (a real teleport) and isolated transforms keep the original
+// decision. No game, model, bone or display-list knowledge is used.
+//
+// A transform that stays held after this pass AND belongs to a connected set of
+// several WORLD slots is a member of an articulated object the gate classed as a
+// teleport. Interpolating only its rotation/scale about the held CURRENT origin
+// swings its vertices off the endpoint chord and tears the joints, so such a
+// transform is shown wholly at CURRENT (heldMatrix). An isolated held transform
+// (a single rigid slot, no joint to tear) keeps the original RigidBody result.
+//
+// Default ON. TOOIE_TEST_P09_TRANSLATION_COHERENCE=0 restores the original
+// per-transform decision for paired A/B tests.
+//
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <numeric>
+#include <vector>
+
+#include "common/rt64_common.h"
+
+namespace RT64 {
+    namespace p09TranslationCoherence {
+        inline bool enabled() {
+            static int cached = -1;
+            if (cached < 0) {
+                const char *env = std::getenv("TOOIE_TEST_P09_TRANSLATION_COHERENCE");
+                cached = (env != nullptr && env[0] == '0' && env[1] == '\0') ? 0 : 1;
+            }
+            return cached != 0;
+        }
+
+        // Default ON. TOOIE_TEST_P09_GATE_SPEED_ONLY=0 keeps the AUTO gate's direction-change holds (paired A/B tests).
+        // The AUTO gate divides the speed by the cosine of the turn angle before comparing it with its tolerance, so every turn
+        // of 90 degrees or more holds the translation however slow the transform moves (a limb at the end of a swing).
+        // A direction change alone is not a teleport: with this switch on, a held WORLD transform whose raw speed passes the gate
+        // (RigidBody::lerpTranslationSpeedOnly) interpolates its translation. Only speed spikes keep the hold.
+        inline bool gateSpeedOnlyEnabled() {
+            static int cached = -1;
+            if (cached < 0) {
+                const char *env = std::getenv("TOOIE_TEST_P09_GATE_SPEED_ONLY");
+                cached = (env != nullptr && env[0] == '0' && env[1] == '\0') ? 0 : 1;
+            }
+            return cached != 0;
+        }
+
+        // Matrix of a held-at-CURRENT transform at the given weight: the previous pose at weight 0, CURRENT otherwise.
+        inline const hlslpp::float4x4 &heldMatrix(float weight, const hlslpp::float4x4 &prev, const hlslpp::float4x4 &cur) {
+            return (weight <= 0.0f) ? prev : cur;
+        }
+
+        inline uint32_t findRoot(std::vector<uint32_t> &parent, uint32_t i) {
+            while (parent[i] != i) {
+                parent[i] = parent[parent[i]];
+                i = parent[i];
+            }
+            return i;
+        }
+
+        // mapped[t] != 0: transform t is paired with a previous transform and interpolates.
+        // lerpTranslation[t] != 0: the AUTO gate allows translation interpolation for t.
+        // forceLerp[t] is set to 1 for each mapped, held transform that must interpolate translation.
+        // articulated (optional)[t] is set to 1 when t shares a triangle-connected set with at least one other WORLD slot.
+        // Returns the number of forced transforms.
+        inline uint32_t compute(size_t worldCount, const uint32_t *faceIndices, size_t faceIndexCount,
+            const uint16_t *worldIndices, uint32_t vertexCount, const std::vector<uint8_t> &mapped,
+            const std::vector<uint8_t> &lerpTranslation, std::vector<uint8_t> &forceLerp,
+            std::vector<uint8_t> *articulated = nullptr)
+        {
+            forceLerp.assign(worldCount, 0);
+            if (articulated != nullptr) articulated->assign(worldCount, 0);
+            bool anyHeld = false;
+            for (size_t t = 0; t < worldCount && t < mapped.size() && t < lerpTranslation.size(); t++) {
+                if (mapped[t] != 0 && lerpTranslation[t] == 0) {
+                    anyHeld = true;
+                    break;
+                }
+            }
+            if (!anyHeld || faceIndices == nullptr || worldIndices == nullptr) {
+                return 0;
+            }
+
+            std::vector<uint32_t> parent(worldCount);
+            std::iota(parent.begin(), parent.end(), 0u);
+            for (size_t f = 0; f + 2 < faceIndexCount; f += 3) {
+                const uint32_t v0 = faceIndices[f], v1 = faceIndices[f + 1], v2 = faceIndices[f + 2];
+                if (v0 >= vertexCount || v1 >= vertexCount || v2 >= vertexCount) continue;
+                const uint32_t w0 = worldIndices[v0], w1 = worldIndices[v1], w2 = worldIndices[v2];
+                if (w0 >= worldCount || w1 >= worldCount || w2 >= worldCount) continue;
+                if (w0 == w1 && w1 == w2) continue;
+                const uint32_t r0 = findRoot(parent, w0);
+                const uint32_t r1 = findRoot(parent, w1);
+                const uint32_t r2 = findRoot(parent, w2);
+                if (r1 != r0) parent[r1] = r0;
+                const uint32_t r2n = findRoot(parent, r2);
+                if (r2n != findRoot(parent, r0)) parent[r2n] = findRoot(parent, r0);
+            }
+
+            if (articulated != nullptr) {
+                std::vector<uint32_t> setSize(worldCount, 0);
+                for (size_t t = 0; t < worldCount; t++) setSize[findRoot(parent, uint32_t(t))]++;
+                for (size_t t = 0; t < worldCount; t++) (*articulated)[t] = (setSize[findRoot(parent, uint32_t(t))] > 1) ? 1 : 0;
+            }
+
+            std::vector<uint8_t> setInterpolates(worldCount, 0);
+            for (size_t t = 0; t < worldCount && t < mapped.size() && t < lerpTranslation.size(); t++) {
+                if (mapped[t] != 0 && lerpTranslation[t] != 0) {
+                    setInterpolates[findRoot(parent, uint32_t(t))] = 1;
+                }
+            }
+
+            uint32_t forced = 0;
+            for (size_t t = 0; t < worldCount && t < mapped.size() && t < lerpTranslation.size(); t++) {
+                if (mapped[t] != 0 && lerpTranslation[t] == 0 && setInterpolates[findRoot(parent, uint32_t(t))] != 0) {
+                    forceLerp[t] = 1;
+                    forced++;
+                }
+            }
+            return forced;
+        }
+    }
+}
diff --git a/src/render/rt64_p09_world_interpolation_guard.h b/src/render/rt64_p09_world_interpolation_guard.h
new file mode 100644
index 0000000..0d606b9
--- /dev/null
+++ b/src/render/rt64_p09_world_interpolation_guard.h
@@ -0,0 +1,225 @@
+//
+// RT64
+//
+// P09 articulated WORLD interpolation guards, applied as a post-pass over the
+// WORLD matrices that TransformProcessor::process just interpolated:
+//   1. translation coherence  (rt64_p09_translation_coherence.h)
+//   2. articulated closure    (rt64_p09_closure_guard.h)
+// See those headers for the mechanism. This pass only rewrites
+// lerpWorldTransforms / prevWorldTransforms / invTWorldTransforms entries of
+// transforms that must change; everything else is left exactly as produced by
+// RigidBody::lerp. Default ON; each guard has its own =0 environment switch. Inert while the endpoint-CURRENT
+// workaround is active (the Tooie default).
+//
+// When TOOIE_DIAG_P09_WORLD_LERP_AUDIT=<path> is set it also logs, per
+// workload, the edge-stretch of every triangle with the guarded result and
+// with the original (unguarded) interpolation of the same frame.
+//
+
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "hle/rt64_game_frame.h"
+#include "hle/rt64_workload.h"
+#include "render/rt64_p09_closure_guard.h"
+#include "render/rt64_p09_translation_coherence.h"
+#include "render/rt64_p09_world_lerp_audit.h"
+
+namespace RT64 {
+    inline bool p09WorldGuardExplicitElementwiseCandidate() {
+        static int cached = -1;
+        if (cached < 0) {
+            const char *a = std::getenv("TOOIE_TEST_P09_SELECTIVE_ELEMENTWISE_WORLD");
+            const char *b = std::getenv("TOOIE_TEST_P09_MULTI_ONLY_ELEMENTWISE_WORLD");
+            const bool on = (a != nullptr && a[0] != '\0' && a[0] != '0') || (b != nullptr && b[0] != '\0' && b[0] != '0');
+            cached = on ? 1 : 0;
+        }
+        return cached != 0;
+    }
+
+    // With TOOIE_DIAG_RSP_FORCE_ENDPOINT_CURRENT active (the Tooie default workaround) RSPProcessCS positions every vertex
+    // from the endpoint matrices, so the interpolated WORLD matrices do not reach the screen position. The guards stay
+    // inert there so the stable CURRENT/30 path is bit-for-bit unchanged.
+    inline bool p09WorldGuardEndpointCurrentActive() {
+        static int cached = -1;
+        if (cached < 0) {
+            const char *env = std::getenv("TOOIE_DIAG_RSP_FORCE_ENDPOINT_CURRENT");
+            cached = ((env != nullptr) && (env[0] != '\0') && (env[0] != '0')) ? 1 : 0;
+        }
+        return cached != 0;
+    }
+
+    // TOOIE_DIAG_P09_WORLD_LERP_SHADOW=1 (with the audit on): compute and audit/dump the guards but hand the renderer the
+    // original interpolation, so a rendered frame and its guarded counterfactual come from the identical workload.
+    inline bool p09WorldGuardShadow() {
+        static int cached = -1;
+        if (cached < 0) {
+            const char *env = std::getenv("TOOIE_DIAG_P09_WORLD_LERP_SHADOW");
+            cached = ((env != nullptr) && (env[0] != '\0') && (env[0] != '0')) ? 1 : 0;
+        }
+        return cached != 0;
+    }
+
+    // Must be called after the per-transform interpolation loop of one workload with a valid previous frame.
+    inline void p09ApplyWorldInterpolationGuards(Workload &workload, const GameFrameMap::WorkloadMap &workloadMap,
+        const DrawData &prevDrawData, float prevWeight, float curWeight)
+    {
+        DrawData &drawData = workload.drawData;
+        const size_t worldCount = drawData.worldTransforms.size();
+        P09WorldLerpAudit &audit = P09WorldLerpAudit::get();
+        const bool auditOn = audit.enabled();
+        const bool endpointCurrent = p09WorldGuardEndpointCurrentActive();
+        const bool coherenceOn = p09TranslationCoherence::enabled() && !endpointCurrent;
+        const bool guardOn = p09ClosureGuard::enabled() && !endpointCurrent;
+        if ((!auditOn && !coherenceOn && !guardOn) || p09WorldGuardExplicitElementwiseCandidate()) {
+            return;
+        }
+
+        if ((drawData.lerpWorldTransforms.size() != worldCount) || (drawData.prevWorldTransforms.size() != worldCount) ||
+            (drawData.invTWorldTransforms.size() != worldCount) || (workloadMap.transforms.size() < worldCount)) {
+            return;
+        }
+
+        const auto passStart = std::chrono::steady_clock::now();
+        const bool shadow = auditOn && p09WorldGuardShadow();
+        std::vector<interop::float4x4> shadowLerp, shadowPrev, shadowInvT;
+        if (shadow) {
+            shadowLerp = drawData.lerpWorldTransforms;
+            shadowPrev = drawData.prevWorldTransforms;
+            shadowInvT = drawData.invTWorldTransforms;
+        }
+        P09WorldLerpAuditFrame auditFrame;
+        const bool gateSpeedOnly = coherenceOn && p09TranslationCoherence::gateSpeedOnlyEnabled();
+        std::vector<uint8_t> mappedFlags(worldCount, 0), lerpTranslationFlags(worldCount, 0), gateReleased(worldCount, 0);
+        std::vector<hlslpp::float4x4> prevEnd(worldCount), curEnd(worldCount), rigid(worldCount), elementwise(worldCount);
+        for (size_t t = 0; t < worldCount; t++) {
+            const GameFrameMap::TransformMap &transformMap = workloadMap.transforms[t];
+            curEnd[t] = drawData.worldTransforms[t];
+            prevEnd[t] = curEnd[t];
+            rigid[t] = curEnd[t];
+            elementwise[t] = curEnd[t];
+            if (!transformMap.mapped) continue;
+            prevEnd[t] = prevDrawData.worldTransforms[transformMap.prevTransformIndex];
+            const hlslpp::float4x4 original = transformMap.rigidBody.lerp(curWeight, prevEnd[t], curEnd[t], true);
+            // A transform frozen at CURRENT by a diagnostic keeps the matrix it was given.
+            if ((curWeight < 1.0f) && (std::memcmp(&drawData.lerpWorldTransforms[t], &curEnd[t], sizeof(curEnd[t])) == 0) &&
+                (std::memcmp(&original, &curEnd[t], sizeof(curEnd[t])) != 0)) {
+                continue;
+            }
+            mappedFlags[t] = 1;
+            lerpTranslationFlags[t] = transformMap.rigidBody.lerpTranslation ? 1 : 0;
+            rigid[t] = original;
+            // A hold that only the AUTO gate's direction-change amplification asked for is a false positive: interpolate it.
+            if (gateSpeedOnly && !transformMap.rigidBody.lerpTranslation && transformMap.rigidBody.lerpTranslationSpeedOnly) {
+                lerpTranslationFlags[t] = 1;
+                gateReleased[t] = 1;
+                auditFrame.gateReleased++;
+                RigidBody released = transformMap.rigidBody;
+                released.lerpTranslation = true;
+                rigid[t] = released.lerp(curWeight, prevEnd[t], curEnd[t], true);
+            }
+        }
+
+        std::vector<uint8_t> forceTranslation, articulated;
+        if (coherenceOn) {
+            auditFrame.coherenceForced = p09TranslationCoherence::compute(worldCount, drawData.faceIndices.data(),
+                drawData.faceIndices.size(), drawData.worldIndices.data(), drawData.vertexCount(), mappedFlags,
+                lerpTranslationFlags, forceTranslation, &articulated);
+        }
+
+        if (gateSpeedOnly) {
+            if (forceTranslation.size() != worldCount) forceTranslation.assign(worldCount, 0);
+            for (size_t t = 0; t < worldCount; t++) {
+                if (gateReleased[t]) forceTranslation[t] = 1;
+            }
+        }
+
+        // A transform whose translation is still held after the coherence pass and that belongs to a multi-slot set is part of
+        // an articulated object the AUTO gate classed as a teleport (every mapped member of its set is held). Interpolating its
+        // rotation about the held CURRENT origin would tear the joints, so the whole transform is shown at CURRENT. An isolated
+        // held transform has no joint to tear and keeps the original RigidBody result.
+        auto heldToCurrent = [&](size_t t) {
+            return coherenceOn && mappedFlags[t] && !lerpTranslationFlags[t] && (t < articulated.size()) && (articulated[t] != 0) &&
+                !((t < forceTranslation.size()) && (forceTranslation[t] != 0));
+        };
+
+        // Rigid interpolation with the coherence correction (the candidate the closure guard starts from).
+        auto rigidAt = [&](size_t t, float weight) {
+            if (heldToCurrent(t)) return p09TranslationCoherence::heldMatrix(weight, prevEnd[t], curEnd[t]);
+            RigidBody body = workloadMap.transforms[t].rigidBody;
+            if ((t < forceTranslation.size()) && (forceTranslation[t] != 0)) body.lerpTranslation = true;
+            return body.lerp(weight, prevEnd[t], curEnd[t], true);
+        };
+
+        std::vector<hlslpp::float4x4> guardRigid(rigid);
+        for (size_t t = 0; t < worldCount; t++) {
+            if (!mappedFlags[t]) continue;
+            guardRigid[t] = rigidAt(t, curWeight);
+            elementwise[t] = lerpMatrix(prevEnd[t], curEnd[t], curWeight);
+        }
+
+        std::vector<uint8_t> useElementwise;
+        if (guardOn) {
+            auditFrame.guardElementwise = p09ClosureGuard::compute(worldCount, drawData.faceIndices.data(),
+                drawData.faceIndices.size(), drawData.worldIndices.data(), drawData.vertexCount(),
+                drawData.posFloats.data(), mappedFlags, prevEnd, curEnd, guardRigid, elementwise, useElementwise);
+        }
+
+        // Rewrite only the transforms whose matrix changes.
+        for (size_t t = 0; t < worldCount; t++) {
+            if (!mappedFlags[t]) continue;
+            const bool coherence = (t < forceTranslation.size()) && (forceTranslation[t] != 0);
+            const bool elementwiseUsed = (t < useElementwise.size()) && (useElementwise[t] != 0);
+            const bool held = heldToCurrent(t);
+            if (held) auditFrame.heldToCurrent++;
+            else if (!lerpTranslationFlags[t] && !coherence) auditFrame.heldIsolated++;
+            if (!coherence && !elementwiseUsed && !held) continue;
+            hlslpp::float4x4 curMatrix, prevMatrix;
+            if (elementwiseUsed) {
+                curMatrix = elementwise[t];
+                prevMatrix = lerpMatrix(prevEnd[t], curEnd[t], prevWeight);
+            }
+            else {
+                curMatrix = guardRigid[t];
+                prevMatrix = rigidAt(t, prevWeight);
+            }
+            drawData.lerpWorldTransforms[t] = curMatrix;
+            drawData.prevWorldTransforms[t] = prevMatrix;
+            drawData.invTWorldTransforms[t] = hlslpp::transpose(hlslpp::inverse(curMatrix));
+        }
+
+        if (auditOn) {
+            auditFrame.guardMicros = static_cast<uint32_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - passStart).count());
+            auditFrame.transformFlags.assign(worldCount, 0);
+            auditFrame.altLerp.resize(worldCount);
+            auditFrame.altSet.assign(worldCount, 0);
+            for (size_t t = 0; t < worldCount; t++) {
+                if (!mappedFlags[t]) continue;
+                const bool coherence = (t < forceTranslation.size()) && (forceTranslation[t] != 0);
+                const bool elementwiseUsed = (t < useElementwise.size()) && (useElementwise[t] != 0);
+                const bool held = heldToCurrent(t);
+                // bit1 = translation interpolates in the final matrix; bit4 = shown at CURRENT (teleport semantics).
+                auditFrame.transformFlags[t] = 1u | ((coherence || lerpTranslationFlags[t]) ? 2u : 0u) | (coherence ? 4u : 0u) | (elementwiseUsed ? 8u : 0u) | (held ? 16u : 0u);
+                RigidBody finalBody = workloadMap.transforms[t].rigidBody;
+                if (coherence) finalBody.lerpTranslation = true;
+                audit.record(auditFrame, workload.workloadId, static_cast<uint32_t>(t), workloadMap.transforms[t].prevTransformIndex,
+                    drawData.worldTransformGroups[t], prevWeight, curWeight, prevEnd[t], curEnd[t], finalBody,
+                    workloadMap.transforms[t].rigidBody, drawData.lerpWorldTransforms[t], elementwiseUsed);
+            }
+            const uint32_t originalStretched = audit.auditTriangles(auditFrame, workload.workloadId, curWeight, drawData);
+            if (originalStretched > 0) audit.dumpWorkload(auditFrame, workload.workloadId, curWeight, drawData);
+            audit.endWorkload(auditFrame, workload.workloadId, prevWeight, curWeight, true);
+        }
+        if (shadow) {
+            drawData.lerpWorldTransforms = shadowLerp;
+            drawData.prevWorldTransforms = shadowPrev;
+            drawData.invTWorldTransforms = shadowInvT;
+        }
+    }
+}
diff --git a/src/render/rt64_p09_world_lerp_audit.h b/src/render/rt64_p09_world_lerp_audit.h
new file mode 100644
index 0000000..47bc0a5
--- /dev/null
+++ b/src/render/rt64_p09_world_lerp_audit.h
@@ -0,0 +1,346 @@
+//
+// RT64
+//
+// P09 default-OFF audit of the per-transform WORLD interpolation decision.
+// Enabled only when TOOIE_DIAG_P09_WORLD_LERP_AUDIT=<output path> is set.
+// Records, per mapped WORLD transform, the RigidBody component flags and the
+// geometric deviation of the lerped matrix from the endpoint chord of four
+// probe points. No game/model/bone knowledge. Read-only: never alters the
+// matrix handed to the renderer.
+//
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "common/rt64_math.h"
+#include "hle/rt64_rigid_body.h"
+#include "hle/rt64_workload.h"
+
+namespace RT64 {
+    struct P09WorldLerpAuditFrame {
+        uint32_t mapped = 0;
+        uint32_t translationHeld = 0;      // !lerpTranslation
+        uint32_t translationHeldMoving = 0; // !lerpTranslation && |dT| > 1
+        uint32_t overshoot = 0;            // lerp leaves the endpoint chord
+        uint32_t invalidDecomp = 0;
+        uint32_t decompMismatch = 0;       // stored prev decomposition != PREV matrix
+        uint32_t coherenceForced = 0;      // held transforms forced to interpolate translation
+        uint32_t guardElementwise = 0;     // transforms switched to elementwise by the closure guard
+        uint32_t guardMicros = 0;          // wall time of the guard pass (prep + compute)
+        uint32_t heldIsolated = 0;         // mapped, translation-held transforms outside any multi-slot set (original result kept)
+        uint32_t heldToCurrent = 0;        // held transforms of multi-slot sets shown at CURRENT
+        uint32_t gateReleased = 0;         // translation holds released because only the AUTO gate's direction-change amplification asked for them
+        std::vector<uint8_t> transformFlags; // per WORLD index: bit0 mapped, bit1 lerpTranslation, bit2 coherence-forced, bit3 closure-guard elementwise
+        std::vector<hlslpp::float4x4> altLerp; // per WORLD index: original (unguarded) RigidBody lerp (counterfactual)
+        std::vector<uint8_t> altSet;
+    };
+
+    class P09WorldLerpAudit {
+    public:
+        static P09WorldLerpAudit &get() {
+            static P09WorldLerpAudit inst;
+            return inst;
+        }
+
+        bool enabled() const { return file != nullptr; }
+
+        static hlslpp::float3 probe(const hlslpp::float4x4 &m, float x, float y, float z) {
+            const hlslpp::float4 r = hlslpp::mul(hlslpp::float4(x, y, z, 1.0f), m);
+            const float w = (std::fabs(float(r.w)) > 1e-12f) ? float(r.w) : 1.0f;
+            return hlslpp::float3(float(r.x) / w, float(r.y) / w, float(r.z) / w);
+        }
+
+        static float len(const hlslpp::float3 &v) {
+            return std::sqrt(float(v.x) * float(v.x) + float(v.y) * float(v.y) + float(v.z) * float(v.z));
+        }
+
+        // Distance from p to segment [a,b].
+        static float distSegment(const hlslpp::float3 &p, const hlslpp::float3 &a, const hlslpp::float3 &b) {
+            const hlslpp::float3 ab = b - a;
+            const float abl2 = float(ab.x) * float(ab.x) + float(ab.y) * float(ab.y) + float(ab.z) * float(ab.z);
+            float t = 0.0f;
+            if (abl2 > 1e-12f) {
+                const hlslpp::float3 ap = p - a;
+                t = (float(ap.x) * float(ab.x) + float(ap.y) * float(ab.y) + float(ap.z) * float(ab.z)) / abl2;
+                t = std::min(1.0f, std::max(0.0f, t));
+            }
+            return len(p - (a + ab * t));
+        }
+
+        void record(P09WorldLerpAuditFrame &frame, uint64_t workloadId, uint32_t t, uint32_t prevT, uint32_t group,
+            float prevWeight, float curWeight, const hlslpp::float4x4 &prev, const hlslpp::float4x4 &cur,
+            const RigidBody &rb, const RigidBody &originalBody, const hlslpp::float4x4 &lerped, bool elementwise)
+        {
+            frame.mapped++;
+            if (frame.altLerp.size() <= t) {
+                frame.altLerp.resize(t + 1);
+                frame.altSet.resize(t + 1, 0);
+            }
+            // Counterfactual: the matrix the original per-transform RigidBody interpolation would have produced.
+            frame.altLerp[t] = originalBody.lerp(curWeight, prev, cur, true);
+            frame.altSet[t] = 1;
+            const DecomposedTransform &dPrev = rb.transforms[rb.transformIndex ^ 1];
+            const DecomposedTransform &dCur = rb.transforms[rb.transformIndex];
+            if (!rb.lerpTranslation) frame.translationHeld++;
+            if (rb.lerpDecompose && (!dPrev.valid || !dCur.valid)) frame.invalidDecomp++;
+
+            const float dT = len(hlslpp::float3(cur[3].xyz) - hlslpp::float3(prev[3].xyz));
+            if (!rb.lerpTranslation && dT > 1.0f) frame.translationHeldMoving++;
+
+            constexpr float L = 64.0f;
+            const float pts[4][3] = { { 0, 0, 0 }, { L, 0, 0 }, { 0, L, 0 }, { 0, 0, L } };
+            float spread = 0.0f, over = 0.0f, ewdev = 0.0f;
+            for (const auto &p : pts) {
+                const hlslpp::float3 a = probe(prev, p[0], p[1], p[2]);
+                const hlslpp::float3 b = probe(cur, p[0], p[1], p[2]);
+                const hlslpp::float3 l = probe(lerped, p[0], p[1], p[2]);
+                spread = std::max(spread, len(b - a));
+                over = std::max(over, distSegment(l, a, b));
+                ewdev = std::max(ewdev, len(l - (a + (b - a) * curWeight)));
+            }
+
+            float prevErr = -1.0f, curErr = -1.0f;
+            if (rb.lerpDecompose && dPrev.valid && dCur.valid) {
+                prevErr = matrixDifference(recomposeMatrix(dPrev.rotation, dPrev.scale, dPrev.skew, dPrev.translation, dPrev.perspective), prev);
+                curErr = matrixDifference(recomposeMatrix(dCur.rotation, dCur.scale, dCur.skew, dCur.translation, dCur.perspective), cur);
+                if (prevErr > 0.05f) frame.decompMismatch++;
+            }
+
+            const bool geomFlag = over > std::max(2.0f, 0.5f * spread);
+            if (geomFlag) frame.overshoot++;
+            const bool heldFlag = !rb.lerpTranslation && dT > 1.0f;
+            if (!geomFlag && !heldFlag && prevErr <= 0.05f) return;
+
+            std::lock_guard<std::mutex> lock(mu);
+            if (rows >= RowCap) return;
+            rows++;
+            std::fprintf(file,
+                "ROW wl=%llu t=%u prev=%u grp=%u wp=%.4f wc=%.4f ew=%d lerpT=%d lerpR=%d lerpS=%d lerpK=%d lerpP=%d dec=%d "
+                "valid=%d%d flip=%d%d dT=%.4f spread=%.4f over=%.4f ewdev=%.4f vel=%.4f,%.4f,%.4f angVel=%.5f "
+                "scaleP=%.5f,%.5f,%.5f scaleC=%.5f,%.5f,%.5f skewP=%.5f,%.5f,%.5f skewC=%.5f,%.5f,%.5f prevErr=%.5f curErr=%.5f",
+                (unsigned long long)workloadId, t, prevT, group, prevWeight, curWeight, elementwise ? 1 : 0,
+                rb.lerpTranslation ? 1 : 0, rb.lerpRotation ? 1 : 0, rb.lerpScale ? 1 : 0, rb.lerpSkew ? 1 : 0,
+                rb.lerpPerspective ? 1 : 0, rb.lerpDecompose ? 1 : 0, dPrev.valid ? 1 : 0, dCur.valid ? 1 : 0,
+                dPrev.coordinateFlip ? 1 : 0, dCur.coordinateFlip ? 1 : 0, dT, spread, over, ewdev,
+                float(rb.linearVelocity.x), float(rb.linearVelocity.y), float(rb.linearVelocity.z), rb.angularVelocity,
+                float(dPrev.scale.x), float(dPrev.scale.y), float(dPrev.scale.z),
+                float(dCur.scale.x), float(dCur.scale.y), float(dCur.scale.z),
+                float(dPrev.skew.x), float(dPrev.skew.y), float(dPrev.skew.z),
+                float(dCur.skew.x), float(dCur.skew.y), float(dCur.skew.z), prevErr, curErr);
+            auto dump = [&](const char *name, const hlslpp::float4x4 &m) {
+                std::fprintf(file, " %s=", name);
+                for (int i = 0; i < 4; i++)
+                    for (int j = 0; j < 4; j++)
+                        std::fprintf(file, "%s%.6g", (i | j) ? "," : "", float(m[i][j]));
+            };
+            dump("PREV", prev);
+            dump("CUR", cur);
+            dump("LERP", lerped);
+            std::fprintf(file, "\n");
+        }
+
+
+        // Edge-stretch audit over every face of a workload. For each triangle edge the world-space length
+        // under PREV, CUR and the interpolated matrices is compared; an edge that grows beyond both endpoint
+        // lengths cannot come from a rigid in-between and is the rendered "rod" artefact.
+        // Returns the number of cross-WORLD triangles the original (unguarded) interpolation would stretch.
+        uint32_t auditTriangles(const P09WorldLerpAuditFrame &frame, uint64_t workloadId, float curWeight, const DrawData &d) {
+            const size_t nWorld = d.lerpWorldTransforms.size();
+            if (nWorld == 0 || d.endpointWorldTransforms.size() < nWorld * 2) return 0;
+            const uint32_t nVert = d.vertexCount();
+            auto world = [&](uint32_t v, int which) -> hlslpp::float3 {
+                const uint32_t wi = d.worldIndices[v];
+                const float x = d.posFloats[size_t(v) * 3 + 0], y = d.posFloats[size_t(v) * 3 + 1], z = d.posFloats[size_t(v) * 3 + 2];
+                if (which == 3 && wi < frame.altSet.size() && frame.altSet[wi] != 0) {
+                    return probe(frame.altLerp[wi], x, y, z);
+                }
+                const interop::float4x4 &m = (which == 0) ? d.endpointWorldTransforms[size_t(wi) * 2]
+                    : (which == 1 ? d.endpointWorldTransforms[size_t(wi) * 2 + 1] : d.lerpWorldTransforms[wi]);
+                return probe(*reinterpret_cast<const hlslpp::float4x4 *>(&m), x, y, z);
+            };
+            uint32_t faces = 0, cross = 0, crossBad = 0, intraBad = 0, detail = 0, altCrossBad = 0, altIntraBad = 0;
+            float worstCross = 0.0f, worstIntra = 0.0f, baselineWorstCross = 0.0f;
+            const size_t nFaceTri = d.faceIndices.size() / 3;
+            for (size_t f = 0; f < nFaceTri; f++) {
+                const uint32_t v[3] = { d.faceIndices[f * 3], d.faceIndices[f * 3 + 1], d.faceIndices[f * 3 + 2] };
+                if (v[0] >= nVert || v[1] >= nVert || v[2] >= nVert) continue;
+                const uint16_t w[3] = { d.worldIndices[v[0]], d.worldIndices[v[1]], d.worldIndices[v[2]] };
+                if (w[0] >= nWorld || w[1] >= nWorld || w[2] >= nWorld) continue;
+                faces++;
+                const bool isCross = (w[0] != w[1]) || (w[1] != w[2]);
+                if (isCross) cross++;
+                hlslpp::float3 pp[3], pc[3], pl[3];
+                for (int i = 0; i < 3; i++) { pp[i] = world(v[i], 0); pc[i] = world(v[i], 1); pl[i] = world(v[i], 2); }
+                {
+                    hlslpp::float3 pa[3];
+                    for (int i = 0; i < 3; i++) pa[i] = world(v[i], 3);
+                    float altWorst = 0.0f;
+                    for (int e = 0; e < 3; e++) {
+                        const int a = e, b = (e + 1) % 3;
+                        const float lp = len(pp[a] - pp[b]), lc = len(pc[a] - pc[b]), la = len(pa[a] - pa[b]);
+                        const float ref = std::max(std::max(lp, lc), 1e-3f);
+                        if (la > 1.5f * ref && (la - ref) > 3.0f) altWorst = std::max(altWorst, la / ref);
+                    }
+                    if (altWorst > 0.0f) {
+                        if (isCross) { altCrossBad++; baselineWorstCross = std::max(baselineWorstCross, altWorst); } else { altIntraBad++; }
+                    }
+                }
+                float worst = 0.0f; int worstEdge = 0;
+                for (int e = 0; e < 3; e++) {
+                    const int a = e, b = (e + 1) % 3;
+                    const float lp = len(pp[a] - pp[b]), lc = len(pc[a] - pc[b]), ll = len(pl[a] - pl[b]);
+                    const float ref = std::max(std::max(lp, lc), 1e-3f);
+                    if (ll > 1.5f * ref && (ll - ref) > 3.0f) {
+                        const float ratio = ll / ref;
+                        if (ratio > worst) { worst = ratio; worstEdge = e; }
+                    }
+                }
+                if (worst <= 0.0f) continue;
+                if (isCross) { crossBad++; worstCross = std::max(worstCross, worst); }
+                else { intraBad++; worstIntra = std::max(worstIntra, worst); }
+                if (detail < 6) {
+                    detail++;
+                    std::lock_guard<std::mutex> lock(mu);
+                    if (triRows >= TriRowCap) continue;
+                    triRows++;
+                    std::fprintf(file, "TRI wl=%llu wc=%.4f face=%zu cross=%d ratio=%.3f edge=%d", (unsigned long long)workloadId, curWeight, f, isCross ? 1 : 0, worst, worstEdge);
+                    for (int i = 0; i < 3; i++) {
+                        const uint8_t fl = (w[i] < frame.transformFlags.size()) ? frame.transformFlags[w[i]] : 0;
+                        std::fprintf(file, " v%d[w=%u map=%d lerpT=%d forcedT=%d guardE=%d local=%.3f,%.3f,%.3f P=%.3f,%.3f,%.3f C=%.3f,%.3f,%.3f L=%.3f,%.3f,%.3f]",
+                            i, (unsigned)w[i], fl & 1, (fl >> 1) & 1, (fl >> 2) & 1, (fl >> 3) & 1,
+                            d.posFloats[size_t(v[i]) * 3], d.posFloats[size_t(v[i]) * 3 + 1], d.posFloats[size_t(v[i]) * 3 + 2],
+                            float(pp[i].x), float(pp[i].y), float(pp[i].z), float(pc[i].x), float(pc[i].y), float(pc[i].z),
+                            float(pl[i].x), float(pl[i].y), float(pl[i].z));
+                    }
+                    std::fprintf(file, "\n");
+                }
+            }
+            // Vertex overshoot: interpolated vertex farther from its endpoint chord than half the chord (+3 units).
+            // Catches isolated fragments that drift without stretching any edge.
+            uint32_t vertOver = 0, vertOverHeld = 0, vertOverDetail = 0;
+            float worstVertOver = 0.0f;
+            for (uint32_t v = 0; v < nVert; v++) {
+                const uint16_t wi = d.worldIndices[v];
+                if (wi >= nWorld || wi >= frame.transformFlags.size() || (frame.transformFlags[wi] & 1) == 0) continue;
+                const hlslpp::float3 a = world(v, 0), b = world(v, 1), l = world(v, 2);
+                const float chord = len(b - a);
+                const float off = distSegment(l, a, b);
+                if (off > 0.5f * chord + 3.0f) {
+                    vertOver++;
+                    if ((frame.transformFlags[wi] & 2) == 0) vertOverHeld++;
+                    worstVertOver = std::max(worstVertOver, off);
+                    if (vertOverDetail < 4) {
+                        vertOverDetail++;
+                        std::lock_guard<std::mutex> lock2(mu);
+                        std::fprintf(file, "VOVER wl=%llu wc=%.4f v=%u w=%u lerpT=%d forcedT=%d guardE=%d chord=%.3f off=%.3f local=%.3f,%.3f,%.3f P=%.3f,%.3f,%.3f C=%.3f,%.3f,%.3f L=%.3f,%.3f,%.3f\n",
+                            (unsigned long long)workloadId, curWeight, v, (unsigned)wi, (frame.transformFlags[wi] >> 1) & 1, (frame.transformFlags[wi] >> 2) & 1,
+                            (frame.transformFlags[wi] >> 3) & 1, chord, off, d.posFloats[size_t(v) * 3], d.posFloats[size_t(v) * 3 + 1], d.posFloats[size_t(v) * 3 + 2],
+                            float(a.x), float(a.y), float(a.z), float(b.x), float(b.y), float(b.z), float(l.x), float(l.y), float(l.z));
+                    }
+                }
+            }
+            std::lock_guard<std::mutex> lock(mu);
+            std::fprintf(file, "VOVERSUM wl=%llu wc=%.4f vertices=%u overshoot=%u overshootHeldTranslation=%u worstOff=%.3f\n",
+                (unsigned long long)workloadId, curWeight, nVert, vertOver, vertOverHeld, worstVertOver);
+            std::fprintf(file, "TRISUM wl=%llu wc=%.4f faces=%u cross=%u crossStretched=%u intraStretched=%u worstCross=%.3f worstIntra=%.3f baselineCrossStretched=%u baselineIntraStretched=%u baselineWorstCross=%.3f coherenceForced=%u guardElementwise=%u guardMicros=%u\n",
+                (unsigned long long)workloadId, curWeight, faces, cross, crossBad, intraBad, worstCross, worstIntra, altCrossBad, altIntraBad, baselineWorstCross, frame.coherenceForced, frame.guardElementwise, frame.guardMicros);
+            return altCrossBad;
+        }
+
+        // Default-off (TOOIE_DIAG_P09_WORLD_LERP_DUMP=<dir>): binary dump of one workload so a CPU reconstruction can draw
+        // the PREV, CUR, original-interpolation and guarded poses of the SAME frame. Little-endian, version 1:
+        //   "P9WD" u32 version u64 workloadId f32 curWeight u32 nVert u32 nFace u32 nWorld u32 nViewProj
+        //   u32 faces[3*nFace]; u32 worldIndex[nVert]; u32 viewProjIndex[nVert]; f32 local[3*nVert];
+        //   per WORLD: f32 prev[16] cur[16] original[16] final[16] u32 flags; f32 viewProj[nViewProj][16].
+        // Original = unguarded RigidBody lerp, final = matrix handed to the renderer (or the shadow guard result).
+        bool dumpEnabled() const { return !dumpDir.empty(); }
+
+        void dumpWorkload(const P09WorldLerpAuditFrame &frame, uint64_t workloadId, float curWeight, const DrawData &d) {
+            if (dumpDir.empty()) return;
+            const size_t nWorld = d.lerpWorldTransforms.size();
+            const uint32_t nVert = d.vertexCount();
+            if (nWorld == 0 || d.endpointWorldTransforms.size() < nWorld * 2 || d.viewProjIndices.size() < nVert) return;
+            {
+                std::lock_guard<std::mutex> lock(mu);
+                if (dumps >= dumpMax) return;
+                dumps++;
+            }
+            char path[1024];
+            std::snprintf(path, sizeof(path), "%s/wl%llu_wc%.4f.p9wd", dumpDir.c_str(), (unsigned long long)workloadId, curWeight);
+            FILE *out = std::fopen(path, "wb");
+            if (out == nullptr) return;
+            auto u32 = [&](uint32_t v) { std::fwrite(&v, 4, 1, out); };
+            std::fwrite("P9WD", 1, 4, out);
+            u32(1);
+            std::fwrite(&workloadId, 8, 1, out);
+            std::fwrite(&curWeight, 4, 1, out);
+            const uint32_t nFace = uint32_t(d.faceIndices.size() / 3);
+            const uint32_t nVP = uint32_t(d.viewProjTransforms.size());
+            u32(nVert); u32(nFace); u32(uint32_t(nWorld)); u32(nVP);
+            std::fwrite(d.faceIndices.data(), 4, size_t(nFace) * 3, out);
+            for (uint32_t v = 0; v < nVert; v++) u32(d.worldIndices[v]);
+            for (uint32_t v = 0; v < nVert; v++) u32(d.viewProjIndices[v]);
+            std::fwrite(d.posFloats.data(), 4, size_t(nVert) * 3, out);
+            for (size_t t = 0; t < nWorld; t++) {
+                const bool set = t < frame.altSet.size() && frame.altSet[t] != 0;
+                const interop::float4x4 &fin = d.lerpWorldTransforms[t];
+                const interop::float4x4 &orig = set ? *reinterpret_cast<const interop::float4x4 *>(&frame.altLerp[t]) : fin;
+                std::fwrite(&d.endpointWorldTransforms[t * 2], 64, 1, out);
+                std::fwrite(&d.endpointWorldTransforms[t * 2 + 1], 64, 1, out);
+                std::fwrite(&orig, 64, 1, out);
+                std::fwrite(&fin, 64, 1, out);
+                u32(t < frame.transformFlags.size() ? frame.transformFlags[t] : 0);
+            }
+            if (nVP > 0) std::fwrite(d.viewProjTransforms.data(), 64, nVP, out);
+            std::fclose(out);
+        }
+
+        void endWorkload(const P09WorldLerpAuditFrame &frame, uint64_t workloadId, float prevWeight, float curWeight, bool prevValid) {
+            std::lock_guard<std::mutex> lock(mu);
+            if (frameLines >= FrameCap) return;
+            frameLines++;
+            std::fprintf(file, "FRAME wl=%llu wp=%.4f wc=%.4f prevValid=%d mapped=%u transHeld=%u transHeldMoving=%u overshoot=%u invalidDecomp=%u decompMismatch=%u coherenceForced=%u heldIsolated=%u heldToCurrent=%u gateReleased=%u\n",
+                (unsigned long long)workloadId, prevWeight, curWeight, prevValid ? 1 : 0, frame.mapped, frame.translationHeld,
+                frame.translationHeldMoving, frame.overshoot, frame.invalidDecomp, frame.decompMismatch, frame.coherenceForced,
+                frame.heldIsolated, frame.heldToCurrent, frame.gateReleased);
+            std::fflush(file);
+        }
+
+    private:
+        static constexpr uint32_t RowCap = 400000;
+        static constexpr uint32_t FrameCap = 400000;
+        static constexpr uint32_t TriRowCap = 200000;
+        uint32_t triRows = 0;
+        FILE *file = nullptr;
+        std::mutex mu;
+        uint32_t rows = 0;
+        uint32_t frameLines = 0;
+        std::string dumpDir;
+        uint32_t dumps = 0;
+        uint32_t dumpMax = 600;
+
+        P09WorldLerpAudit() {
+            const char *path = std::getenv("TOOIE_DIAG_P09_WORLD_LERP_AUDIT");
+            if (path != nullptr && path[0] != '\0') {
+                file = std::fopen(path, "w");
+            }
+            const char *dir = std::getenv("TOOIE_DIAG_P09_WORLD_LERP_DUMP");
+            if (file != nullptr && dir != nullptr && dir[0] != '\0') {
+                dumpDir = dir;
+            }
+            const char *max = std::getenv("TOOIE_DIAG_P09_WORLD_LERP_DUMP_MAX");
+            if (max != nullptr && max[0] != '\0') {
+                dumpMax = uint32_t(std::strtoul(max, nullptr, 10));
+            }
+        }
+    };
+}

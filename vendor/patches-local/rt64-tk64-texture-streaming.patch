@@ -0,0 +1,90 @@
+//
+// TK64
+//
+// Copyright (c) 2026 The TK64 contributors. Licensed under the MIT license. See LICENSE file for details.
+//
+// Texture level of detail measured on the CPU, per triangle, for replacement textures. Phase 3 of the per-distance mip
+// streaming plan: it only measures and reports; nothing in the rendered image changes. See docs/specs/texture-lod.md.
+//
+
+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <string>
+
+namespace tk64 {
+    // A level of detail is log2 of the texels covered by one pixel along the axis the sampler uses (0 means one texel per
+    // pixel, 1 means two texels per pixel and mip 1 is enough, negative means magnified).
+    constexpr float TextureLodNone = std::numeric_limits<float>::infinity();   // nothing measured
+    constexpr float TextureLodFull = -std::numeric_limits<float>::infinity();  // needs the full-resolution mip
+
+    // Anisotropy assumed for the sampler that reads replacement textures.
+    constexpr float TextureLodMaxAnisotropy = 16.0f;
+
+    // Added to a measured level before choosing mips: RT64's replacement samplers use a mip bias of -0.25
+    // (rt64_shader_library.cpp, TextureSampler.hlsli), and 0.25 more is a margin for the per-triangle estimate against the
+    // GPU's per-quad derivatives. With it, the Maximum quality level keeps every mip the GPU would sample.
+    constexpr float TextureLodSamplerBias = -0.5f;
+
+    // True when TK64_DIAG_TEXTURE_LOD names a report file. Read once.
+    bool textureLodEnabled();
+
+    // TK64_TEST_TEXTURE_FIRST_MIP=<n>: load every replacement DDS from mip n down, for testing partial loads. 0 (the
+    // default) loads whole files. Read once; clamped to 0..15.
+    uint32_t textureTestFirstMip();
+
+    // First mip actually loaded for a file with mipCount mips: the request, kept within the file's mips.
+    uint32_t textureFirstMip(uint32_t requested, uint32_t mipCount);
+
+    // TK64_TEST_FAIL_TEXTURE_ALLOC=<n>: every n-th replacement texture allocation is treated as failed, to test the
+    // fallback. 0 or unset: never. Thread-safe.
+    bool textureAllocationTestFailure();
+
+    // Streaming events shown in the report's window line. Thread-safe.
+    enum class TextureStreamEvent { FirstLoad, Request, Swap };
+    void countTextureStreamEvent(TextureStreamEvent event);
+
+    // Replacement allocations that failed, real or simulated. Thread-safe.
+    void countTextureAllocationFailure();
+    uint64_t textureAllocationFailures();
+
+    // Horizontal clip bound used for the measurement, as a multiple of w. Wider than the native 4:3 volume so geometry in
+    // the widescreen strips is measured too; measuring a little outside the image only makes the result finer.
+    constexpr float TextureLodGuardX = 2.0f;
+
+    // Level of detail of one triangle. clip holds the clip-space x, y, z, w of each vertex (OpenGL depth range, visible
+    // when -w <= z), u/v are texture coordinates in texels of the tile and viewportScale converts normalized device
+    // coordinates to native framebuffer pixels. The triangle is clipped to the near plane and to the image (x within
+    // TextureLodGuardX * w, y within w); with perspective-correct texture coordinates the level is evaluated exactly at
+    // each corner of the visible polygon and the finest one is returned. TextureLodNone when nothing is visible or the
+    // triangle is seen edge-on; TextureLodFull when the texture coordinates do not vary (texture generation).
+    float triangleTexelLod(const float clip[3][4], const float u[3], const float v[3], float viewportScaleX, float viewportScaleY, float maxAnisotropy = TextureLodMaxAnisotropy);
+
+    // Level of detail of a texture rectangle from its per-pixel steps (s5.10 fixed point, 1 << 10 is one texel per pixel).
+    float rectangleTexelLod(int32_t dsdx, int32_t dtdy);
+
+    // Report of the levels the replacement textures needed, written to the TK64_DIAG_TEXTURE_LOD file every few seconds:
+    // per file, the lowest level seen and the top mip each of the five quality levels would keep resident.
+    struct TextureLodSample {
+        std::string relativePath;
+        uint32_t width = 0;
+        uint32_t height = 0;
+        uint32_t mipmaps = 0;
+        uint64_t memorySize = 0;     // whole mip chain of the file
+        uint64_t residentSize = 0;   // what is loaded now
+        float lod = TextureLodNone;
+    };
+
+    // Bias of the five quality levels, from Maximum (index 0) to Minimum (index 4).
+    constexpr float TextureLodLevelBias[5] = { 0.0f, 1.0f, 1.5f, 2.0f, 3.0f };
+
+    // Top mip a quality bias would keep for a texture with the given mip count. TextureLodNone and TextureLodFull keep 0.
+    uint32_t textureLodTopMip(float lod, float bias, uint32_t mipmaps);
+
+    // Approximate bytes of a texture whose top mip is topMip, from the bytes of the whole mip chain.
+    uint64_t textureLodBytes(uint64_t memorySize, uint32_t topMip);
+
+    // Adds a sample from the render thread. Thread-safe.
+    void recordTextureLod(const TextureLodSample &sample);
+};
diff --git a/src/tk64/tk64_texture_residency.cpp b/src/tk64/tk64_texture_residency.cpp
new file mode 100644
index 0000000..4effff0
--- /dev/null
+++ b/src/tk64/tk64_texture_residency.cpp
@@ -0,0 +1,171 @@
+//
+// TK64
+//
+// Copyright (c) 2026 The TK64 contributors. Licensed under the MIT license. See LICENSE file for details.
+//
+
+#include "tk64_texture_residency.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdlib>
+#include <mutex>
+
+#include "tk64_texture_lod.h"
+
+namespace tk64 {
+    static std::atomic<int> hostStreamingLevel{ -1 };
+    static std::atomic<bool> streamingSupported{ false };
+    static std::atomic<uint64_t> hostStreamingBudget{ 0 };
+    static std::atomic<uint64_t> automaticStreamingBudget{ 0 };
+
+    // -1 when the variable is absent or empty.
+    static long environmentNumber(const char *name) {
+        const char *value = std::getenv(name);
+        if ((value == nullptr) || (value[0] == '\0')) {
+            return -1;
+        }
+
+        return std::strtol(value, nullptr, 10);
+    }
+
+    uint32_t textureStreamingLevel() {
+        static const long killSwitch = environmentNumber("TK64_TEXTURE_STREAMING");
+        static const long testLevel = environmentNumber("TK64_TEST_TEXTURE_STREAMING");
+        if (!streamingSupported.load(std::memory_order_acquire) || (killSwitch == 0)) {
+            return 0;
+        }
+
+        if (testLevel >= 0) {
+            return uint32_t(std::clamp(testLevel, 0L, 5L));
+        }
+
+        const int host = hostStreamingLevel.load(std::memory_order_acquire);
+        return (host > 0) ? uint32_t(std::min(host, 5)) : 0;
+    }
+
+    void requestTextureStreamingLevel(uint32_t level) {
+        hostStreamingLevel.store(int(std::min(level, 5U)), std::memory_order_release);
+    }
+
+    void setTextureStreamingSupported(bool supported) {
+        streamingSupported.store(supported, std::memory_order_release);
+    }
+
+    uint64_t textureStreamingBudget() {
+        static const long testMegabytes = environmentNumber("TK64_TEST_TEXTURE_STREAMING_BUDGET_MB");
+        if (testMegabytes > 0) {
+            return uint64_t(testMegabytes) * 1024ULL * 1024ULL;
+        }
+
+        const uint64_t host = hostStreamingBudget.load(std::memory_order_acquire);
+        return (host > 0) ? host : automaticStreamingBudget.load(std::memory_order_acquire);
+    }
+
+    void requestTextureStreamingBudget(uint64_t bytes) {
+        hostStreamingBudget.store(bytes, std::memory_order_release);
+    }
+
+    void setTextureStreamingAutomaticBudget(uint64_t bytes) {
+        automaticStreamingBudget.store(bytes, std::memory_order_release);
+    }
+
+    static std::mutex statsMutex;
+    static TextureStreamingStats lastStats;
+
+    TextureStreamingStats textureStreamingStats() {
+        std::unique_lock lock(statsMutex);
+        return lastStats;
+    }
+
+    void setTextureStreamingStats(const TextureStreamingStats &stats) {
+        std::unique_lock lock(statsMutex);
+        lastStats = stats;
+    }
+
+    bool textureStreamingEnabled() {
+        return textureStreamingLevel() > 0;
+    }
+
+    float textureStreamingBias() {
+        // Level 5 (Maximum) uses TextureLodLevelBias[0], level 1 (Minimum) uses TextureLodLevelBias[4].
+        const uint32_t level = std::max(textureStreamingLevel(), 1U);
+        return TextureLodLevelBias[5 - level];
+    }
+
+    bool textureLodMeasuring() {
+        return textureLodEnabled() || textureStreamingEnabled();
+    }
+
+    uint32_t textureResidencyDecision(TextureResidencyState &state, float lod, float bias, double nowSeconds, double downgradeSeconds, bool allowUpgrade) {
+        if (lod == TextureLodNone) {
+            // Not drawn in this update: keep what is loaded; a later update decides.
+            return TextureResidencyNoRequest;
+        }
+
+        const uint32_t desired = textureLodTopMip(lod, bias, state.mipCount);
+        if (desired <= state.currentTopMip) {
+            state.lastNeedSeconds = nowSeconds;
+        }
+
+        if (state.pending) {
+            return TextureResidencyNoRequest;
+        }
+
+        if ((desired < state.currentTopMip) && (allowUpgrade || (lod == TextureLodFull))) {
+            state.pending = true;
+            state.rememberedTopMip = desired;
+            return desired;
+        }
+
+        if ((desired > state.currentTopMip) && ((nowSeconds - state.lastNeedSeconds) >= downgradeSeconds)) {
+            const uint32_t lastMip = (state.mipCount > 0) ? (state.mipCount - 1) : 0;
+            const uint32_t next = std::min(state.currentTopMip + 1, lastMip);
+            if (next != state.currentTopMip) {
+                state.pending = true;
+                state.rememberedTopMip = next;
+                state.lastNeedSeconds = nowSeconds;
+                return next;
+            }
+        }
+
+        return TextureResidencyNoRequest;
+    }
+
+    std::vector<std::pair<uint32_t, uint32_t>> textureResidencyPressureSteps(std::vector<TextureResidencyCandidate> candidates, uint64_t excessBytes, uint32_t maxSteps) {
+        // Farthest first; on the camera last; larger textures first among equal levels.
+        std::stable_sort(candidates.begin(), candidates.end(), [](const TextureResidencyCandidate &a, const TextureResidencyCandidate &b) {
+            if (a.lod != b.lod) {
+                return a.lod > b.lod;
+            }
+
+            return a.bytes > b.bytes;
+        });
+
+        std::vector<std::pair<uint32_t, uint32_t>> steps;
+        uint64_t freed = 0;
+        for (const TextureResidencyCandidate &c : candidates) {
+            if ((freed >= excessBytes) || (steps.size() >= maxSteps)) {
+                break;
+            }
+
+            if ((c.mipCount == 0) || (c.currentTopMip + 1 >= c.mipCount)) {
+                continue;
+            }
+
+            steps.emplace_back(c.id, c.currentTopMip + 1);
+            freed += c.bytes - c.bytes / 4;
+        }
+
+        return steps;
+    }
+
+    uint32_t textureResidencyInitialTopMip(const TextureResidencyState *state) {
+        if ((state != nullptr) && (state->rememberedTopMip != TextureResidencyNoRequest)) {
+            return state->rememberedTopMip;
+        }
+
+        return TextureResidencyInitialTopMip;
+    }
+};
diff --git a/src/tk64/tk64_texture_residency.h b/src/tk64/tk64_texture_residency.h
new file mode 100644
index 0000000..7fcc465
--- /dev/null
+++ b/src/tk64/tk64_texture_residency.h
@@ -0,0 +1,96 @@
+//
+// TK64
+//
+// Copyright (c) 2026 The TK64 contributors. Licensed under the MIT license. See LICENSE file for details.
+//
+// Per-file residency of replacement textures: which mip a file is kept from, chosen from the measured level of detail.
+// Phase 4 of per-distance mip streaming. See docs/specs/texture-streaming.md.
+//
+
+#pragma once
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace tk64 {
+    // Active quality level: 0 is off (whole files, as RT64), 1 (Minimum) to 5 (Maximum). Precedence:
+    // TK64_TEXTURE_STREAMING=0 (kill switch) > TK64_TEST_TEXTURE_STREAMING=<0..5> (test) > the host's request
+    // (rt64_host_texture_streaming.h) > off. Always 0 unless the backend supports it (D3D12 or Vulkan). Thread-safe.
+    uint32_t textureStreamingLevel();
+    bool textureStreamingEnabled();
+
+    // Host request: 0 off, 1..5 a level. Takes effect at the next residency decision. Thread-safe.
+    void requestTextureStreamingLevel(uint32_t level);
+
+    // Set by RT64 once the device exists: streaming is only allowed on D3D12 and Vulkan.
+    void setTextureStreamingSupported(bool supported);
+
+    // Memory budget for replacement textures in use. Precedence: TK64_TEST_TEXTURE_STREAMING_BUDGET_MB=<n> > the host's
+    // request (bytes, 0 = automatic) > automatic (RT64's replacement pool size, 2/3 of dedicated video memory).
+    uint64_t textureStreamingBudget();
+    void requestTextureStreamingBudget(uint64_t bytes);
+    void setTextureStreamingAutomaticBudget(uint64_t bytes);
+
+    // What the last residency decision saw, for hosts and the report.
+    struct TextureStreamingStats {
+        uint32_t level = 0;
+        uint64_t usedBytes = 0;     // replacement textures referenced by the game's textures
+        uint64_t budgetBytes = 0;
+        bool underPressure = false;
+        uint64_t allocationFailures = 0;
+    };
+
+    TextureStreamingStats textureStreamingStats();
+    void setTextureStreamingStats(const TextureStreamingStats &stats);
+
+    // Bias added to a measured level before choosing the top mip, for the active level (texture-lod.md).
+    float textureStreamingBias();
+
+    // Measurement is needed for the diagnostic report or for streaming.
+    bool textureLodMeasuring();
+
+    // First load of a file not measured yet: start from this mip and move up once it is drawn.
+    constexpr uint32_t TextureResidencyInitialTopMip = 2;
+
+    // A file is moved one mip down only after its current top mip went unneeded for this long.
+    constexpr double TextureResidencyDowngradeSeconds = 3.0;
+
+    constexpr uint32_t TextureResidencyNoRequest = UINT32_MAX;
+
+    struct TextureResidencyState {
+        uint32_t currentTopMip = 0;     // top mip of the texture loaded now
+        uint32_t mipCount = 0;          // mips of the whole file
+        bool pending = false;           // a load of another top mip is in flight
+        double lastNeedSeconds = 0.0;   // last time the current top mip (or a finer one) was needed
+        uint32_t rememberedTopMip = TextureResidencyNoRequest; // last top mip asked for, kept across evictions
+    };
+
+    // Decides from one update's finest level (TextureLodNone when the file was not drawn) whether to load another top
+    // mip. Moves up at once; moves down one mip at a time after TextureResidencyDowngradeSeconds without need. Returns the
+    // top mip to load, or TextureResidencyNoRequest.
+    // allowUpgrade false (memory pressure) keeps a file from moving up unless it is on the camera (TextureLodFull).
+    uint32_t textureResidencyDecision(TextureResidencyState &state, float lod, float bias, double nowSeconds, double downgradeSeconds = TextureResidencyDowngradeSeconds, bool allowUpgrade = true);
+
+    // Top mip for the first load of a file: the remembered one, else TextureResidencyInitialTopMip.
+    uint32_t textureResidencyInitialTopMip(const TextureResidencyState *state);
+
+    // Pressure starts when used memory is above the budget and ends below this fraction of it.
+    constexpr double TextureResidencyPressureRelease = 0.9;
+
+    // At most this many files are moved down per decision under pressure, so a spike does not reload everything at once.
+    constexpr uint32_t TextureResidencyPressureStepsPerUpdate = 4;
+
+    struct TextureResidencyCandidate {
+        uint32_t id = 0;            // caller's identifier
+        float lod = 0.0f;           // finest level the file was drawn at (TextureLodFull: on the camera)
+        uint32_t currentTopMip = 0;
+        uint32_t mipCount = 0;
+        uint64_t bytes = 0;         // memory of the loaded texture
+    };
+
+    // Under pressure: which drawn files to move one mip down to free excessBytes, farthest first (largest level), the
+    // ones on the camera (TextureLodFull) last, at most maxSteps. Returns (id, new top mip) pairs. Moving one mip down
+    // frees about 3/4 of a texture.
+    std::vector<std::pair<uint32_t, uint32_t>> textureResidencyPressureSteps(std::vector<TextureResidencyCandidate> candidates, uint64_t excessBytes, uint32_t maxSteps = TextureResidencyPressureStepsPerUpdate);
+};

+    // TooieRecomp: the host names the GPU in TOOIE_GRAPHICS_DEVICE (a DXGI adapter description). Each backend lists its
+    // own device names: an exact match wins, then a match that ignores case, spaces, "(TM)" and "(R)". Without a match
+    // the backend keeps its own choice.
+    static std::string tooieHostDeviceName(RenderInterface *renderInterface) {
+        const char *wanted = std::getenv("TOOIE_GRAPHICS_DEVICE");
+        if ((wanted == nullptr) || (wanted[0] == '\0') || (renderInterface == nullptr)) {
+            return std::string();
+        }
+
+        auto simplify = [](std::string name) {
+            for (const char *mark : { "(TM)", "(tm)", "(R)", "(r)" }) {
+                for (size_t at = name.find(mark); at != std::string::npos; at = name.find(mark)) {
+                    name.erase(at, std::strlen(mark));
+                }
+            }
+
+            std::string result;
+            for (char c : name) {
+                if (c != ' ') {
+                    result += char(((c >= 'A') && (c <= 'Z')) ? (c - 'A' + 'a') : c);
+                }
+            }
+
+            return result;
+        };
+
+        const std::vector<std::string> &names = renderInterface->getDeviceNames();
+        for (const std::string &name : names) {
+            if (name == wanted) {
+                return name;
+            }
+        }
+
+        for (const std::string &name : names) {
+            if (simplify(name) == simplify(wanted)) {
+                return name;
+            }
+        }
+
+        fprintf(stderr, "TooieRecomp: GPU \"%s\" is not offered by this graphics API; using its default device.\n", wanted);
+        return std::string();
+    }
+

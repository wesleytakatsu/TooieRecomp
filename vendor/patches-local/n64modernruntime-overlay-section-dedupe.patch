diff --git a/librecomp/src/overlays.cpp b/librecomp/src/overlays.cpp
index 8c8e5d1..53d0b8b 100644
--- a/librecomp/src/overlays.cpp
+++ b/librecomp/src/overlays.cpp
@@ -158,7 +158,16 @@ void load_overlay(size_t section_table_index, int32_t ram) {
         func_map[ram + func.offset] = func.func;
     }
 
-    loaded_sections.emplace_back(ram, section_table_index);
+    // A host that re-maps the same section at the same address on every overlay call (TooieRecomp's syscall
+    // dispatch) must not grow loaded_sections without bound: unload_overlays() erases every duplicate one by
+    // one from the middle of the vector, which turned map changes into multi-second stalls.
+    const bool already_loaded = std::any_of(loaded_sections.begin(), loaded_sections.end(),
+        [ram, section_table_index](const LoadedSection& s) {
+            return (s.loaded_ram_addr == ram) && (s.section_table_index == section_table_index);
+        });
+    if (!already_loaded) {
+        loaded_sections.emplace_back(ram, section_table_index);
+    }
     section_addresses[section.index] = ram;
 }
 

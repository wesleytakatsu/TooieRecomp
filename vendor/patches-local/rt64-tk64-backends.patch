+#include "spirv_cross_c.h"
+
+#if SPIRV_CROSS_C_API_CPP
+#include "spirv_cpp.hpp"
+#endif
+#if SPIRV_CROSS_C_API_GLSL
+#include "spirv_glsl.hpp"
+#else
+#include "spirv_cross.hpp"

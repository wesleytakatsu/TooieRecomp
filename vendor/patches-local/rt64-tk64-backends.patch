+    // GLPipelineLayout
+
+    GLPipelineLayout::GLPipelineLayout(const RenderPipelineLayoutDesc &desc) {
+        pushConstantRanges.assign(desc.pushConstantRanges, desc.pushConstantRanges + desc.pushConstantRangesCount);
+        setLayouts.resize(desc.descriptorSetDescsCount);
+        for (uint32_t s = 0; s < desc.descriptorSetDescsCount; s++) {
+            const RenderDescriptorSetDesc &setDesc = desc.descriptorSetDescs[s];
+            SetLayout &setLayout = setLayouts[s];
+            uint32_t start = 0;
+            for (uint32_t r = 0; r < setDesc.descriptorRangesCount; r++) {
+                RenderDescriptorRange range = setDesc.descriptorRanges[r];
+                // A boundless last range keeps its upper bound here: the layout's own size is only a hint (often 0), and each
+                // set allocates as many entries as it was created with.
+                std::vector<const RenderSampler *> samplers;
+                if (range.immutableSampler != nullptr) {
+                    samplers.assign(range.immutableSampler, range.immutableSampler + range.count);
+                }
+
+                setLayout.ranges.emplace_back(range);
+                setLayout.rangeStart.emplace_back(start);
+                setLayout.immutableSamplers.emplace_back(std::move(samplers));
+                start += range.count;
+            }
+        }
+    }
+
+    bool GLPipelineLayout::findDescriptor(uint32_t set, uint32_t binding, uint32_t arrayIndex, uint32_t &descriptorIndex, const RenderSampler **immutableSampler) const {
+        if (set >= setLayouts.size()) {
+            return false;
+        }
+
+        const SetLayout &setLayout = setLayouts[set];
+        for (size_t r = 0; r < setLayout.ranges.size(); r++) {
+            const RenderDescriptorRange &range = setLayout.ranges[r];
+            if ((binding < range.binding) || (binding >= (range.binding + range.count))) {
+                continue;
+            }
+
+            const uint32_t offset = (binding - range.binding) + arrayIndex;
+            if (offset >= range.count) {
+                return false;
+            }
+
+            descriptorIndex = setLayout.rangeStart[r] + offset;
+            if (immutableSampler != nullptr) {
+                *immutableSampler = setLayout.immutableSamplers[r].empty() ? nullptr : setLayout.immutableSamplers[r][offset];
+            }
+
+            return true;
+        }
+
+        return false;
+    }
+
+    // GLDescriptorSet
+
+    GLDescriptorSet::GLDescriptorSet(const RenderDescriptorSetDesc &desc) {
+        uint32_t count = 0;
+        for (uint32_t r = 0; r < desc.descriptorRangesCount; r++) {
+            const bool boundless = desc.lastRangeIsBoundless && (r == (desc.descriptorRangesCount - 1));
+            count += boundless ? std::max(desc.boundlessRangeSize, 1U) : desc.descriptorRanges[r].count;
+        }
+
+        entries.resize(count);
+    }
+
+    void GLDescriptorSet::setBuffer(uint32_t descriptorIndex, const RenderBuffer *buffer, uint64_t bufferSize, const RenderBufferStructuredView *bufferStructuredView, const RenderBufferFormattedView *bufferFormattedView) {
+        if (descriptorIndex >= entries.size()) {
+            return;
+        }
+
+        Entry &entry = entries[descriptorIndex];
+        entry.buffer = static_cast<const GLBuffer *>(buffer);
+        entry.bufferSize = bufferSize;
+        entry.structureStride = (bufferStructuredView != nullptr) ? bufferStructuredView->structureByteStride : 0;
+        entry.firstElement = (bufferStructuredView != nullptr) ? bufferStructuredView->firstElement : 0;
+        entry.formattedView = static_cast<const GLBufferFormattedView *>(bufferFormattedView);
+    }
+
+    void GLDescriptorSet::setTexture(uint32_t descriptorIndex, const RenderTexture *texture, RenderTextureLayout textureLayout, const RenderTextureView *textureView) {
+        if (descriptorIndex >= entries.size()) {
+            return;
+        }
+
+        Entry &entry = entries[descriptorIndex];
+        entry.texture = static_cast<const GLTexture *>(texture);
+        entry.textureView = static_cast<const GLTextureView *>(textureView);
+    }
+
+    void GLDescriptorSet::setSampler(uint32_t descriptorIndex, const RenderSampler *sampler) {
+        if (descriptorIndex >= entries.size()) {
+            return;
+        }
+
+        entries[descriptorIndex].sampler = static_cast<const GLSampler *>(sampler);
+    }
+
+    // GLPipeline
+
+    // Assigns GL binding points shared by every stage of a pipeline: the same (class, set, binding) gets the same
+    // binding in all stages, so a resource seen by two stages is bound once.
+    struct GLBindingAllocator {
+        std::map<std::tuple<int, uint32_t, uint32_t>, uint32_t> assigned;
+        std::map<int, uint32_t> next;
+
+        uint32_t operator()(const tk64::ResourceLocation &location) {
+            const int resourceClass = int(location.resourceClass);
+            const auto key = std::make_tuple(resourceClass, location.set, location.binding);
+            auto it = assigned.find(key);
+            if (it != assigned.end()) {
+                return it->second;
+            }
+
+            const uint32_t binding = next[resourceClass];
+            next[resourceClass] += location.arraySize;
+            assigned[key] = binding;
+            return binding;
+        }
+    };
+
+    static GLuint compileStage(GLenum stageType, const std::string &source, const char *label) {
+        GLuint shader = GLCALL(glCreateShader)(stageType);
+        const GLchar *text = source.c_str();
+        GLCALL(glShaderSource)(shader, 1, &text, nullptr);
+        GLCALL(glCompileShader)(shader);
+        GLint status = 0;
+        GLCALL(glGetShaderiv)(shader, GL_COMPILE_STATUS, &status);
+        if (status == 0) {
+            GLint logLength = 0;
+            GLCALL(glGetShaderiv)(shader, GL_INFO_LOG_LENGTH, &logLength);
+            std::string log(size_t(std::max(logLength, 1)), '\0');
+            GLCALL(glGetShaderInfoLog)(shader, logLength, nullptr, log.data());
+            fprintf(stderr, "plume_gles: %s shader failed to compile:\n%s\n", label, log.c_str());
+            GLCALL(glDeleteShader)(shader);
+            return 0;
+        }
+
+        return shader;
+    }
+
+    static bool linkProgram(GLuint program, const char *label) {
+        GLCALL(glLinkProgram)(program);
+        GLint status = 0;
+        GLCALL(glGetProgramiv)(program, GL_LINK_STATUS, &status);
+        if (status == 0) {
+            GLint logLength = 0;
+            GLCALL(glGetProgramiv)(program, GL_INFO_LOG_LENGTH, &logLength);
+            std::string log(size_t(std::max(logLength, 1)), '\0');
+            GLCALL(glGetProgramInfoLog)(program, logLength, nullptr, log.data());
+            fprintf(stderr, "plume_gles: %s program failed to link:\n%s\n", label, log.c_str());
+            return false;
+        }
+
+        return true;
+    }
+
+    static void collectPushConstants(GLuint program, const tk64::TranslatedShader &translated, std::vector<GLPipeline::PushConstantUniform> &pushConstants) {
+        for (const tk64::PushConstantMember &member : translated.pushConstantMembers) {
+            bool known = false;
+            for (const GLPipeline::PushConstantUniform &uniform : pushConstants) {
+                known = known || (uniform.member.offset == member.offset);
+            }
+
+            if (known) {
+                continue;
+            }
+
+            const std::string name = translated.pushConstantBlockName + "." + member.name;
+            GLPipeline::PushConstantUniform uniform;
+            uniform.location = GLCALL(glGetUniformLocation)(program, name.c_str());
+            uniform.member = member;
+            if (uniform.location >= 0) {
+                pushConstants.emplace_back(uniform);
+            }
+        }
+    }
+
+    static void appendResources(const tk64::TranslatedShader &translated, std::vector<tk64::CombinedSampler> &combinedSamplers, std::vector<tk64::BoundResource> &resources) {
+        combinedSamplers.insert(combinedSamplers.end(), translated.combinedSamplers.begin(), translated.combinedSamplers.end());
+        for (const tk64::BoundResource &resource : translated.resources) {
+            if (resource.resourceClass == tk64::ResourceClass::Sampler) {
+                continue;
+            }
+
+            bool known = false;
+            for (const tk64::BoundResource &existing : resources) {
+                known = known || ((existing.resourceClass == resource.resourceClass) && (existing.set == resource.set) && (existing.binding == resource.binding));
+            }
+
+            if (!known) {
+                resources.emplace_back(resource);
+            }
+        }
+    }
+
+    GLPipeline::GLPipeline(GLDevice *device, const RenderGraphicsPipelineDesc &desc) : device(device), type(Type::Graphics), graphicsDesc(desc) {
+        layout = static_cast<const GLPipelineLayout *>(desc.pipelineLayout);
+        inputSlots.assign(desc.inputSlots, desc.inputSlots + desc.inputSlotsCount);
+
+        // Translate both stages with one binding allocator; the pixel shader's texture units follow the vertex shader's.
+        GLBindingAllocator allocator;
+        tk64::BindingMapper mapper = [&](const tk64::ResourceLocation &location) { return allocator(location); };
+        const GLShader *vertexShader = static_cast<const GLShader *>(desc.vertexShader);
+        const GLShader *pixelShader = static_cast<const GLShader *>(desc.pixelShader);
+        tk64::TranslationOptions vertexOptions;
+        vertexOptions.glClipSpaceFixup = !device->zeroToOneDepth;
+        tk64::TranslatedShader vertex = tk64::translateSpirv(vertexShader->words.data(), vertexShader->words.size(), device->shaderLanguage(), mapper, vertexOptions);
+        uint32_t textureUnitBase = 0;
+        for (const tk64::CombinedSampler &combined : vertex.combinedSamplers) {
+            textureUnitBase = std::max(textureUnitBase, combined.textureUnit + combined.arraySize);
+        }
+
+        uint32_t nextUnit = textureUnitBase;
+        tk64::BindingMapper pixelMapper = [&](const tk64::ResourceLocation &location) {
+            if (location.resourceClass == tk64::ResourceClass::Texture) {
+                const uint32_t unit = nextUnit;
+                nextUnit += location.arraySize;
+                return unit;
+            }
+
+            return allocator(location);
+        };
+
+        tk64::TranslatedShader pixel;
+        if (pixelShader != nullptr) {
+            pixel = tk64::translateSpirv(pixelShader->words.data(), pixelShader->words.size(), device->shaderLanguage(), pixelMapper);
+        }
+
+        if (!vertex.ok || ((pixelShader != nullptr) && !pixel.ok)) {
+            fprintf(stderr, "plume_gles: shader translation failed: %s%s\n", vertex.error.c_str(), pixel.error.c_str());
+            return;
+        }
+
+        for (const std::string &extension : pixel.requiredExtensions) {
+            if (std::find(device->extensions.begin(), device->extensions.end(), extension) == device->extensions.end()) {
+                fprintf(stderr, "plume_gles: the pixel shader needs %s, which the driver does not report.\n", extension.c_str());
+            }
+        }
+
+        appendResources(vertex, combinedSamplers, resources);
+        appendResources(pixel, combinedSamplers, resources);
+
+        device->thread.call([&]() {
+            GLuint vertexStage = compileStage(GL_VERTEX_SHADER, vertex.source, "vertex");
+            GLuint pixelStage = (pixelShader != nullptr) ? compileStage(GL_FRAGMENT_SHADER, pixel.source, "pixel") : 0;
+            if ((vertexStage == 0) || ((pixelShader != nullptr) && (pixelStage == 0))) {
+                return;
+            }
+
+            program = GLCALL(glCreateProgram)();
+            GLCALL(glAttachShader)(program, vertexStage);
+            if (pixelStage != 0) {
+                GLCALL(glAttachShader)(program, pixelStage);
+            }
+
+            valid = linkProgram(program, "graphics");
+            GLCALL(glDeleteShader)(vertexStage);
+            if (pixelStage != 0) {
+                GLCALL(glDeleteShader)(pixelStage);
+            }
+
+            if (!valid) {
+                return;
+            }
+
+            collectPushConstants(program, vertex, pushConstants);
+            collectPushConstants(program, pixel, pushConstants);
+
+            // Vertex input layout lives in a vertex array object; buffers are attached at draw time.
+            GLCALL(glGenVertexArrays)(1, &vertexArray);
+            GLCALL(glBindVertexArray)(vertexArray);
+            for (uint32_t i = 0; i < desc.inputElementsCount; i++) {
+                const RenderInputElement &element = desc.inputElements[i];
+                GLint size = 4;
+                GLenum attributeType = GL_FLOAT;
+                GLboolean normalized = GL_FALSE;
+                bool integer = false;
+                toGLVertexFormat(element.format, size, attributeType, normalized, integer);
+                GLCALL(glEnableVertexAttribArray)(element.location);
+                if (integer) {
+                    GLCALL(glVertexAttribIFormat)(element.location, size, attributeType, element.alignedByteOffset);
+                }
+                else {
+                    GLCALL(glVertexAttribFormat)(element.location, size, attributeType, normalized, element.alignedByteOffset);
+                }
+
+                GLCALL(glVertexAttribBinding)(element.location, element.slotIndex);
+            }
+
+            for (const RenderInputSlot &slot : inputSlots) {
+                GLCALL(glVertexBindingDivisor)(slot.index, (slot.classification == RenderInputSlotClassification::PER_INSTANCE_DATA) ? 1 : 0);
+            }
+
+            GLCALL(glBindVertexArray)(0);
+        });
+    }
+
+    GLPipeline::GLPipeline(GLDevice *device, const RenderComputePipelineDesc &desc) : device(device), type(Type::Compute) {
+        layout = static_cast<const GLPipelineLayout *>(desc.pipelineLayout);
+        GLBindingAllocator allocator;
+        tk64::BindingMapper mapper = [&](const tk64::ResourceLocation &location) { return allocator(location); };
+        const GLShader *computeShader = static_cast<const GLShader *>(desc.computeShader);
+        tk64::TranslatedShader compute = tk64::translateSpirv(computeShader->words.data(), computeShader->words.size(), device->shaderLanguage(), mapper);
+        if (!compute.ok) {
+            fprintf(stderr, "plume_gles: compute shader translation failed: %s\n", compute.error.c_str());
+            return;
+        }
+
+        appendResources(compute, combinedSamplers, resources);
+        if (device->profile == RenderGLProfile::ES) {
+            for (const tk64::BoundResource &resource : resources) {
+                if (resource.writeOnly && computeWords.empty()) {
+                    computeWords = computeShader->words;
+                }
+            }
+        }
+
+        device->thread.call([&]() {
+            GLuint computeStage = compileStage(GL_COMPUTE_SHADER, compute.source, "compute");
+            if (computeStage == 0) {
+                return;
+            }
+
+            program = GLCALL(glCreateProgram)();
+            GLCALL(glAttachShader)(program, computeStage);
+            valid = linkProgram(program, "compute");
+            GLCALL(glDeleteShader)(computeStage);
+            if (valid) {
+                collectPushConstants(program, compute, pushConstants);
+            }
+        });
+    }
+
+    GLPipeline::~GLPipeline() {
+        std::vector<GLuint> programIds = { program };
+        for (const auto &variant : computeVariants) {
+            programIds.emplace_back(variant.second.program);
+        }
+
+        const GLuint vertexArrayId = vertexArray;
+        device->thread.post([programIds, vertexArrayId]() {
+            for (GLuint programId : programIds) {
+                if (programId != 0) {
+                    GLCALL(glDeleteProgram)(programId);
+                }
+            }
+
+            if (vertexArrayId != 0) {
+                GLCALL(glDeleteVertexArrays)(1, &vertexArrayId);
+            }
+        });
+    }
+
+    // GLFramebuffer
+
+    GLFramebuffer::GLFramebuffer(GLDevice *device, const RenderFramebufferDesc &desc) : device(device) {
+        colorCount = desc.colorAttachmentsCount;
+        hasDepth = (desc.depthAttachment != nullptr);
+        device->thread.call([&]() {
+            GLCALL(glGenFramebuffers)(1, &id);
+            GLCALL(glBindFramebuffer)(GL_FRAMEBUFFER, id);
+            std::vector<GLenum> drawBuffers;
+            for (uint32_t i = 0; i < desc.colorAttachmentsCount; i++) {
+                const GLTexture *texture = static_cast<const GLTexture *>(desc.colorAttachments[i]);
+                GLCALL(glFramebufferTexture2D)(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0 + i, texture->target, texture->id, 0);
+                drawBuffers.emplace_back(GL_COLOR_ATTACHMENT0 + i);
+                width = texture->desc.width;
+                height = texture->desc.height;
+            }
+
+            if (desc.depthAttachment != nullptr) {
+                const GLTexture *texture = static_cast<const GLTexture *>(desc.depthAttachment);
+                const GLenum attachment = texture->format.stencil ? GL_DEPTH_STENCIL_ATTACHMENT : GL_DEPTH_ATTACHMENT;
+                GLCALL(glFramebufferTexture2D)(GL_FRAMEBUFFER, attachment, texture->target, texture->id, 0);
+                width = texture->desc.width;
+                height = texture->desc.height;
+            }
+
+            if (drawBuffers.empty()) {
+                const GLenum none = GL_NONE;
+                GLCALL(glDrawBuffers)(1, &none);
+            }
+            else {
+                GLCALL(glDrawBuffers)(GLsizei(drawBuffers.size()), drawBuffers.data());
+            }
+
+            const GLenum status = GLCALL(glCheckFramebufferStatus)(GL_FRAMEBUFFER);
+            if (status != GL_FRAMEBUFFER_COMPLETE) {
+                fprintf(stderr, "plume_gles: incomplete framebuffer (0x%X).\n", status);
+            }
+
+            GLCALL(glBindFramebuffer)(GL_FRAMEBUFFER, 0);
+        });
+    }
+
+    GLFramebuffer::~GLFramebuffer() {
+        const GLuint framebufferId = id;
+        device->thread.post([framebufferId]() { GLCALL(glDeleteFramebuffers)(1, &framebufferId); });
+    }
+
+    // Binding of a pipeline's resources from the bound descriptor sets, done before each draw or dispatch.
+
+    static const GLDescriptorSet::Entry *findDescriptorEntry(const GLPipelineLayout *layout, const GLDescriptorSet *const *sets, uint32_t set, uint32_t binding,
+        uint32_t arrayIndex, const RenderSampler **immutableSampler)
+    {
+        uint32_t descriptorIndex = 0;
+        if ((layout == nullptr) || !layout->findDescriptor(set, binding, arrayIndex, descriptorIndex, immutableSampler)) {
+            return nullptr;
+        }
+
+        if ((set >= 8) || (sets[set] == nullptr) || (descriptorIndex >= sets[set]->entries.size())) {
+            return nullptr;
+        }
+
+        return &sets[set]->entries[descriptorIndex];
+    }
+
+    // The GL internal format of the image a storage image descriptor holds, or 0 when it holds none.
+    static GLenum boundImageFormat(const tk64::BoundResource &resource, const GLDescriptorSet::Entry &entry) {
+        if (resource.texelBuffer && (entry.formattedView != nullptr)) {
+            return toGL(entry.formattedView->format).internalFormat;
+        }
+        else if (!resource.texelBuffer && (entry.texture != nullptr)) {
+            return entry.texture->format.internalFormat;
+        }
+
+        return 0;
+    }
+
+    static const GLPipeline::ProgramVariant *selectComputeVariant(const GLPipeline *pipeline, const GLPipelineLayout *layout, const GLDescriptorSet *const *sets) {
+        if (pipeline->computeWords.empty()) {
+            return nullptr;
+        }
+
+        if (layout == nullptr) {
+            layout = pipeline->layout;
+        }
+
+        // The formats of the first element bound to each write-only image decide the variant.
+        std::vector<uint32_t> formats;
+        tk64::TranslationOptions options;
+        bool translatedFormats = true;
+        for (const tk64::BoundResource &resource : pipeline->resources) {
+            if ((resource.resourceClass != tk64::ResourceClass::StorageImage) || !resource.writeOnly) {
+                continue;
+            }
+
+            const GLDescriptorSet::Entry *entry = findDescriptorEntry(layout, sets, resource.set, resource.binding, 0, nullptr);
+            const GLenum bound = (entry != nullptr) ? boundImageFormat(resource, *entry) : 0;
+            tk64::TranslationOptions::ImageFormat imageFormat;
+            imageFormat.set = resource.set;
+            imageFormat.binding = resource.binding;
+            imageFormat.glFormat = (bound != 0) ? bound : resource.glImageFormat;
+            translatedFormats = translatedFormats && (imageFormat.glFormat == resource.glImageFormat);
+            formats.emplace_back(imageFormat.glFormat);
+            options.imageFormats.emplace_back(imageFormat);
+        }
+
+        if (translatedFormats) {
+            return nullptr;
+        }
+
+        auto it = pipeline->computeVariants.find(formats);
+        if (it != pipeline->computeVariants.end()) {
+            return (it->second.program != 0) ? &it->second : nullptr;
+        }
+
+        // A variant that fails to build is remembered as empty, and the pipeline's own program runs instead.
+        GLPipeline::ProgramVariant &variant = pipeline->computeVariants[formats];
+        GLBindingAllocator allocator;
+        tk64::BindingMapper mapper = [&](const tk64::ResourceLocation &location) { return allocator(location); };
+        const tk64::TranslatedShader compute = tk64::translateSpirv(pipeline->computeWords.data(), pipeline->computeWords.size(), pipeline->device->shaderLanguage(), mapper, options);
+        if (!compute.ok) {
+            fprintf(stderr, "plume_gles: compute shader variant translation failed: %s\n", compute.error.c_str());
+            return nullptr;
+        }
+
+        const GLuint computeStage = compileStage(GL_COMPUTE_SHADER, compute.source, "compute variant");
+        if (computeStage == 0) {
+            return nullptr;
+        }
+
+        variant.program = GLCALL(glCreateProgram)();
+        GLCALL(glAttachShader)(variant.program, computeStage);
+        const bool linked = linkProgram(variant.program, "compute variant");
+        GLCALL(glDeleteShader)(computeStage);
+        if (!linked) {
+            GLCALL(glDeleteProgram)(variant.program);
+            variant.program = 0;
+            return nullptr;
+        }
+
+        collectPushConstants(variant.program, compute, variant.pushConstants);
+        return &variant;
+    }
+
+    static void bindResources(const GLPipeline *pipeline, const GLPipelineLayout *layout, const GLDescriptorSet *const *sets) {
+        if (layout == nullptr) {
+            layout = pipeline->layout;
+        }
+
+        auto findEntry = [&](uint32_t set, uint32_t binding, uint32_t arrayIndex, const RenderSampler **immutableSampler) {
+            return findDescriptorEntry(layout, sets, set, binding, arrayIndex, immutableSampler);
+        };
+
+        for (const tk64::BoundResource &resource : pipeline->resources) {
+            for (uint32_t a = 0; a < resource.arraySize; a++) {
+                const GLDescriptorSet::Entry *entry = findEntry(resource.set, resource.binding, a, nullptr);
+                if (entry == nullptr) {
+                    continue;
+                }
+
+                const GLuint target = resource.targetBinding + a;
+                switch (resource.resourceClass) {
+                case tk64::ResourceClass::UniformBuffer:
+                case tk64::ResourceClass::StorageBuffer:
+                case tk64::ResourceClass::ReadOnlyStorageBuffer: {
+                    if (entry->buffer == nullptr) {
+                        break;
+                    }
+
+                    const GLenum bufferTarget = (resource.resourceClass == tk64::ResourceClass::UniformBuffer) ? GL_UNIFORM_BUFFER : GL_SHADER_STORAGE_BUFFER;
+                    const uint64_t offset = uint64_t(entry->firstElement) * entry->structureStride;
+                    const uint64_t available = (entry->buffer->desc.size > offset) ? (entry->buffer->desc.size - offset) : 0;
+                    const uint64_t size = (entry->bufferSize > 0) ? std::min(entry->bufferSize, available) : available;
+                    if ((offset == 0) && (size == entry->buffer->desc.size)) {
+                        GLCALL(glBindBufferBase)(bufferTarget, target, entry->buffer->id);
+                    }
+                    else {
+                        GLCALL(glBindBufferRange)(bufferTarget, target, entry->buffer->id, GLintptr(offset), GLsizeiptr(size));
+                    }
+
+                    break;
+                }
+                case tk64::ResourceClass::StorageImage: {
+                    GLuint textureId = 0;
+                    if (resource.texelBuffer && (entry->formattedView != nullptr)) {
+                        textureId = entry->formattedView->texture;
+                    }
+                    else if (entry->texture != nullptr) {
+                        textureId = entry->texture->id;
+                    }
+
+                    // A write-only image is bound with the format of the image itself: desktop GLSL declares it without a
+                    // format, and GLSL ES runs a variant declared with this format (selectComputeVariant).
+                    const GLenum declaredFormat = GLenum(resource.glImageFormat);
+                    const GLenum boundFormat = boundImageFormat(resource, *entry);
+                    const GLenum imageFormat = ((resource.writeOnly || (declaredFormat == 0)) && (boundFormat != 0)) ? boundFormat : declaredFormat;
+                    if (textureId != 0) {
+                        GLCALL(glBindImageTexture)(target, textureId, 0, GL_FALSE, 0, GL_READ_WRITE, imageFormat);
+                    }
+
+                    break;
+                }
+                default:
+                    break;
+                }
+            }
+        }
+
+        for (const tk64::CombinedSampler &combined : pipeline->combinedSamplers) {
+            for (uint32_t a = 0; a < combined.arraySize; a++) {
+                const GLuint unit = combined.textureUnit + a;
+                const GLDescriptorSet::Entry *imageEntry = findEntry(combined.imageSet, combined.imageBinding, a, nullptr);
+                GLCALL(glActiveTexture)(GL_TEXTURE0 + unit);
+                if (imageEntry == nullptr) {
+                    continue;
+                }
+
+                if (combined.texelBuffer) {
+                    GLCALL(glBindTexture)(GL_TEXTURE_BUFFER, (imageEntry->formattedView != nullptr) ? imageEntry->formattedView->texture : 0);
+                }
+                else if (imageEntry->texture != nullptr) {
+                    GLCALL(glBindTexture)(imageEntry->texture->target, imageEntry->texture->id);
+                }
+
+                GLuint samplerId = 0;
+                if (!combined.dummySampler) {
+                    const RenderSampler *immutableSampler = nullptr;
+                    const GLDescriptorSet::Entry *samplerEntry = findEntry(combined.samplerSet, combined.samplerBinding, 0, &immutableSampler);
+                    if (immutableSampler != nullptr) {
+                        samplerId = static_cast<const GLSampler *>(immutableSampler)->id;
+                    }
+                    else if ((samplerEntry != nullptr) && (samplerEntry->sampler != nullptr)) {
+                        samplerId = samplerEntry->sampler->id;
+                    }
+                }
+
+                GLCALL(glBindSampler)(unit, samplerId);
+            }
+        }
+    }
+
+    static void uploadPushConstants(const std::vector<GLPipeline::PushConstantUniform> &pushConstants, const uint8_t *data) {
+        for (const GLPipeline::PushConstantUniform &uniform : pushConstants) {
+            const tk64::PushConstantMember &member = uniform.member;
+            const uint8_t *bytes = data + member.offset;
+            const GLsizei count = GLsizei(std::max(member.arraySize, 1U));
+            if ((member.columns == 4) && (member.vectorSize == 4)) {
+                GLCALL(glUniformMatrix4fv)(uniform.location, count, member.rowMajor ? GL_TRUE : GL_FALSE, reinterpret_cast<const GLfloat *>(bytes));
+                continue;
+            }
+
+            switch (member.type) {
+            case tk64::ScalarType::UInt: {
+                const GLuint *values = reinterpret_cast<const GLuint *>(bytes);
+                switch (member.vectorSize) {
+                case 1: GLCALL(glUniform1uiv)(uniform.location, count, values); break;
+                case 2: GLCALL(glUniform2uiv)(uniform.location, count, values); break;
+                case 3: GLCALL(glUniform3uiv)(uniform.location, count, values); break;
+                default: GLCALL(glUniform4uiv)(uniform.location, count, values); break;
+                }
+
+                break;
+            }
+            case tk64::ScalarType::Int: {
+                const GLint *values = reinterpret_cast<const GLint *>(bytes);
+                switch (member.vectorSize) {
+                case 1: GLCALL(glUniform1iv)(uniform.location, count, values); break;
+                case 2: GLCALL(glUniform2iv)(uniform.location, count, values); break;
+                case 3: GLCALL(glUniform3iv)(uniform.location, count, values); break;
+                default: GLCALL(glUniform4iv)(uniform.location, count, values); break;
+                }
+
+                break;
+            }
+            default: {
+                const GLfloat *values = reinterpret_cast<const GLfloat *>(bytes);
+                switch (member.vectorSize) {
+                case 1: GLCALL(glUniform1fv)(uniform.location, count, values); break;
+                case 2: GLCALL(glUniform2fv)(uniform.location, count, values); break;
+                case 3: GLCALL(glUniform3fv)(uniform.location, count, values); break;
+                default: GLCALL(glUniform4fv)(uniform.location, count, values); break;
+                }
+
+                break;
+            }
+            }
+        }
+    }
+
+    // Fixed-function state of a graphics pipeline, applied when the pipeline is bound.
+    static void applyGraphicsState(const GLPipeline *pipeline) {
+        const RenderGraphicsPipelineDesc &desc = pipeline->graphicsDesc;
+        if (desc.depthEnabled) {
+            GLCALL(glEnable)(GL_DEPTH_TEST);
+            GLCALL(glDepthFunc)(toGL(desc.depthFunction));
+        }
+        else {
+            GLCALL(glDisable)(GL_DEPTH_TEST);
+        }
+
+        GLCALL(glDepthMask)(desc.depthWriteEnabled ? GL_TRUE : GL_FALSE);
+        if (pipeline->device->profile == RenderGLProfile::DESKTOP) {
+            if (desc.depthClipEnabled) {
+                GLCALL(glDisable)(GL_DEPTH_CLAMP);
+            }
+            else {
+                GLCALL(glEnable)(GL_DEPTH_CLAMP);
+            }
+        }
+
+        if (desc.cullMode == RenderCullMode::NONE) {
+            GLCALL(glDisable)(GL_CULL_FACE);
+        }
+        else {
+            GLCALL(glEnable)(GL_CULL_FACE);
+            GLCALL(glCullFace)((desc.cullMode == RenderCullMode::FRONT) ? GL_FRONT : GL_BACK);
+        }
+
+        // GL classifies winding with Y up, Vulkan with Y down; the same window coordinates give the opposite orientation.
+        GLCALL(glFrontFace)((desc.frontFace == RenderFrontFace::CLOCKWISE) ? GL_CCW : GL_CW);
+
+        if ((desc.depthBias != 0) || (desc.slopeScaledDepthBias != 0.0f)) {
+            GLCALL(glEnable)(GL_POLYGON_OFFSET_FILL);
+            GLCALL(glPolygonOffset)(desc.slopeScaledDepthBias, float(desc.depthBias));
+        }
+        else {
+            GLCALL(glDisable)(GL_POLYGON_OFFSET_FILL);
+        }
+
+        for (uint32_t i = 0; i < RenderGraphicsPipelineDesc::MaxRenderTargets; i++) {
+            const RenderBlendDesc &blend = desc.renderTargetBlend[i];
+            if (i >= desc.renderTargetCount) {
+                GLCALL(glDisablei)(GL_BLEND, i);
+                continue;
+            }
+
+            if (blend.blendEnabled) {
+                GLCALL(glEnablei)(GL_BLEND, i);
+                GLCALL(glBlendFuncSeparatei)(i, toGL(blend.srcBlend), toGL(blend.dstBlend), toGL(blend.srcBlendAlpha), toGL(blend.dstBlendAlpha));
+                GLCALL(glBlendEquationSeparatei)(i, toGL(blend.blendOp), toGL(blend.blendOpAlpha));
+            }
+            else {
+                GLCALL(glDisablei)(GL_BLEND, i);
+            }
+
+            const uint8_t mask = blend.renderTargetWriteMask;
+            GLCALL(glColorMaski)(i, (mask & 0x1) != 0, (mask & 0x2) != 0, (mask & 0x4) != 0, (mask & 0x8) != 0);
+        }
+    }
+
+    // GLCommandList
+
+    GLCommandList::GLCommandList(GLDevice *device) : device(device) {
+        commands = std::make_shared<std::vector<GLCommand>>();
+    }
+
+    void GLCommandList::begin() {
+        // A new vector, so a list that was submitted and is still replaying keeps its own commands.
+        commands = std::make_shared<std::vector<GLCommand>>();
+        recordGraphicsLayout = nullptr;
+        recordComputeLayout = nullptr;
+        recordViewportSet = false;
+        recordScissorSet = false;
+    }
+
+    void GLCommandList::barriers(RenderBarrierStages stages, const RenderBufferBarrier *bufferBarriers, uint32_t bufferBarriersCount, const RenderTextureBarrier *textureBarriers, uint32_t textureBarriersCount) {
+        // Compute and image writes need an explicit barrier in GL; everything else is ordered by the API.
+        record([](GLReplayState &) { GLCALL(glMemoryBarrier)(GL_ALL_BARRIER_BITS); });
+    }
+
+    void GLCommandList::dispatch(uint32_t threadGroupCountX, uint32_t threadGroupCountY, uint32_t threadGroupCountZ) {
+        record([=](GLReplayState &state) {
+            if ((state.pipeline == nullptr) || !state.pipeline->valid || (state.pipeline->type != GLPipeline::Type::Compute)) {
+                return;
+            }
+
+            const GLPipeline::ProgramVariant *variant = selectComputeVariant(state.pipeline, state.computeLayout, state.computeSets);
+            if (variant != nullptr) {
+                GLCALL(glUseProgram)(variant->program);
+            }
+
+            bindResources(state.pipeline, state.computeLayout, state.computeSets);
+            uploadPushConstants((variant != nullptr) ? variant->pushConstants : state.pipeline->pushConstants, state.computePushConstants);
+            GLCALL(glDispatchCompute)(threadGroupCountX, threadGroupCountY, threadGroupCountZ);
+            if (variant != nullptr) {
+                GLCALL(glUseProgram)(state.pipeline->program);
+            }
+        });
+    }
+
+    static bool prepareDraw(GLReplayState &state) {
+        if ((state.pipeline == nullptr) || !state.pipeline->valid || (state.pipeline->type != GLPipeline::Type::Graphics)) {
+            return false;
+        }
+
+        bindResources(state.pipeline, state.graphicsLayout, state.graphicsSets);
+        uploadPushConstants(state.pipeline->pushConstants, state.graphicsPushConstants);
+        GLCALL(glBindVertexArray)(state.pipeline->vertexArray);
+        for (const RenderInputSlot &slot : state.pipeline->inputSlots) {
+            const RenderVertexBufferView &view = state.vertexBufferViews[slot.index & 7];
+            const GLBuffer *buffer = static_cast<const GLBuffer *>(view.buffer.ref);
+            GLCALL(glBindVertexBuffer)(slot.index, (buffer != nullptr) ? buffer->id : 0, GLintptr(view.buffer.offset), GLsizei(slot.stride));
+        }
+
+        return true;
+    }
+
+    void GLCommandList::drawInstanced(uint32_t vertexCountPerInstance, uint32_t instanceCount, uint32_t startVertexLocation, uint32_t startInstanceLocation) {
+        record([=](GLReplayState &state) {
+            if (!prepareDraw(state)) {
+                return;
+            }
+
+            GLCALL(glDrawArraysInstanced)(toGL(state.pipeline->graphicsDesc.primitiveTopology), GLint(startVertexLocation), GLsizei(vertexCountPerInstance), GLsizei(instanceCount));
+        });
+    }
+
+    void GLCommandList::drawIndexedInstanced(uint32_t indexCountPerInstance, uint32_t instanceCount, uint32_t startIndexLocation, int32_t baseVertexLocation, uint32_t startInstanceLocation) {
+        record([=](GLReplayState &state) {
+            if (!prepareDraw(state)) {
+                return;
+            }
+
+            const GLBuffer *indexBuffer = static_cast<const GLBuffer *>(state.indexBufferView.buffer.ref);
+            if (indexBuffer == nullptr) {
+                return;
+            }
+
+            const bool shortIndices = (state.indexBufferView.format == RenderFormat::R16_UINT);
+            const uint64_t indexOffset = state.indexBufferView.buffer.offset + uint64_t(startIndexLocation) * (shortIndices ? 2 : 4);
+            GLCALL(glBindBuffer)(GL_ELEMENT_ARRAY_BUFFER, indexBuffer->id);
+            GLCALL(glDrawElementsInstancedBaseVertex)(toGL(state.pipeline->graphicsDesc.primitiveTopology), GLsizei(indexCountPerInstance),
+                shortIndices ? GL_UNSIGNED_SHORT : GL_UNSIGNED_INT, reinterpret_cast<const void *>(uintptr_t(indexOffset)), GLsizei(instanceCount), baseVertexLocation);
+        });
+    }
+
+    void GLCommandList::setPipeline(const RenderPipeline *pipeline) {
+        const GLPipeline *glPipeline = static_cast<const GLPipeline *>(pipeline);
+        record([glPipeline](GLReplayState &state) {
+            state.pipeline = glPipeline;
+            if ((glPipeline == nullptr) || !glPipeline->valid) {
+                return;
+            }
+
+            GLCALL(glUseProgram)(glPipeline->program);
+            if (glPipeline->type == GLPipeline::Type::Graphics) {
+                applyGraphicsState(glPipeline);
+            }
+        });
+    }
+
+    void GLCommandList::setComputePipelineLayout(const RenderPipelineLayout *pipelineLayout) {
+        const GLPipelineLayout *layout = static_cast<const GLPipelineLayout *>(pipelineLayout);
+        recordComputeLayout = layout;
+        record([layout](GLReplayState &state) { state.computeLayout = layout; });
+    }
+
+    void GLCommandList::setGraphicsPipelineLayout(const RenderPipelineLayout *pipelineLayout) {
+        const GLPipelineLayout *layout = static_cast<const GLPipelineLayout *>(pipelineLayout);
+        recordGraphicsLayout = layout;
+        record([layout](GLReplayState &state) { state.graphicsLayout = layout; });
+    }
+
+    // Push constants are copied at record time, like the other APIs do.
+    static void recordPushConstants(GLCommandList *list, bool compute, const GLPipelineLayout *layout, uint32_t rangeIndex, const void *data, uint32_t offset, uint32_t size) {
+        uint32_t rangeOffset = 0;
+        uint32_t rangeSize = size;
+        if ((layout != nullptr) && (rangeIndex < layout->pushConstantRanges.size())) {
+            rangeOffset = layout->pushConstantRanges[rangeIndex].offset;
+            if (rangeSize == 0) {
+                rangeSize = layout->pushConstantRanges[rangeIndex].size;
+            }
+        }
+
+        const uint32_t begin = rangeOffset + offset;
+        if ((begin + rangeSize) > 256) {
+            return;
+        }
+
+        std::vector<uint8_t> bytes(static_cast<const uint8_t *>(data), static_cast<const uint8_t *>(data) + rangeSize);
+        list->record([compute, begin, bytes](GLReplayState &state) {
+            uint8_t *target = compute ? state.computePushConstants : state.graphicsPushConstants;
+            memcpy(target + begin, bytes.data(), bytes.size());
+        });
+    }
+
+    void GLCommandList::setComputePushConstants(uint32_t rangeIndex, const void *data, uint32_t offset, uint32_t size) {
+        recordPushConstants(this, true, recordComputeLayout, rangeIndex, data, offset, size);
+    }
+
+    void GLCommandList::setGraphicsPushConstants(uint32_t rangeIndex, const void *data, uint32_t offset, uint32_t size) {
+        recordPushConstants(this, false, recordGraphicsLayout, rangeIndex, data, offset, size);
+    }
+
+    void GLCommandList::setComputeDescriptorSet(RenderDescriptorSet *descriptorSet, uint32_t setIndex) {
+        const GLDescriptorSet *set = static_cast<const GLDescriptorSet *>(descriptorSet);
+        record([set, setIndex](GLReplayState &state) {
+            if (setIndex < 8) {
+                state.computeSets[setIndex] = set;
+            }
+        });
+    }
+
+    void GLCommandList::setGraphicsDescriptorSet(RenderDescriptorSet *descriptorSet, uint32_t setIndex) {
+        const GLDescriptorSet *set = static_cast<const GLDescriptorSet *>(descriptorSet);
+        record([set, setIndex](GLReplayState &state) {
+            if (setIndex < 8) {
+                state.graphicsSets[setIndex] = set;
+            }
+        });
+    }
+
+    void GLCommandList::setIndexBuffer(const RenderIndexBufferView *view) {
+        RenderIndexBufferView copy = (view != nullptr) ? *view : RenderIndexBufferView();
+        record([copy](GLReplayState &state) { state.indexBufferView = copy; });
+    }
+
+    void GLCommandList::setVertexBuffers(uint32_t startSlot, const RenderVertexBufferView *views, uint32_t viewCount, const RenderInputSlot *inputSlots) {
+        std::vector<RenderVertexBufferView> copies;
+        if (views != nullptr) {
+            copies.assign(views, views + viewCount);
+        }
+
+        record([startSlot, copies](GLReplayState &state) {
+            for (uint32_t i = 0; i < 8; i++) {
+                state.vertexBufferViews[i] = RenderVertexBufferView();
+            }
+
+            for (size_t i = 0; (i < copies.size()) && ((startSlot + i) < 8); i++) {
+                state.vertexBufferViews[startSlot + i] = copies[i];
+            }
+        });
+    }
+
+    void GLCommandList::setViewports(const RenderViewport *viewports, uint32_t count) {
+        if ((viewports == nullptr) || (count == 0)) {
+            return;
+        }
+
+        const RenderViewport viewport = viewports[0];
+        recordViewportSet = true;
+        record([viewport](GLReplayState &) {
+            GLCALL(glViewport)(GLint(viewport.x), GLint(viewport.y), GLsizei(viewport.width), GLsizei(viewport.height));
+            GLCALL(glDepthRangef)(viewport.minDepth, viewport.maxDepth);
+        });
+    }
+
+    void GLCommandList::setScissors(const RenderRect *scissorRects, uint32_t count) {
+        if ((scissorRects == nullptr) || (count == 0)) {
+            return;
+        }
+
+        const RenderRect rect = scissorRects[0];
+        recordScissorSet = true;
+        record([rect](GLReplayState &state) {
+            state.scissor = rect;
+            state.scissorSet = true;
+            GLCALL(glScissor)(rect.left, rect.top, std::max(rect.right - rect.left, 0), std::max(rect.bottom - rect.top, 0));
+        });
+    }
+
+    void GLCommandList::setFramebuffer(const RenderFramebuffer *framebuffer) {
+        const GLFramebuffer *glFramebuffer = static_cast<const GLFramebuffer *>(framebuffer);
+        // As in D3D12 and Vulkan, binding a framebuffer keeps the viewport and scissor: RT64 sets the scissor only when it
+        // changes, also across its switches between the depth-write and depth-read framebuffers of one pass (resetting it
+        // here let the 3D scene draw over the letterbox bars of cutscenes). Only a list that has not set them yet
+        // starts with ones covering the framebuffer, because the GL context carries them over from other lists.
+        const bool resetViewport = !recordViewportSet;
+        const bool resetScissor = !recordScissorSet;
+        record([glFramebuffer, resetViewport, resetScissor](GLReplayState &state) {
+            state.framebuffer = glFramebuffer;
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, (glFramebuffer != nullptr) ? glFramebuffer->id : 0);
+            if (glFramebuffer != nullptr) {
+                if (resetViewport) {
+                    GLCALL(glViewport)(0, 0, GLsizei(glFramebuffer->width), GLsizei(glFramebuffer->height));
+                }
+
+                if (resetScissor) {
+                    GLCALL(glScissor)(0, 0, GLsizei(glFramebuffer->width), GLsizei(glFramebuffer->height));
+                    state.scissor = RenderRect(0, 0, int32_t(glFramebuffer->width), int32_t(glFramebuffer->height));
+                    state.scissorSet = true;
+                }
+            }
+        });
+    }
+
+    void GLCommandList::setDepthBias(float depthBias, float depthBiasClamp, float slopeScaledDepthBias) {
+        record([=](GLReplayState &) {
+            GLCALL(glEnable)(GL_POLYGON_OFFSET_FILL);
+            GLCALL(glPolygonOffset)(slopeScaledDepthBias, depthBias);
+        });
+    }
+
+    // Clears ignore the pipeline's write masks and the current scissor, like D3D's and Vulkan's clear commands.
+    template <typename ClearFunction>
+    static void clearWithRects(GLReplayState &state, const std::vector<RenderRect> &rects, ClearFunction clear) {
+        const uint32_t width = (state.framebuffer != nullptr) ? state.framebuffer->width : 0;
+        const uint32_t height = (state.framebuffer != nullptr) ? state.framebuffer->height : 0;
+        if (rects.empty()) {
+            GLCALL(glScissor)(0, 0, GLsizei(width), GLsizei(height));
+            clear();
+        }
+        else {
+            for (const RenderRect &rect : rects) {
+                GLCALL(glScissor)(rect.left, rect.top, std::max(rect.right - rect.left, 0), std::max(rect.bottom - rect.top, 0));
+                clear();
+            }
+        }
+
+        const RenderRect &scissor = state.scissor;
+        GLCALL(glScissor)(scissor.left, scissor.top, std::max(scissor.right - scissor.left, 0), std::max(scissor.bottom - scissor.top, 0));
+    }
+
+    void GLCommandList::clearColor(uint32_t attachmentIndex, RenderColor colorValue, const RenderRect *clearRects, uint32_t clearRectsCount) {
+        std::vector<RenderRect> rects;
+        if (clearRects != nullptr) {
+            rects.assign(clearRects, clearRects + clearRectsCount);
+        }
+
+        record([=](GLReplayState &state) {
+            GLCALL(glColorMaski)(attachmentIndex, GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+            clearWithRects(state, rects, [&]() { GLCALL(glClearBufferfv)(GL_COLOR, GLint(attachmentIndex), colorValue.rgba); });
+            if (state.pipeline != nullptr) {
+                state.pipeline = nullptr;
+            }
+        });
+    }
+
+    void GLCommandList::clearDepthStencil(bool clearDepth, bool clearStencil, float depthValue, uint32_t stencilValue, const RenderRect *clearRects, uint32_t clearRectsCount) {
+        std::vector<RenderRect> rects;
+        if (clearRects != nullptr) {
+            rects.assign(clearRects, clearRects + clearRectsCount);
+        }
+
+        record([=](GLReplayState &state) {
+            GLCALL(glDepthMask)(GL_TRUE);
+            clearWithRects(state, rects, [&]() {
+                if (clearDepth && clearStencil) {
+                    GLCALL(glClearBufferfi)(GL_DEPTH_STENCIL, 0, depthValue, GLint(stencilValue));
+                }
+                else if (clearDepth) {
+                    GLCALL(glClearBufferfv)(GL_DEPTH, 0, &depthValue);
+                }
+                else if (clearStencil) {
+                    const GLint stencil = GLint(stencilValue);
+                    GLCALL(glClearBufferiv)(GL_STENCIL, 0, &stencil);
+                }
+            });
+
+            // The pipeline's depth write state is restored when it is bound again.
+            state.pipeline = nullptr;
+        });
+    }
+
+    // Copies into a readback buffer refresh its CPU copy right away, so map() after the fence sees the data.
+    static void refreshReadback(const GLBuffer *buffer) {
+        if ((buffer->desc.heapType != RenderHeapType::READBACK) || buffer->shadow.empty()) {
+            return;
+        }
+
+        GLCALL(glBindBuffer)(GL_COPY_READ_BUFFER, buffer->id);
+        const void *data = GLCALL(glMapBufferRange)(GL_COPY_READ_BUFFER, 0, GLsizeiptr(buffer->desc.size), GL_MAP_READ_BIT);
+        if (data != nullptr) {
+            memcpy(const_cast<GLBuffer *>(buffer)->shadow.data(), data, size_t(buffer->desc.size));
+            GLCALL(glUnmapBuffer)(GL_COPY_READ_BUFFER);
+        }
+    }
+
+    void GLCommandList::copyBufferRegion(RenderBufferReference dstBuffer, RenderBufferReference srcBuffer, uint64_t size) {
+        const GLBuffer *dst = static_cast<const GLBuffer *>(dstBuffer.ref);
+        const GLBuffer *src = static_cast<const GLBuffer *>(srcBuffer.ref);
+        const uint64_t dstOffset = dstBuffer.offset;
+        const uint64_t srcOffset = srcBuffer.offset;
+        record([=](GLReplayState &) {
+            GLCALL(glBindBuffer)(GL_COPY_READ_BUFFER, src->id);
+            GLCALL(glBindBuffer)(GL_COPY_WRITE_BUFFER, dst->id);
+            GLCALL(glCopyBufferSubData)(GL_COPY_READ_BUFFER, GL_COPY_WRITE_BUFFER, GLintptr(srcOffset), GLintptr(dstOffset), GLsizeiptr(size));
+            refreshReadback(dst);
+        });
+    }
+
+    void GLCommandList::copyBuffer(const RenderBuffer *dstBuffer, const RenderBuffer *srcBuffer) {
+        const GLBuffer *dst = static_cast<const GLBuffer *>(dstBuffer);
+        const GLBuffer *src = static_cast<const GLBuffer *>(srcBuffer);
+        copyBufferRegion(RenderBufferReference(dst), RenderBufferReference(src), std::min(dst->desc.size, src->desc.size));
+    }
+
+    void GLCommandList::copyTextureRegion(const RenderTextureCopyLocation &dstLocation, const RenderTextureCopyLocation &srcLocation, uint32_t dstX, uint32_t dstY, uint32_t dstZ, const RenderBox *srcBox) {
+        const RenderTextureCopyLocation dst = dstLocation;
+        const RenderTextureCopyLocation src = srcLocation;
+        const bool hasBox = (srcBox != nullptr);
+        const RenderBox box = hasBox ? *srcBox : RenderBox();
+        record([=](GLReplayState &state) {
+            if ((dst.type == RenderTextureCopyType::SUBRESOURCE) && (src.type == RenderTextureCopyType::PLACED_FOOTPRINT)) {
+                // Buffer to texture.
+                const GLTexture *texture = static_cast<const GLTexture *>(dst.texture);
+                const GLBuffer *buffer = static_cast<const GLBuffer *>(src.buffer);
+                const uint32_t width = hasBox ? uint32_t(box.right - box.left) : src.placedFootprint.width;
+                const uint32_t height = hasBox ? uint32_t(box.bottom - box.top) : src.placedFootprint.height;
+                const uint32_t depth = hasBox ? uint32_t(box.back - box.front) : src.placedFootprint.depth;
+                const uint32_t blockWidth = RenderFormatBlockWidth(src.placedFootprint.format);
+                const uint64_t offset = src.placedFootprint.offset + (hasBox ? (uint64_t(box.top) * src.placedFootprint.rowWidth + box.left) * RenderFormatSize(src.placedFootprint.format) / blockWidth : 0);
+                GLCALL(glBindBuffer)(GL_PIXEL_UNPACK_BUFFER, buffer->id);
+                GLCALL(glPixelStorei)(GL_UNPACK_ALIGNMENT, 1);
+                GLCALL(glPixelStorei)(GL_UNPACK_ROW_LENGTH, GLint(src.placedFootprint.rowWidth));
+                GLCALL(glPixelStorei)(GL_UNPACK_IMAGE_HEIGHT, GLint(src.placedFootprint.height));
+                GLCALL(glBindTexture)(texture->target, texture->id);
+                const void *pixels = reinterpret_cast<const void *>(uintptr_t(offset));
+                const GLint level = GLint(dst.subresource.mipLevel);
+                if (texture->target == GL_TEXTURE_1D) {
+                    GLCALL(glTexSubImage1D)(texture->target, level, GLint(dstX), GLsizei(width), texture->format.format, texture->format.type, pixels);
+                }
+                else if (texture->target == GL_TEXTURE_3D) {
+                    GLCALL(glTexSubImage3D)(texture->target, level, GLint(dstX), GLint(dstY), GLint(dstZ), GLsizei(width), GLsizei(height), GLsizei(depth), texture->format.format, texture->format.type, pixels);
+                }
+                else {
+                    GLCALL(glTexSubImage2D)(texture->target, level, GLint(dstX), GLint(dstY), GLsizei(width), GLsizei(height), texture->format.format, texture->format.type, pixels);
+                }
+
+                GLCALL(glPixelStorei)(GL_UNPACK_ROW_LENGTH, 0);
+                GLCALL(glPixelStorei)(GL_UNPACK_IMAGE_HEIGHT, 0);
+                GLCALL(glBindBuffer)(GL_PIXEL_UNPACK_BUFFER, 0);
+            }
+            else if ((dst.type == RenderTextureCopyType::PLACED_FOOTPRINT) && (src.type == RenderTextureCopyType::SUBRESOURCE)) {
+                // Texture to buffer, through a read framebuffer.
+                const GLTexture *texture = static_cast<const GLTexture *>(src.texture);
+                const GLBuffer *buffer = static_cast<const GLBuffer *>(dst.buffer);
+                const int32_t x = hasBox ? box.left : 0;
+                const int32_t y = hasBox ? box.top : 0;
+                const uint32_t width = hasBox ? uint32_t(box.right - box.left) : dst.placedFootprint.width;
+                const uint32_t height = hasBox ? uint32_t(box.bottom - box.top) : dst.placedFootprint.height;
+                GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, texture->device->scratchFramebuffers[0]);
+                GLCALL(glFramebufferTexture2D)(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, texture->target, texture->id, GLint(src.subresource.mipLevel));
+                GLCALL(glReadBuffer)(GL_COLOR_ATTACHMENT0);
+                GLCALL(glBindBuffer)(GL_PIXEL_PACK_BUFFER, buffer->id);
+                GLCALL(glPixelStorei)(GL_PACK_ALIGNMENT, 1);
+                GLCALL(glPixelStorei)(GL_PACK_ROW_LENGTH, GLint(dst.placedFootprint.rowWidth));
+                GLCALL(glReadPixels)(x, y, GLsizei(width), GLsizei(height), texture->format.format, texture->format.type, reinterpret_cast<void *>(uintptr_t(dst.placedFootprint.offset)));
+                GLCALL(glPixelStorei)(GL_PACK_ROW_LENGTH, 0);
+                GLCALL(glBindBuffer)(GL_PIXEL_PACK_BUFFER, 0);
+                GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, 0);
+                refreshReadback(buffer);
+            }
+            else if ((dst.type == RenderTextureCopyType::SUBRESOURCE) && (src.type == RenderTextureCopyType::SUBRESOURCE)) {
+                const GLTexture *dstTexture = static_cast<const GLTexture *>(dst.texture);
+                const GLTexture *srcTexture = static_cast<const GLTexture *>(src.texture);
+                const int32_t x = hasBox ? box.left : 0;
+                const int32_t y = hasBox ? box.top : 0;
+                const int32_t z = hasBox ? box.front : 0;
+                const uint32_t width = hasBox ? uint32_t(box.right - box.left) : srcTexture->desc.width;
+                const uint32_t height = hasBox ? uint32_t(box.bottom - box.top) : std::max(srcTexture->desc.height, 1U);
+                const uint32_t depth = hasBox ? uint32_t(box.back - box.front) : 1;
+                GLCALL(glCopyImageSubData)(srcTexture->id, srcTexture->target, GLint(src.subresource.mipLevel), x, y, z,
+                    dstTexture->id, dstTexture->target, GLint(dst.subresource.mipLevel), GLint(dstX), GLint(dstY), GLint(dstZ), GLsizei(width), GLsizei(height), GLsizei(depth));
+            }
+        });
+    }
+
+    void GLCommandList::copyTexture(const RenderTexture *dstTexture, const RenderTexture *srcTexture) {
+        copyTextureRegion(RenderTextureCopyLocation::Subresource(dstTexture), RenderTextureCopyLocation::Subresource(srcTexture), 0, 0, 0, nullptr);
+    }
+
+    void GLCommandList::resolveTexture(const RenderTexture *dstTexture, const RenderTexture *srcTexture) {
+        resolveTextureRegion(dstTexture, 0, 0, srcTexture, nullptr, RenderResolveMode::AVERAGE);
+    }
+
+    void GLCommandList::resolveTextureRegion(const RenderTexture *dstTexture, uint32_t dstX, uint32_t dstY, const RenderTexture *srcTexture, const RenderRect *srcRect, RenderResolveMode resolveMode) {
+        const GLTexture *dst = static_cast<const GLTexture *>(dstTexture);
+        const GLTexture *src = static_cast<const GLTexture *>(srcTexture);
+        const RenderRect rect = (srcRect != nullptr) ? *srcRect : RenderRect(0, 0, int32_t(src->desc.width), int32_t(src->desc.height));
+        record([=](GLReplayState &state) {
+            const GLuint *scratch = src->device->scratchFramebuffers;
+            GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, scratch[0]);
+            GLCALL(glFramebufferTexture2D)(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, src->target, src->id, 0);
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, scratch[1]);
+            GLCALL(glFramebufferTexture2D)(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, dst->target, dst->id, 0);
+            GLCALL(glScissor)(0, 0, GLsizei(dst->desc.width), GLsizei(dst->desc.height));
+            const int32_t width = rect.right - rect.left;
+            const int32_t height = rect.bottom - rect.top;
+            GLCALL(glBlitFramebuffer)(rect.left, rect.top, rect.right, rect.bottom, GLint(dstX), GLint(dstY), GLint(dstX) + width, GLint(dstY) + height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, 0);
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, (state.framebuffer != nullptr) ? state.framebuffer->id : 0);
+            const RenderRect &scissor = state.scissor;
+            GLCALL(glScissor)(scissor.left, scissor.top, std::max(scissor.right - scissor.left, 0), std::max(scissor.bottom - scissor.top, 0));
+        });
+    }
+
+    // GLCommandQueue
+
+    std::unique_ptr<RenderCommandList> GLCommandQueue::createCommandList() {
+        return std::make_unique<GLCommandList>(device);
+    }
+
+    std::unique_ptr<RenderSwapChain> GLCommandQueue::createSwapChain(const RenderSwapChainDesc &desc) {
+        return std::make_unique<GLSwapChain>(device, desc);
+    }
+
+    void GLCommandQueue::executeCommandLists(const RenderCommandList **commandLists, uint32_t commandListCount, RenderCommandSemaphore **waitSemaphores, uint32_t waitSemaphoreCount, RenderCommandSemaphore **signalSemaphores, uint32_t signalSemaphoreCount, RenderCommandFence *signalFence) {
+        // All queues replay on the one GL thread in submission order, so semaphores need no work.
+        std::vector<std::shared_ptr<std::vector<GLCommand>>> lists;
+        for (uint32_t i = 0; i < commandListCount; i++) {
+            lists.emplace_back(static_cast<const GLCommandList *>(commandLists[i])->commands);
+        }
+
+        GLCommandFence *fence = static_cast<GLCommandFence *>(signalFence);
+        uint64_t fenceValue = 0;
+        if (fence != nullptr) {
+            std::unique_lock<std::mutex> lock(fence->mutex);
+            fenceValue = ++fence->submitted;
+        }
+
+        device->thread.post([lists, fence, fenceValue]() {
+            GLReplayState state;
+            for (const auto &list : lists) {
+                for (const GLCommand &command : *list) {
+                    command(state);
+                }
+            }
+
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, 0);
+            GLCALL(glFlush)();
+            if (fence != nullptr) {
+                std::unique_lock<std::mutex> lock(fence->mutex);
+                fence->completed = std::max(fence->completed, fenceValue);
+                fence->condition.notify_all();
+            }
+        });
+    }
+
+    void GLCommandQueue::waitForCommandFence(RenderCommandFence *fence) {
+        GLCommandFence *glFence = static_cast<GLCommandFence *>(fence);
+        std::unique_lock<std::mutex> lock(glFence->mutex);
+        const uint64_t target = glFence->submitted;
+        glFence->condition.wait(lock, [&]() { return glFence->completed >= target; });
+    }
+
+    // GLSwapChain
+
+    GLSwapChain::GLSwapChain(GLDevice *device, const RenderSwapChainDesc &desc) : device(device), desc(desc) {
+        queryWindowSize(width, height);
+        device->thread.call([this]() { GLCALL(glGenFramebuffers)(1, &readFramebuffer); });
+        createTextures();
+        setVsyncEnabled(true);
+    }
+
+    GLSwapChain::~GLSwapChain() {
+        textures.clear();
+        const GLuint framebufferId = readFramebuffer;
+        device->thread.post([framebufferId]() { GLCALL(glDeleteFramebuffers)(1, &framebufferId); });
+    }
+
+    void GLSwapChain::queryWindowSize(uint32_t &w, uint32_t &h) const {
+        // The platform looks at EGL or the Wayland window, which has to happen on the thread that owns the context.
+        device->thread.call([&]() {
+            device->platform.windowSize(w, h);
+        });
+    }
+
+    void GLSwapChain::createTextures() {
+        textures.clear();
+        if ((width == 0) || (height == 0)) {
+            return;
+        }
+
+        const uint32_t count = std::max(desc.textureCount, 2U);
+        for (uint32_t i = 0; i < count; i++) {
+            RenderTextureDesc textureDesc = RenderTextureDesc::ColorTarget(width, height, desc.format);
+            textures.emplace_back(std::make_unique<GLTexture>(device, textureDesc));
+        }
+    }
+
+    bool GLSwapChain::acquireTexture(RenderCommandSemaphore *signalSemaphore, uint32_t *textureIndex) {
+        if (textures.empty()) {
+            return false;
+        }
+
+        *textureIndex = nextIndex;
+        nextIndex = (nextIndex + 1) % uint32_t(textures.size());
+        return true;
+    }
+
+    bool GLSwapChain::present(uint32_t textureIndex, RenderCommandSemaphore **waitSemaphores, uint32_t waitSemaphoreCount) {
+        if (textureIndex >= textures.size()) {
+            return false;
+        }
+
+        const GLTexture *texture = textures[textureIndex].get();
+        const GLint w = GLint(width);
+        const GLint h = GLint(height);
+        device->thread.call([&]() {
+            // The image is stored with row 0 at the top; the window's row 0 is at the bottom, so the blit flips it.
+            GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, readFramebuffer);
+            GLCALL(glFramebufferTexture2D)(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, texture->target, texture->id, 0);
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, 0);
+            // Blits are clipped by the scissor test; the whole image is copied.
+            GLCALL(glDisable)(GL_SCISSOR_TEST);
+            GLCALL(glBlitFramebuffer)(0, 0, w, h, 0, h, w, 0, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            GLCALL(glEnable)(GL_SCISSOR_TEST);
+            GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, 0);
+            device->platform.swapBuffers();
+        });
+
+        return true;
+    }
+
+    bool GLSwapChain::resize() {
+        queryWindowSize(width, height);
+        createTextures();
+        nextIndex = 0;
+        return !textures.empty();
+    }
+
+    bool GLSwapChain::needsResize() const {
+        uint32_t w = 0;
+        uint32_t h = 0;
+        queryWindowSize(w, h);
+        return (w != width) || (h != height);
+    }
+
+    void GLSwapChain::setVsyncEnabled(bool enabled) {
+        vsyncEnabled = enabled;
+        device->thread.call([this]() {
+            device->platform.setSwapInterval(vsyncEnabled ? 1 : 0);
+        });
+    }
+
+    // Entry point.
+
+    std::unique_ptr<RenderInterface> CreateGLESInterface(RenderWindow renderWindow, RenderGLProfile profile) {
+        return std::make_unique<GLInterface>(renderWindow, profile);
+    }
+};
+
+#else
+
+namespace plume {
+    std::unique_ptr<RenderInterface> CreateGLESInterface(RenderWindow renderWindow, RenderGLProfile profile) {
+        // Windows (WGL) and Linux and Android (EGL) are built above. Other platforms have no OpenGL backend.
+        return nullptr;
+    }
+};
+
+#endif

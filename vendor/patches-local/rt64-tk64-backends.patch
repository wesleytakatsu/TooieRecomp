+
+        if (eglLibrary == nullptr) {
+            fprintf(stderr, "plume_gles: could not load libEGL.so.1 or libEGL.so.\n");
+            return false;
+        }
+
+        bool missingSymbol = false;
+        auto loadSymbol = [&](const char *name) -> void * {
+            void *address = dlsym(eglLibrary, name);
+            if (address == nullptr) {
+                fprintf(stderr, "plume_gles: missing EGL entry point %s.\n", name);
+                missingSymbol = true;
+            }
+
+            return address;
+        };
+
+        eglGetProcAddress = (PFN_eglGetProcAddress)(loadSymbol("eglGetProcAddress"));
+        eglGetDisplay = (PFN_eglGetDisplay)(loadSymbol("eglGetDisplay"));
+        eglInitialize = (PFN_eglInitialize)(loadSymbol("eglInitialize"));
+        eglTerminate = (PFN_eglTerminate)(loadSymbol("eglTerminate"));
+        eglBindAPI = (PFN_eglBindAPI)(loadSymbol("eglBindAPI"));
+        eglChooseConfig = (PFN_eglChooseConfig)(loadSymbol("eglChooseConfig"));
+        eglCreateWindowSurface = (PFN_eglCreateWindowSurface)(loadSymbol("eglCreateWindowSurface"));
+        eglDestroySurface = (PFN_eglDestroySurface)(loadSymbol("eglDestroySurface"));
+        eglCreateContext = (PFN_eglCreateContext)(loadSymbol("eglCreateContext"));
+        eglDestroyContext = (PFN_eglDestroyContext)(loadSymbol("eglDestroyContext"));
+        eglMakeCurrent = (PFN_eglMakeCurrent)(loadSymbol("eglMakeCurrent"));
+        eglSwapBuffers = (PFN_eglSwapBuffers)(loadSymbol("eglSwapBuffers"));
+        eglSwapInterval = (PFN_eglSwapInterval)(loadSymbol("eglSwapInterval"));
+        eglQueryString = (PFN_eglQueryString)(loadSymbol("eglQueryString"));
+        eglGetError = (PFN_eglGetError)(loadSymbol("eglGetError"));
+        eglQuerySurface = (PFN_eglQuerySurface)(loadSymbol("eglQuerySurface"));
+        if (missingSymbol) {
+            return false;
+        }
+
+        // EGL 1.5 exports this directly. Older libraries expose only the EXT entry, and only through eglGetProcAddress.
+        eglGetPlatformDisplay = (PFN_eglGetPlatformDisplay)(dlsym(eglLibrary, "eglGetPlatformDisplay"));
+        if (eglGetPlatformDisplay == nullptr) {
+            eglGetPlatformDisplay = (PFN_eglGetPlatformDisplay)(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+        }
+
+        auto report = [&](const char *message) {
+            fprintf(stderr, "plume_gles: %s (0x%X).\n", message, unsigned(eglGetError()));
+        };
+
+        // EGL keeps the first error until it is read, including across a later successful call.
+        auto clearError = [&]() {
+            eglGetError();
+        };
+
+        void *nativeDisplay = nullptr;
+        void *nativeWindow = nullptr;
+        unsigned int platformEnum = 0;
+        bool usePlatformDisplay = false;
+
+#if defined(__ANDROID__)
+        // EGL_DEFAULT_DISPLAY is null. The ANativeWindow is the native window.
+        nativeDisplay = nullptr;
+        nativeWindow = window;
+        usePlatformDisplay = false;
+        if (nativeWindow == nullptr) {
+            fprintf(stderr, "plume_gles: the window has no native window.\n");
+            return false;
+        }
+#elif defined(PLUME_SDL_VULKAN_ENABLED)
+        sdlWindow = window;
+        if (sdlWindow == nullptr) {
+            fprintf(stderr, "plume_gles: the window has no native window.\n");
+            return false;
+        }
+
+        SDL_SysWMinfo wmInfo = {};
+        SDL_VERSION(&wmInfo.version);
+        if (SDL_GetWindowWMInfo(sdlWindow, &wmInfo) == SDL_FALSE) {
+            fprintf(stderr, "plume_gles: SDL_GetWindowWMInfo failed.\n");
+            return false;
+        }
+
+        bool foundWindow = false;
+#if defined(SDL_VIDEO_DRIVER_X11) || !defined(SDL_VIDEO_DRIVER_WAYLAND)
+        if (wmInfo.subsystem == SDL_SYSWM_X11) {
+            foundWindow = true;
+            nativeDisplay = wmInfo.info.x11.display;
+            // The EGL native-window argument is pointer-sized. An X11 Window is an integer of that size.
+            nativeWindow = (void *)(uintptr_t)(wmInfo.info.x11.window);
+            platformEnum = EGL_PLATFORM_X11_KHR;
+            usePlatformDisplay = true;
+            if (nativeDisplay == nullptr) {
+                fprintf(stderr, "plume_gles: the window has no native display.\n");
+                return false;
+            }
+
+            if (wmInfo.info.x11.window == 0) {
+                fprintf(stderr, "plume_gles: the window has no native window.\n");
+                return false;
+            }
+        }
+#endif
+#if defined(SDL_VIDEO_DRIVER_WAYLAND) || !defined(SDL_VIDEO_DRIVER_X11)
+        if (wmInfo.subsystem == SDL_SYSWM_WAYLAND) {
+            foundWindow = true;
+            nativeDisplay = wmInfo.info.wl.display;
+            platformEnum = EGL_PLATFORM_WAYLAND_KHR;
+            usePlatformDisplay = true;
+            if (nativeDisplay == nullptr) {
+                fprintf(stderr, "plume_gles: the window has no native display.\n");
+                return false;
+            }
+
+            if (wmInfo.info.wl.surface == nullptr) {
+                fprintf(stderr, "plume_gles: the window has no native window.\n");
+                return false;
+            }
+
+            waylandLibrary = dlopen("libwayland-egl.so.1", RTLD_NOW | RTLD_LOCAL);
+            if (waylandLibrary == nullptr) {
+                waylandLibrary = dlopen("libwayland-egl.so", RTLD_NOW | RTLD_LOCAL);
+            }
+
+            if (waylandLibrary == nullptr) {
+                fprintf(stderr, "plume_gles: could not load libwayland-egl.so.1 or libwayland-egl.so.\n");
+                return false;
+            }
+
+            bool missingWayland = false;
+            auto loadWayland = [&](const char *name) -> void * {
+                void *address = dlsym(waylandLibrary, name);
+                if (address == nullptr) {
+                    fprintf(stderr, "plume_gles: missing Wayland EGL entry point %s.\n", name);
+                    missingWayland = true;
+                }
+
+                return address;
+            };
+
+            wl_egl_window_create = (PFN_wl_egl_window_create)(loadWayland("wl_egl_window_create"));
+            wl_egl_window_destroy = (PFN_wl_egl_window_destroy)(loadWayland("wl_egl_window_destroy"));
+            wl_egl_window_resize = (PFN_wl_egl_window_resize)(loadWayland("wl_egl_window_resize"));
+            if (missingWayland) {
+                return false;
+            }
+
+            int drawableWidth = 0;
+            int drawableHeight = 0;
+            SDL_Vulkan_GetDrawableSize(sdlWindow, &drawableWidth, &drawableHeight);
+            if (drawableWidth < 0) {
+                drawableWidth = 0;
+            }
+
+            if (drawableHeight < 0) {
+                drawableHeight = 0;
+            }
+
+            waylandWindow = wl_egl_window_create(wmInfo.info.wl.surface, drawableWidth, drawableHeight);
+            if (waylandWindow == nullptr) {
+                fprintf(stderr, "plume_gles: wl_egl_window_create failed.\n");
+                return false;
+            }
+
+            cachedWidth = uint32_t(drawableWidth);
+            cachedHeight = uint32_t(drawableHeight);
+            nativeWindow = waylandWindow;
+        }
+#endif
+        if (!foundWindow) {
+            fprintf(stderr, "plume_gles: unsupported SDL window subsystem.\n");
+            return false;
+        }
+#else
+        nativeDisplay = window.display;
+        // The EGL native-window argument is pointer-sized. An X11 Window is an integer of that size.
+        nativeWindow = (void *)(uintptr_t)(window.window);
+        platformEnum = EGL_PLATFORM_X11_KHR;
+        usePlatformDisplay = true;
+        if (nativeDisplay == nullptr) {
+            fprintf(stderr, "plume_gles: the window has no native display.\n");
+            return false;
+        }
+
+        if (window.window == 0) {
+            fprintf(stderr, "plume_gles: the window has no native window.\n");
+            return false;
+        }
+#endif
+
+        display = nullptr;
+        if (usePlatformDisplay && (eglGetPlatformDisplay != nullptr)) {
+            display = eglGetPlatformDisplay(platformEnum, nativeDisplay, nullptr);
+        }
+
+        if (display == nullptr) {
+            clearError();
+            display = eglGetDisplay(nativeDisplay);
+        }
+
+        if (display == nullptr) {
+            report("eglGetDisplay failed");
+            return false;
+        }
+
+        clearError();
+        if (eglInitialize(display, nullptr, nullptr) == 0) {
+            report("eglInitialize failed");
+            return false;
+        }
+
+        displayInitialized = true;
+        clearError();
+        if (eglBindAPI(esProfile ? EGL_OPENGL_ES_API : EGL_OPENGL_API) == 0) {
+            report(esProfile ? "eglBindAPI(OpenGL ES) failed" : "eglBindAPI(OpenGL) failed");
+            return false;
+        }
+
+        const int32_t configAttributes[] = {
+            EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+            EGL_RED_SIZE, 8,
+            EGL_GREEN_SIZE, 8,
+            EGL_BLUE_SIZE, 8,
+            // No alpha: the image is blitted to the window, and X11 windows are usually 24-bit, which an alpha config
+            // can fail to match.
+            EGL_ALPHA_SIZE, 0,
+            EGL_DEPTH_SIZE, 0,
+            EGL_RENDERABLE_TYPE, esProfile ? EGL_OPENGL_ES3_BIT : EGL_OPENGL_BIT,
+            EGL_NONE
+        };
+        EGLint configCount = 0;
+        clearError();
+        if ((eglChooseConfig(display, configAttributes, &config, 1, &configCount) == 0) || (configCount == 0) || (config == nullptr)) {
+            report("no matching EGL config");
+            return false;
+        }
+
+        // ES is 3.2, then 3.1. Desktop is 4.3 core. Debug is requested first and retried without that attribute.
+        auto tryContext = [&](int major, int minor, bool withDebug) -> bool {
+            int32_t attributes[9];
+            int count = 0;
+            attributes[count++] = EGL_CONTEXT_MAJOR_VERSION;
+            attributes[count++] = major;
+            attributes[count++] = EGL_CONTEXT_MINOR_VERSION;
+            attributes[count++] = minor;
+            if (!esProfile) {
+                attributes[count++] = EGL_CONTEXT_OPENGL_PROFILE_MASK;
+                attributes[count++] = EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT;
+            }
+
+            if (withDebug) {
+                attributes[count++] = EGL_CONTEXT_OPENGL_DEBUG;
+                attributes[count++] = 1;
+            }
+
+            attributes[count++] = EGL_NONE;
+            context = eglCreateContext(display, config, nullptr, attributes);
+            return context != nullptr;
+        };
+
+        bool createdContext = false;
+        clearError();
+        if (esProfile) {
+            if (debug) {
+                createdContext = tryContext(3, 2, true) || tryContext(3, 2, false) || tryContext(3, 1, true) || tryContext(3, 1, false);
+            }
+            else {
+                createdContext = tryContext(3, 2, false) || tryContext(3, 1, false);
+            }
+        }
+        else if (debug) {
+            createdContext = tryContext(4, 3, true) || tryContext(4, 3, false);
+        }
+        else {
+            createdContext = tryContext(4, 3, false);
+        }
+
+        if (!createdContext) {
+            report(esProfile ? "could not create an OpenGL ES 3.2 or 3.1 context" : "could not create an OpenGL 4.3 core context");
+            return false;
+        }
+
+        clearError();
+        surface = eglCreateWindowSurface(display, config, nativeWindow, nullptr);
+        if (surface == nullptr) {
+            report("eglCreateWindowSurface failed");
+            return false;
+        }
+
+        clearError();
+        if (eglMakeCurrent(display, surface, surface, context) == 0) {
+            report("eglMakeCurrent failed");
+            return false;
+        }
+
+        return true;
+    }
+
+    void GLPlatform::destroy() {
+        if (displayInitialized && (eglMakeCurrent != nullptr) && (display != nullptr)) {
+            eglMakeCurrent(display, nullptr, nullptr, nullptr);
+        }
+
+        if ((context != nullptr) && (eglDestroyContext != nullptr) && (display != nullptr)) {
+            eglDestroyContext(display, context);
+        }
+
+        if ((surface != nullptr) && (eglDestroySurface != nullptr) && (display != nullptr)) {
+            eglDestroySurface(display, surface);
+        }
+
+#if !defined(__ANDROID__) && defined(PLUME_SDL_VULKAN_ENABLED) && (defined(SDL_VIDEO_DRIVER_WAYLAND) || !defined(SDL_VIDEO_DRIVER_X11))
+        if ((waylandWindow != nullptr) && (wl_egl_window_destroy != nullptr)) {
+            wl_egl_window_destroy(waylandWindow);
+        }
+#endif
+
+        if (displayInitialized && (eglTerminate != nullptr) && (display != nullptr)) {
+            eglTerminate(display);
+        }
+
+        displayInitialized = false;
+        display = nullptr;
+        config = nullptr;
+        context = nullptr;
+        surface = nullptr;
+        eglGetProcAddress = nullptr;
+        eglGetDisplay = nullptr;
+        eglInitialize = nullptr;
+        eglTerminate = nullptr;
+        eglBindAPI = nullptr;
+        eglChooseConfig = nullptr;
+        eglCreateWindowSurface = nullptr;
+        eglDestroySurface = nullptr;
+        eglCreateContext = nullptr;
+        eglDestroyContext = nullptr;
+        eglMakeCurrent = nullptr;
+        eglSwapBuffers = nullptr;
+        eglSwapInterval = nullptr;
+        eglQueryString = nullptr;
+        eglGetError = nullptr;
+        eglQuerySurface = nullptr;
+        eglGetPlatformDisplay = nullptr;
+
+#if !defined(__ANDROID__) && defined(PLUME_SDL_VULKAN_ENABLED) && (defined(SDL_VIDEO_DRIVER_WAYLAND) || !defined(SDL_VIDEO_DRIVER_X11))
+        waylandWindow = nullptr;
+        wl_egl_window_create = nullptr;
+        wl_egl_window_destroy = nullptr;
+        wl_egl_window_resize = nullptr;
+        cachedWidth = 0;
+        cachedHeight = 0;
+        if (waylandLibrary != nullptr) {
+            dlclose(waylandLibrary);
+            waylandLibrary = nullptr;
+        }
+#endif
+
+#if defined(PLUME_SDL_VULKAN_ENABLED) && !defined(__ANDROID__)
+        sdlWindow = nullptr;
+#endif
+
+        esProfile = false;
+        clientLibraryTried = false;
+        if (clientLibrary != nullptr) {
+            dlclose(clientLibrary);
+            clientLibrary = nullptr;
+        }
+
+        if (eglLibrary != nullptr) {
+            dlclose(eglLibrary);
+            eglLibrary = nullptr;
+        }
+    }
+
+    void *GLPlatform::getProcAddress(const char *name) {
+        void *address = nullptr;
+        if (eglGetProcAddress != nullptr) {
+            address = eglGetProcAddress(name);
+        }
+
+        if (address != nullptr) {
+            return address;
+        }
+
+        // eglGetProcAddress is not required to return every core entry point, so the client library is the fallback.
+        if (!clientLibraryTried) {
+            clientLibraryTried = true;
+            if (esProfile) {
+                // Android ships the library without a version suffix.
+                clientLibrary = dlopen("libGLESv2.so.2", RTLD_NOW | RTLD_LOCAL);
+                if (clientLibrary == nullptr) {
+                    clientLibrary = dlopen("libGLESv2.so", RTLD_NOW | RTLD_LOCAL);
+                }
+
+                if (clientLibrary == nullptr) {
+                    fprintf(stderr, "plume_gles: could not load libGLESv2.so.2 or libGLESv2.so.\n");
+                }
+            }
+            else {
+                clientLibrary = dlopen("libOpenGL.so.0", RTLD_NOW | RTLD_LOCAL);
+                if (clientLibrary == nullptr) {
+                    clientLibrary = dlopen("libGL.so.1", RTLD_NOW | RTLD_LOCAL);
+                }
+
+                if (clientLibrary == nullptr) {
+                    fprintf(stderr, "plume_gles: could not load libOpenGL.so.0 or libGL.so.1.\n");
+                }
+            }
+        }
+
+        if (clientLibrary == nullptr) {
+            return nullptr;
+        }
+
+        return dlsym(clientLibrary, name);
+    }
+
+    bool GLPlatform::swapBuffers() {
+        if ((eglSwapBuffers == nullptr) || (display == nullptr) || (surface == nullptr)) {
+            return false;
+        }
+
+        return eglSwapBuffers(display, surface) != 0;
+    }
+
+    void GLPlatform::setSwapInterval(int interval) {
+        if ((eglSwapInterval == nullptr) || (display == nullptr)) {
+            return;
+        }
+
+        if (eglSwapInterval(display, interval) == 0) {
+            const unsigned int error = (eglGetError != nullptr) ? unsigned(eglGetError()) : 0u;
+            fprintf(stderr, "plume_gles: eglSwapInterval failed (0x%X).\n", error);
+        }
+    }
+
+    void GLPlatform::windowSize(uint32_t &width, uint32_t &height) const {
+#if defined(PLUME_SDL_VULKAN_ENABLED) && !defined(__ANDROID__)
+        int drawableWidth = 0;
+        int drawableHeight = 0;
+        if (sdlWindow != nullptr) {
+            SDL_Vulkan_GetDrawableSize(sdlWindow, &drawableWidth, &drawableHeight);
+        }
+
+        if (drawableWidth < 0) {
+            drawableWidth = 0;
+        }
+
+        if (drawableHeight < 0) {
+            drawableHeight = 0;
+        }
+
+        width = uint32_t(drawableWidth);
+        height = uint32_t(drawableHeight);
+#if defined(SDL_VIDEO_DRIVER_WAYLAND) || !defined(SDL_VIDEO_DRIVER_X11)
+        // The Wayland EGL window does not follow SDL resizes on its own.
+        if ((waylandWindow != nullptr) && (wl_egl_window_resize != nullptr) && ((cachedWidth != width) || (cachedHeight != height))) {
+            wl_egl_window_resize(waylandWindow, int(width), int(height), 0, 0);
+            cachedWidth = width;
+            cachedHeight = height;
+        }
+#endif
+#else
+        width = 0;
+        height = 0;
+        if ((eglQuerySurface == nullptr) || (display == nullptr) || (surface == nullptr)) {
+            return;
+        }
+
+        EGLint value = 0;
+        if (eglQuerySurface(display, surface, EGL_WIDTH, &value) != 0) {
+            width = (value > 0) ? uint32_t(value) : 0;
+        }
+
+        if (eglQuerySurface(display, surface, EGL_HEIGHT, &value) != 0) {
+            height = (value > 0) ? uint32_t(value) : 0;
+        }
+#endif
+    }
+
+#endif
+
+    bool GLDevice::createContext() {
+        // The window belongs to the host. WGL (Windows) or EGL (Linux and Android) binds a context to it.
+        if (!platform.create(window, profile, debugOutput)) {
+            return false;
+        }
+
+        // Entry points come from the window-system layer: WGL (with opengl32.dll for GL 1.1) or EGL.
+        bool missing = false;
+        auto optional = [](const char *name) {
+            return (strcmp(name, "glTexStorage1D") == 0) || (strcmp(name, "glTexSubImage1D") == 0) || (strcmp(name, "glDebugMessageCallback") == 0) ||
+                (strcmp(name, "glClipControl") == 0) || (strcmp(name, "glClipControlEXT") == 0);
+        };
+
+        auto load = [&](const char *name) -> void * {
+            void *address = platform.getProcAddress(name);
+            if ((address == nullptr) && !optional(name)) {
+                fprintf(stderr, "plume_gles: missing entry point %s.\n", name);
+                missing = true;
+            }
+
+            return address;
+        };
+
+#       define PLUME_GL_LOAD(ret, name, params) gl::name##Ptr = (gl::PFN_##name)(load(#name));
+        PLUME_GL_FUNCTIONS(PLUME_GL_LOAD)
+#       undef PLUME_GL_LOAD
+
+        if (missing) {
+            return false;
+        }
+
+        if (debugOutput && (GLCALL(glDebugMessageCallback) != nullptr)) {
+            GLCALL(glEnable)(GL_DEBUG_OUTPUT);
+            GLCALL(glEnable)(GL_DEBUG_OUTPUT_SYNCHRONOUS);
+            GLCALL(glDebugMessageCallback)(debugCallback, nullptr);
+        }
+
+        GLint extensionCount = 0;
+        GLCALL(glGetIntegerv)(GL_NUM_EXTENSIONS, &extensionCount);
+        for (GLint i = 0; i < extensionCount; i++) {
+            const char *extension = (const char *)(GLCALL(glGetStringi)(GL_EXTENSIONS, GLuint(i)));
+            if (extension != nullptr) {
+                extensions.emplace_back(extension);
+            }
+        }
+
+        // D3D and Vulkan map clip-space depth 0..w to 0..1. GL maps -w..w, which the translator can emulate by rewriting
+        // z = 2z - w, but that costs depth precision: N64 decals and layered geometry drawn at nearly equal depths then
+        // fight. GL 4.5 / ARB_clip_control and GLES' EXT_clip_control select the D3D convention directly, so the rewrite is
+        // skipped there.
+        GLint majorVersion = 0;
+        GLint minorVersion = 0;
+        GLCALL(glGetIntegerv)(GL_MAJOR_VERSION, &majorVersion);
+        GLCALL(glGetIntegerv)(GL_MINOR_VERSION, &minorVersion);
+        const bool version45 = (majorVersion > 4) || ((majorVersion == 4) && (minorVersion >= 5));
+        auto hasExtension = [&](const char *name) { return std::find(extensions.begin(), extensions.end(), name) != extensions.end(); };
+        if ((profile == RenderGLProfile::DESKTOP) && (GLCALL(glClipControl) != nullptr) && (version45 || hasExtension("GL_ARB_clip_control"))) {
+            GLCALL(glClipControl)(GL_LOWER_LEFT, GL_ZERO_TO_ONE);
+            zeroToOneDepth = true;
+        }
+        else if ((profile == RenderGLProfile::ES) && (GLCALL(glClipControlEXT) != nullptr) && hasExtension("GL_EXT_clip_control")) {
+            GLCALL(glClipControlEXT)(GL_LOWER_LEFT, GL_ZERO_TO_ONE);
+            zeroToOneDepth = true;
+        }
+
+        GLint maxTextureSize = 0;
+        GLCALL(glGetIntegerv)(GL_MAX_TEXTURE_SIZE, &maxTextureSize);
+        capabilities.maxTextureSize = uint64_t(maxTextureSize);
+        capabilities.descriptorIndexing = false;
+        capabilities.triangleFan = true;
+
+        const char *renderer = (const char *)(GLCALL(glGetString)(GL_RENDERER));
+        const char *vendor = (const char *)(GLCALL(glGetString)(GL_VENDOR));
+        const char *version = (const char *)(GLCALL(glGetString)(GL_VERSION));
+        description.name = std::string(renderer != nullptr ? renderer : "OpenGL") + " (" + (version != nullptr ? version : "") + ")";
+        description.type = RenderDeviceType::UNKNOWN;
+        const std::string vendorName = (vendor != nullptr) ? vendor : "";
+        if (vendorName.find("NVIDIA") != std::string::npos) {
+            description.vendor = RenderDeviceVendor::NVIDIA;
+        }
+        else if ((vendorName.find("ATI") != std::string::npos) || (vendorName.find("AMD") != std::string::npos)) {
+            description.vendor = RenderDeviceVendor::AMD;
+        }
+        else if (vendorName.find("Intel") != std::string::npos) {
+            description.vendor = RenderDeviceVendor::INTEL;
+        }
+
+        GLCALL(glGenFramebuffers)(2, scratchFramebuffers);
+        GLCALL(glEnable)(GL_SCISSOR_TEST);
+        if (profile == RenderGLProfile::DESKTOP) {
+            GLCALL(glEnable)(GL_PROGRAM_POINT_SIZE);
+        }
+
+        fprintf(stdout, "plume_gles: %s\n", description.name.c_str());
+        if (debugOutput) {
+            uint32_t width = 0;
+            uint32_t height = 0;
+            platform.windowSize(width, height);
+            fprintf(stderr, "plume_gles: context created for a %ld x %ld window\n", long(width), long(height));
+        }
+
+        return true;
+    }
+
+    std::unique_ptr<RenderDescriptorSet> GLDevice::createDescriptorSet(const RenderDescriptorSetDesc &desc) {
+        return std::make_unique<GLDescriptorSet>(desc);
+    }
+
+    std::unique_ptr<RenderShader> GLDevice::createShader(const void *data, uint64_t size, const char *entryPointName, RenderShaderFormat format) {
+        assert((format == RenderShaderFormat::SPIRV) && "The OpenGL backend only accepts SPIR-V.");
+        std::unique_ptr<GLShader> shader = std::make_unique<GLShader>();
+        shader->words.resize(size / sizeof(uint32_t));
+        memcpy(shader->words.data(), data, shader->words.size() * sizeof(uint32_t));
+        shader->entryPoint = (entryPointName != nullptr) ? entryPointName : "main";
+        return shader;
+    }
+
+    std::unique_ptr<RenderSampler> GLDevice::createSampler(const RenderSamplerDesc &desc) {
+        return std::make_unique<GLSampler>(this, desc);
+    }
+
+    std::unique_ptr<RenderPipeline> GLDevice::createComputePipeline(const RenderComputePipelineDesc &desc) {
+        return std::make_unique<GLPipeline>(this, desc);

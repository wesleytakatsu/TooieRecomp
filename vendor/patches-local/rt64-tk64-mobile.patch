+    std::unique_ptr<RenderTextureView> GLTexture::createTextureView(const RenderTextureViewDesc &desc) const {
+        // Views bind the whole texture for now; RT64 uses them for single-mip 2D views of the same format.
+        std::unique_ptr<GLTextureView> view = std::make_unique<GLTextureView>();
+        view->texture = this;
+        view->desc = desc;
+        return view;
+    }

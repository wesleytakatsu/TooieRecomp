+#endif
+        if (!foundWindow) {
+            fprintf(stderr, "plume_gles: unsupported SDL window subsystem.\n");
+            return false;
+        }
+#else
+        nativeDisplay = window.display;
+        // The EGL native-window argument is pointer-sized. An X11 Window is an integer of that size.
+        nativeWindow = (void *)(uintptr_t)(window.window);
+        platformEnum = EGL_PLATFORM_X11_KHR;
+        usePlatformDisplay = true;
+        if (nativeDisplay == nullptr) {
+            fprintf(stderr, "plume_gles: the window has no native display.\n");
+            return false;
+        }
+
+        if (window.window == 0) {
+            fprintf(stderr, "plume_gles: the window has no native window.\n");
+            return false;
+        }
+#endif
+
+        display = nullptr;
+        if (usePlatformDisplay && (eglGetPlatformDisplay != nullptr)) {
+            display = eglGetPlatformDisplay(platformEnum, nativeDisplay, nullptr);
+        }
+
+        if (display == nullptr) {
+            clearError();
+            display = eglGetDisplay(nativeDisplay);
+        }
+
+        if (display == nullptr) {
+            report("eglGetDisplay failed");
+            return false;
+        }
+
+        clearError();
+        if (eglInitialize(display, nullptr, nullptr) == 0) {
+            report("eglInitialize failed");
+            return false;
+        }
+
+        displayInitialized = true;
+        clearError();
+        if (eglBindAPI(esProfile ? EGL_OPENGL_ES_API : EGL_OPENGL_API) == 0) {
+            report(esProfile ? "eglBindAPI(OpenGL ES) failed" : "eglBindAPI(OpenGL) failed");
+            return false;
+        }
+
+        const int32_t configAttributes[] = {
+            EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+            EGL_RED_SIZE, 8,
+            EGL_GREEN_SIZE, 8,
+            EGL_BLUE_SIZE, 8,
+            // No alpha: the image is blitted to the window, and X11 windows are usually 24-bit, which an alpha config
+            // can fail to match.
+            EGL_ALPHA_SIZE, 0,
+            EGL_DEPTH_SIZE, 0,
+            EGL_RENDERABLE_TYPE, esProfile ? EGL_OPENGL_ES3_BIT : EGL_OPENGL_BIT,
+            EGL_NONE
+        };
+        EGLConfig configs[64] = {};
+        EGLint configCount = 0;
+        clearError();
+        if ((eglChooseConfig(display, configAttributes, configs, 64, &configCount) == 0) || (configCount == 0) || (configs[0] == nullptr)) {
+            report("no matching EGL config");
+            return false;
+        }
+
+        // A size of 0 is only a minimum, and the list is sorted by color depth, so a config with alpha can come first (libmali).
+        // The compositor would then blend the window by what the image has in alpha, which for RT64 is coverage, not opacity.
+        config = configs[0];
+        for (EGLint i = 0; (i < configCount) && (eglGetConfigAttrib != nullptr); i++) {
+            EGLint alphaSize = 0;
+            if ((eglGetConfigAttrib(display, configs[i], EGL_ALPHA_SIZE, &alphaSize) != 0) && (alphaSize == 0)) {
+                config = configs[i];
+                break;
+            }
+        }
+
+        // ES is 3.2, then 3.1. Desktop is 4.3 core. Debug is requested first and retried without that attribute.
+        auto tryContext = [&](int major, int minor, bool withDebug) -> bool {
+            int32_t attributes[9];
+            int count = 0;
+            attributes[count++] = EGL_CONTEXT_MAJOR_VERSION;
+            attributes[count++] = major;
+            attributes[count++] = EGL_CONTEXT_MINOR_VERSION;
+            attributes[count++] = minor;
+            if (!esProfile) {
+                attributes[count++] = EGL_CONTEXT_OPENGL_PROFILE_MASK;
+                attributes[count++] = EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT;
+            }
+
+            if (withDebug) {
+                attributes[count++] = EGL_CONTEXT_OPENGL_DEBUG;
+                attributes[count++] = 1;
+            }
+
+            attributes[count++] = EGL_NONE;
+            context = eglCreateContext(display, config, nullptr, attributes);
+            return context != nullptr;
+        };
+
+        bool createdContext = false;
+        clearError();
+        if (esProfile) {
+            if (debug) {
+                createdContext = tryContext(3, 2, true) || tryContext(3, 2, false) || tryContext(3, 1, true) || tryContext(3, 1, false);
+            }
+            else {
+                createdContext = tryContext(3, 2, false) || tryContext(3, 1, false);
+            }
+        }
+        else if (debug) {
+            createdContext = tryContext(4, 3, true) || tryContext(4, 3, false);
+        }
+        else {
+            createdContext = tryContext(4, 3, false);
+        }
+
+        if (!createdContext) {
+            report(esProfile ? "could not create an OpenGL ES 3.2 or 3.1 context" : "could not create an OpenGL 4.3 core context");
+            return false;
+        }
+
+        clearError();
+        surface = eglCreateWindowSurface(display, config, nativeWindow, nullptr);
+        if (surface == nullptr) {
+            report("eglCreateWindowSurface failed");
+            return false;
+        }
+
+        clearError();
+        if (eglMakeCurrent(display, surface, surface, context) == 0) {
+            report("eglMakeCurrent failed");
+            return false;
+        }
+
+        return true;
+    }

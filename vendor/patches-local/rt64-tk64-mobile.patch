+    void GLPlatform::destroy() {
+        if (displayInitialized && (eglMakeCurrent != nullptr) && (display != nullptr)) {
+            eglMakeCurrent(display, nullptr, nullptr, nullptr);
+        }
+
+        if ((context != nullptr) && (eglDestroyContext != nullptr) && (display != nullptr)) {
+            eglDestroyContext(display, context);
+        }
+
+        if ((surface != nullptr) && (eglDestroySurface != nullptr) && (display != nullptr)) {
+            eglDestroySurface(display, surface);
+        }
+
+#if !defined(__ANDROID__) && defined(PLUME_SDL_VULKAN_ENABLED) && (defined(SDL_VIDEO_DRIVER_WAYLAND) || !defined(SDL_VIDEO_DRIVER_X11))
+        if ((waylandWindow != nullptr) && (wl_egl_window_destroy != nullptr)) {
+            wl_egl_window_destroy(waylandWindow);
+        }
+#endif
+
+        if (displayInitialized && (eglTerminate != nullptr) && (display != nullptr)) {
+            eglTerminate(display);
+        }
+
+        displayInitialized = false;
+        display = nullptr;
+        config = nullptr;
+        context = nullptr;
+        surface = nullptr;
+        eglGetProcAddress = nullptr;
+        eglGetDisplay = nullptr;
+        eglInitialize = nullptr;
+        eglTerminate = nullptr;
+        eglBindAPI = nullptr;
+        eglChooseConfig = nullptr;
+        eglGetConfigAttrib = nullptr;
+        eglCreateWindowSurface = nullptr;
+        eglDestroySurface = nullptr;
+        eglCreateContext = nullptr;
+        eglDestroyContext = nullptr;
+        eglMakeCurrent = nullptr;
+        eglSwapBuffers = nullptr;
+        eglSwapInterval = nullptr;
+        eglQueryString = nullptr;
+        eglGetError = nullptr;
+        eglQuerySurface = nullptr;
+        eglGetPlatformDisplay = nullptr;
+
+#if !defined(__ANDROID__) && defined(PLUME_SDL_VULKAN_ENABLED) && (defined(SDL_VIDEO_DRIVER_WAYLAND) || !defined(SDL_VIDEO_DRIVER_X11))
+        waylandWindow = nullptr;
+        wl_egl_window_create = nullptr;
+        wl_egl_window_destroy = nullptr;
+        wl_egl_window_resize = nullptr;
+        cachedWidth = 0;
+        cachedHeight = 0;
+        if (waylandLibrary != nullptr) {
+            dlclose(waylandLibrary);
+            waylandLibrary = nullptr;
+        }
+#endif
+
+#if defined(PLUME_SDL_VULKAN_ENABLED) && !defined(__ANDROID__)
+        sdlWindow = nullptr;
+#endif
+
+        esProfile = false;
+        clientLibraryTried = false;
+        if (clientLibrary != nullptr) {
+            dlclose(clientLibrary);
+            clientLibrary = nullptr;
+        }
+
+        if (eglLibrary != nullptr) {
+            dlclose(eglLibrary);
+            eglLibrary = nullptr;
+        }
+    }
+
+    void *GLPlatform::getProcAddress(const char *name) {
+        void *address = nullptr;
+        if (eglGetProcAddress != nullptr) {
+            address = eglGetProcAddress(name);
+        }
+
+        if (address != nullptr) {
+            return address;
+        }
+
+        // eglGetProcAddress is not required to return every core entry point, so the client library is the fallback.
+        if (!clientLibraryTried) {
+            clientLibraryTried = true;
+            if (esProfile) {
+                // Android ships the library without a version suffix.
+                clientLibrary = dlopen("libGLESv2.so.2", RTLD_NOW | RTLD_LOCAL);
+                if (clientLibrary == nullptr) {
+                    clientLibrary = dlopen("libGLESv2.so", RTLD_NOW | RTLD_LOCAL);
+                }
+
+                if (clientLibrary == nullptr) {
+                    fprintf(stderr, "plume_gles: could not load libGLESv2.so.2 or libGLESv2.so.\n");
+                }
+            }
+            else {
+                clientLibrary = dlopen("libOpenGL.so.0", RTLD_NOW | RTLD_LOCAL);
+                if (clientLibrary == nullptr) {
+                    clientLibrary = dlopen("libGL.so.1", RTLD_NOW | RTLD_LOCAL);
+                }
+
+                if (clientLibrary == nullptr) {
+                    fprintf(stderr, "plume_gles: could not load libOpenGL.so.0 or libGL.so.1.\n");
+                }
+            }
+        }
+
+        if (clientLibrary == nullptr) {
+            return nullptr;
+        }
+
+        return dlsym(clientLibrary, name);
+    }
+
+    bool GLPlatform::swapBuffers() {
+        if ((eglSwapBuffers == nullptr) || (display == nullptr) || (surface == nullptr)) {
+            return false;
+        }
+
+        return eglSwapBuffers(display, surface) != 0;
+    }
+
+    void GLPlatform::setSwapInterval(int interval) {
+        if ((eglSwapInterval == nullptr) || (display == nullptr)) {
+            return;
+        }
+
+        if (eglSwapInterval(display, interval) == 0) {
+            const unsigned int error = (eglGetError != nullptr) ? unsigned(eglGetError()) : 0u;
+            fprintf(stderr, "plume_gles: eglSwapInterval failed (0x%X).\n", error);
+        }
+    }
+
+    void GLPlatform::windowSize(uint32_t &width, uint32_t &height) const {
+#if defined(PLUME_SDL_VULKAN_ENABLED) && !defined(__ANDROID__)
+        int drawableWidth = 0;
+        int drawableHeight = 0;
+        if (sdlWindow != nullptr) {
+            SDL_Vulkan_GetDrawableSize(sdlWindow, &drawableWidth, &drawableHeight);
+        }
+
+        if (drawableWidth < 0) {
+            drawableWidth = 0;
+        }
+
+        if (drawableHeight < 0) {
+            drawableHeight = 0;
+        }
+
+        width = uint32_t(drawableWidth);
+        height = uint32_t(drawableHeight);
+#if defined(SDL_VIDEO_DRIVER_WAYLAND) || !defined(SDL_VIDEO_DRIVER_X11)
+        // The Wayland EGL window does not follow SDL resizes on its own.
+        if ((waylandWindow != nullptr) && (wl_egl_window_resize != nullptr) && ((cachedWidth != width) || (cachedHeight != height))) {
+            wl_egl_window_resize(waylandWindow, int(width), int(height), 0, 0);
+            cachedWidth = width;
+            cachedHeight = height;
+        }
+#endif
+#else
+        width = 0;
+        height = 0;
+        if ((eglQuerySurface == nullptr) || (display == nullptr) || (surface == nullptr)) {
+            return;
+        }
+
+        EGLint value = 0;
+        if (eglQuerySurface(display, surface, EGL_WIDTH, &value) != 0) {
+            width = (value > 0) ? uint32_t(value) : 0;
+        }
+
+        if (eglQuerySurface(display, surface, EGL_HEIGHT, &value) != 0) {
+            height = (value > 0) ? uint32_t(value) : 0;
+        }
+#endif
+    }
+
+#endif
+
+    bool GLDevice::createContext() {
+        // The window belongs to the host. WGL (Windows) or EGL (Linux and Android) binds a context to it.
+        if (!platform.create(window, profile, debugOutput)) {
+            return false;
+        }
+
+        // Entry points come from the window-system layer: WGL (with opengl32.dll for GL 1.1) or EGL.
+        bool missing = false;
+        auto optional = [](const char *name) {
+            return (strcmp(name, "glTexStorage1D") == 0) || (strcmp(name, "glTexSubImage1D") == 0) || (strcmp(name, "glDebugMessageCallback") == 0) ||
+                (strcmp(name, "glClipControl") == 0) || (strcmp(name, "glClipControlEXT") == 0);
+        };
+
+        auto load = [&](const char *name) -> void * {
+            void *address = platform.getProcAddress(name);
+            if ((address == nullptr) && !optional(name)) {
+                fprintf(stderr, "plume_gles: missing entry point %s.\n", name);
+                missing = true;
+            }
+
+            return address;
+        };
+
+#       define PLUME_GL_LOAD(ret, name, params) gl::name##Ptr = (gl::PFN_##name)(load(#name));
+        PLUME_GL_FUNCTIONS(PLUME_GL_LOAD)
+#       undef PLUME_GL_LOAD
+
+        if (missing) {
+            return false;
+        }
+
+        if (debugOutput && (GLCALL(glDebugMessageCallback) != nullptr)) {
+            GLCALL(glEnable)(GL_DEBUG_OUTPUT);
+            GLCALL(glEnable)(GL_DEBUG_OUTPUT_SYNCHRONOUS);
+            GLCALL(glDebugMessageCallback)(debugCallback, nullptr);
+        }
+
+        GLint extensionCount = 0;
+        GLCALL(glGetIntegerv)(GL_NUM_EXTENSIONS, &extensionCount);
+        for (GLint i = 0; i < extensionCount; i++) {
+            const char *extension = (const char *)(GLCALL(glGetStringi)(GL_EXTENSIONS, GLuint(i)));
+            if (extension != nullptr) {
+                extensions.emplace_back(extension);
+            }
+        }
+
+        // D3D and Vulkan map clip-space depth 0..w to 0..1. GL maps -w..w, which the translator can emulate by rewriting
+        // z = 2z - w, but that costs depth precision: N64 decals and layered geometry drawn at nearly equal depths then
+        // fight. GL 4.5 / ARB_clip_control and GLES' EXT_clip_control select the D3D convention directly, so the rewrite is
+        // skipped there.
+        GLint majorVersion = 0;
+        GLint minorVersion = 0;
+        GLCALL(glGetIntegerv)(GL_MAJOR_VERSION, &majorVersion);
+        GLCALL(glGetIntegerv)(GL_MINOR_VERSION, &minorVersion);
+        const bool version45 = (majorVersion > 4) || ((majorVersion == 4) && (minorVersion >= 5));
+        auto hasExtension = [&](const char *name) { return std::find(extensions.begin(), extensions.end(), name) != extensions.end(); };
+        depthClampSupported = (profile == RenderGLProfile::DESKTOP) || hasExtension("GL_EXT_depth_clamp");
+        if ((profile == RenderGLProfile::DESKTOP) && (GLCALL(glClipControl) != nullptr) && (version45 || hasExtension("GL_ARB_clip_control"))) {
+            GLCALL(glClipControl)(GL_LOWER_LEFT, GL_ZERO_TO_ONE);
+            zeroToOneDepth = true;
+        }
+        else if ((profile == RenderGLProfile::ES) && (GLCALL(glClipControlEXT) != nullptr) && hasExtension("GL_EXT_clip_control")) {
+            GLCALL(glClipControlEXT)(GL_LOWER_LEFT, GL_ZERO_TO_ONE);
+            zeroToOneDepth = true;
+        }
+
+        GLint maxTextureSize = 0;
+        GLCALL(glGetIntegerv)(GL_MAX_TEXTURE_SIZE, &maxTextureSize);
+        capabilities.maxTextureSize = uint64_t(maxTextureSize);
+        capabilities.descriptorIndexing = false;
+        capabilities.triangleFan = true;
+
+        const char *renderer = (const char *)(GLCALL(glGetString)(GL_RENDERER));
+        const char *vendor = (const char *)(GLCALL(glGetString)(GL_VENDOR));
+        armDriver = (vendor != nullptr) && (std::strcmp(vendor, "ARM") == 0);
+        depthFetchSupported = armDriver && hasExtension("GL_ARM_shader_framebuffer_fetch_depth_stencil");
+        GLCALL(glGetIntegerv)(0x8872, &maxFragmentTextures); // GL_MAX_TEXTURE_IMAGE_UNITS
+        GLCALL(glGetIntegerv)(0x8824, &maxDrawBuffers); // GL_MAX_DRAW_BUFFERS
+        const char *version = (const char *)(GLCALL(glGetString)(GL_VERSION));
+        description.name = std::string(renderer != nullptr ? renderer : "OpenGL") + " (" + (version != nullptr ? version : "") + ")";
+        description.type = RenderDeviceType::UNKNOWN;
+        const std::string vendorName = (vendor != nullptr) ? vendor : "";
+        if (vendorName.find("NVIDIA") != std::string::npos) {
+            description.vendor = RenderDeviceVendor::NVIDIA;
+        }
+        else if ((vendorName.find("ATI") != std::string::npos) || (vendorName.find("AMD") != std::string::npos)) {
+            description.vendor = RenderDeviceVendor::AMD;
+        }
+        else if (vendorName.find("Intel") != std::string::npos) {
+            description.vendor = RenderDeviceVendor::INTEL;
+        }
+
+        GLCALL(glGenFramebuffers)(2, scratchFramebuffers);
+        GLCALL(glEnable)(GL_SCISSOR_TEST);
+        if (profile == RenderGLProfile::DESKTOP) {
+            GLCALL(glEnable)(GL_PROGRAM_POINT_SIZE);
+        }
+
+        fprintf(stdout, "plume_gles: %s\n", description.name.c_str());
+        if (debugOutput) {
+            uint32_t width = 0;
+            uint32_t height = 0;
+            platform.windowSize(width, height);
+            fprintf(stderr, "plume_gles: context created for a %ld x %ld window\n", long(width), long(height));
+        }
+
+        return true;
+    }

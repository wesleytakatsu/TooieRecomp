+    static void APIENTRY debugCallback(GLenum source, GLenum type, GLuint id, GLenum severity, GLsizei length, const GLchar *message, const void *userParam) {
+        // Performance hints (buffer placement, pixel transfer stalls) are left out; they are not errors.
+        const GLenum GL_DEBUG_TYPE_PERFORMANCE = 0x8250;
+        if (type == GL_DEBUG_TYPE_PERFORMANCE) {
+            return;
+        }
+
+        if ((severity == GL_DEBUG_SEVERITY_HIGH) || (severity == GL_DEBUG_SEVERITY_MEDIUM) || (type == GL_DEBUG_TYPE_ERROR)) {
+            fprintf(stderr, "plume_gles: %s\n", message);
+        }
+    }
+
+    GLDevice::GLDevice(RenderWindow window, RenderGLProfile profile) : window(window), profile(profile) {
+        const char *debugValue = getenv("TK64_GL_DEBUG");
+        debugOutput = (debugValue != nullptr) && (strcmp(debugValue, "1") == 0);
+        thread.start();
+    }
+
+    GLDevice::~GLDevice() {
+        thread.call([this]() {
+            if (scratchFramebuffers[0] != 0) {
+                GLCALL(glDeleteFramebuffers)(2, scratchFramebuffers);
+            }
+
+            platform.destroy();
+        });
+
+        thread.stop();
+    }

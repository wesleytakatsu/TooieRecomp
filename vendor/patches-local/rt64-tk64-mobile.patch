+    std::unique_ptr<RenderShader> GLDevice::createShader(const void *data, uint64_t size, const char *entryPointName, RenderShaderFormat format) {
+        assert((format == RenderShaderFormat::SPIRV) && "The OpenGL backend only accepts SPIR-V.");
+        std::unique_ptr<GLShader> shader = std::make_unique<GLShader>();
+        shader->words.resize(size / sizeof(uint32_t));
+        memcpy(shader->words.data(), data, shader->words.size() * sizeof(uint32_t));
+        shader->entryPoint = (entryPointName != nullptr) ? entryPointName : "main";
+        return shader;
+    }

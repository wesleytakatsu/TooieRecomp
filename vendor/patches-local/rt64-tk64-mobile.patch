+    bool GLPlatform::create(RenderWindow window, RenderGLProfile profile, bool debug) {
+        esProfile = (profile == RenderGLProfile::ES);
+        eglLibrary = dlopen("libEGL.so.1", RTLD_NOW | RTLD_LOCAL);
+        if (eglLibrary == nullptr) {
+            eglLibrary = dlopen("libEGL.so", RTLD_NOW | RTLD_LOCAL);
+        }
+
+        if (eglLibrary == nullptr) {
+            fprintf(stderr, "plume_gles: could not load libEGL.so.1 or libEGL.so.\n");
+            return false;
+        }
+
+        bool missingSymbol = false;
+        auto loadSymbol = [&](const char *name) -> void * {
+            void *address = dlsym(eglLibrary, name);
+            if (address == nullptr) {
+                fprintf(stderr, "plume_gles: missing EGL entry point %s.\n", name);
+                missingSymbol = true;
+            }
+
+            return address;
+        };
+
+        eglGetProcAddress = (PFN_eglGetProcAddress)(loadSymbol("eglGetProcAddress"));
+        eglGetDisplay = (PFN_eglGetDisplay)(loadSymbol("eglGetDisplay"));
+        eglInitialize = (PFN_eglInitialize)(loadSymbol("eglInitialize"));
+        eglTerminate = (PFN_eglTerminate)(loadSymbol("eglTerminate"));
+        eglBindAPI = (PFN_eglBindAPI)(loadSymbol("eglBindAPI"));
+        eglChooseConfig = (PFN_eglChooseConfig)(loadSymbol("eglChooseConfig"));
+        eglGetConfigAttrib = (PFN_eglGetConfigAttrib)(loadSymbol("eglGetConfigAttrib"));
+        eglCreateWindowSurface = (PFN_eglCreateWindowSurface)(loadSymbol("eglCreateWindowSurface"));
+        eglDestroySurface = (PFN_eglDestroySurface)(loadSymbol("eglDestroySurface"));
+        eglCreateContext = (PFN_eglCreateContext)(loadSymbol("eglCreateContext"));
+        eglDestroyContext = (PFN_eglDestroyContext)(loadSymbol("eglDestroyContext"));
+        eglMakeCurrent = (PFN_eglMakeCurrent)(loadSymbol("eglMakeCurrent"));
+        eglSwapBuffers = (PFN_eglSwapBuffers)(loadSymbol("eglSwapBuffers"));
+        eglSwapInterval = (PFN_eglSwapInterval)(loadSymbol("eglSwapInterval"));
+        eglQueryString = (PFN_eglQueryString)(loadSymbol("eglQueryString"));
+        eglGetError = (PFN_eglGetError)(loadSymbol("eglGetError"));
+        eglQuerySurface = (PFN_eglQuerySurface)(loadSymbol("eglQuerySurface"));
+        if (missingSymbol) {
+            return false;
+        }
+
+        // EGL 1.5 exports this directly. Older libraries expose only the EXT entry, and only through eglGetProcAddress.
+        eglGetPlatformDisplay = (PFN_eglGetPlatformDisplay)(dlsym(eglLibrary, "eglGetPlatformDisplay"));
+        if (eglGetPlatformDisplay == nullptr) {
+            eglGetPlatformDisplay = (PFN_eglGetPlatformDisplay)(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+        }
+
+        auto report = [&](const char *message) {
+            fprintf(stderr, "plume_gles: %s (0x%X).\n", message, unsigned(eglGetError()));
+        };
+
+        // EGL keeps the first error until it is read, including across a later successful call.
+        auto clearError = [&]() {
+            eglGetError();
+        };
+
+        void *nativeDisplay = nullptr;
+        void *nativeWindow = nullptr;
+        unsigned int platformEnum = 0;
+        bool usePlatformDisplay = false;
+
+#if defined(__ANDROID__)
+        // EGL_DEFAULT_DISPLAY is null. The ANativeWindow is the native window.
+        nativeDisplay = nullptr;
+        nativeWindow = window;
+        usePlatformDisplay = false;
+        if (nativeWindow == nullptr) {
+            fprintf(stderr, "plume_gles: the window has no native window.\n");
+            return false;
+        }
+#elif defined(PLUME_SDL_VULKAN_ENABLED)
+        sdlWindow = window;
+        if (sdlWindow == nullptr) {
+            fprintf(stderr, "plume_gles: the window has no native window.\n");
+            return false;
+        }
+
+        SDL_SysWMinfo wmInfo = {};
+        SDL_VERSION(&wmInfo.version);
+        if (SDL_GetWindowWMInfo(sdlWindow, &wmInfo) == SDL_FALSE) {
+            fprintf(stderr, "plume_gles: SDL_GetWindowWMInfo failed.\n");
+            return false;
+        }
+
+        bool foundWindow = false;
+#if defined(SDL_VIDEO_DRIVER_X11) || !defined(SDL_VIDEO_DRIVER_WAYLAND)
+        if (wmInfo.subsystem == SDL_SYSWM_X11) {
+            foundWindow = true;
+            nativeDisplay = wmInfo.info.x11.display;
+            // The EGL native-window argument is pointer-sized. An X11 Window is an integer of that size.
+            nativeWindow = (void *)(uintptr_t)(wmInfo.info.x11.window);
+            platformEnum = EGL_PLATFORM_X11_KHR;
+            usePlatformDisplay = true;
+            if (nativeDisplay == nullptr) {
+                fprintf(stderr, "plume_gles: the window has no native display.\n");
+                return false;
+            }
+
+            if (wmInfo.info.x11.window == 0) {
+                fprintf(stderr, "plume_gles: the window has no native window.\n");
+                return false;
+            }
+        }
+#endif
+#if defined(SDL_VIDEO_DRIVER_WAYLAND) || !defined(SDL_VIDEO_DRIVER_X11)
+        if (wmInfo.subsystem == SDL_SYSWM_WAYLAND) {
+            foundWindow = true;
+            nativeDisplay = wmInfo.info.wl.display;
+            platformEnum = EGL_PLATFORM_WAYLAND_KHR;
+            usePlatformDisplay = true;
+            if (nativeDisplay == nullptr) {
+                fprintf(stderr, "plume_gles: the window has no native display.\n");
+                return false;
+            }
+
+            if (wmInfo.info.wl.surface == nullptr) {
+                fprintf(stderr, "plume_gles: the window has no native window.\n");
+                return false;
+            }
+
+            waylandLibrary = dlopen("libwayland-egl.so.1", RTLD_NOW | RTLD_LOCAL);
+            if (waylandLibrary == nullptr) {
+                waylandLibrary = dlopen("libwayland-egl.so", RTLD_NOW | RTLD_LOCAL);
+            }
+
+            if (waylandLibrary == nullptr) {
+                fprintf(stderr, "plume_gles: could not load libwayland-egl.so.1 or libwayland-egl.so.\n");
+                return false;
+            }
+
+            bool missingWayland = false;
+            auto loadWayland = [&](const char *name) -> void * {
+                void *address = dlsym(waylandLibrary, name);
+                if (address == nullptr) {
+                    fprintf(stderr, "plume_gles: missing Wayland EGL entry point %s.\n", name);
+                    missingWayland = true;
+                }

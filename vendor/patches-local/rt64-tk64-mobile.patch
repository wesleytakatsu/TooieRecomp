+    // GLPipelineLayout
+
+    GLPipelineLayout::GLPipelineLayout(const RenderPipelineLayoutDesc &desc) {
+        pushConstantRanges.assign(desc.pushConstantRanges, desc.pushConstantRanges + desc.pushConstantRangesCount);
+        setLayouts.resize(desc.descriptorSetDescsCount);
+        for (uint32_t s = 0; s < desc.descriptorSetDescsCount; s++) {
+            const RenderDescriptorSetDesc &setDesc = desc.descriptorSetDescs[s];
+            SetLayout &setLayout = setLayouts[s];
+            uint32_t start = 0;
+            for (uint32_t r = 0; r < setDesc.descriptorRangesCount; r++) {
+                RenderDescriptorRange range = setDesc.descriptorRanges[r];
+                // A boundless last range keeps its upper bound here: the layout's own size is only a hint (often 0), and each
+                // set allocates as many entries as it was created with.
+                std::vector<const RenderSampler *> samplers;
+                if (range.immutableSampler != nullptr) {
+                    samplers.assign(range.immutableSampler, range.immutableSampler + range.count);
+                }
+
+                setLayout.ranges.emplace_back(range);
+                setLayout.rangeStart.emplace_back(start);
+                setLayout.immutableSamplers.emplace_back(std::move(samplers));
+                start += range.count;
+            }
+        }
+    }
+
+    bool GLPipelineLayout::findDescriptor(uint32_t set, uint32_t binding, uint32_t arrayIndex, uint32_t &descriptorIndex, const RenderSampler **immutableSampler) const {
+        if (set >= setLayouts.size()) {
+            return false;
+        }
+
+        const SetLayout &setLayout = setLayouts[set];
+        for (size_t r = 0; r < setLayout.ranges.size(); r++) {
+            const RenderDescriptorRange &range = setLayout.ranges[r];
+            if ((binding < range.binding) || (binding >= (range.binding + range.count))) {
+                continue;
+            }
+
+            const uint32_t offset = (binding - range.binding) + arrayIndex;
+            if (offset >= range.count) {
+                return false;
+            }
+
+            descriptorIndex = setLayout.rangeStart[r] + offset;
+            if (immutableSampler != nullptr) {
+                *immutableSampler = setLayout.immutableSamplers[r].empty() ? nullptr : setLayout.immutableSamplers[r][offset];
+            }
+
+            return true;
+        }
+
+        return false;
+    }
+
+    // GLDescriptorSet
+
+    GLDescriptorSet::GLDescriptorSet(const RenderDescriptorSetDesc &desc) {
+        uint32_t count = 0;
+        for (uint32_t r = 0; r < desc.descriptorRangesCount; r++) {
+            const bool boundless = desc.lastRangeIsBoundless && (r == (desc.descriptorRangesCount - 1));
+            count += boundless ? std::max(desc.boundlessRangeSize, 1U) : desc.descriptorRanges[r].count;
+        }
+
+        entries.resize(count);
+    }
+
+    void GLDescriptorSet::setBuffer(uint32_t descriptorIndex, const RenderBuffer *buffer, uint64_t bufferSize, const RenderBufferStructuredView *bufferStructuredView, const RenderBufferFormattedView *bufferFormattedView) {
+        if (descriptorIndex >= entries.size()) {
+            return;
+        }
+
+        Entry &entry = entries[descriptorIndex];
+        entry.buffer = static_cast<const GLBuffer *>(buffer);
+        entry.bufferSize = bufferSize;
+        entry.structureStride = (bufferStructuredView != nullptr) ? bufferStructuredView->structureByteStride : 0;
+        entry.firstElement = (bufferStructuredView != nullptr) ? bufferStructuredView->firstElement : 0;
+        entry.formattedView = static_cast<const GLBufferFormattedView *>(bufferFormattedView);
+    }
+
+    void GLDescriptorSet::setTexture(uint32_t descriptorIndex, const RenderTexture *texture, RenderTextureLayout textureLayout, const RenderTextureView *textureView) {
+        if (descriptorIndex >= entries.size()) {
+            return;
+        }
+
+        Entry &entry = entries[descriptorIndex];
+        entry.texture = static_cast<const GLTexture *>(texture);
+        entry.textureView = static_cast<const GLTextureView *>(textureView);
+    }
+
+    void GLDescriptorSet::setSampler(uint32_t descriptorIndex, const RenderSampler *sampler) {
+        if (descriptorIndex >= entries.size()) {
+            return;
+        }
+
+        entries[descriptorIndex].sampler = static_cast<const GLSampler *>(sampler);
+    }
+
+    // GLPipeline
+
+    // Assigns GL binding points shared by every stage of a pipeline: the same (class, set, binding) gets the same
+    // binding in all stages, so a resource seen by two stages is bound once.
+    struct GLBindingAllocator {
+        std::map<std::tuple<int, uint32_t, uint32_t>, uint32_t> assigned;
+        std::map<int, uint32_t> next;
+
+        uint32_t operator()(const tk64::ResourceLocation &location) {
+            const int resourceClass = int(location.resourceClass);
+            const auto key = std::make_tuple(resourceClass, location.set, location.binding);
+            auto it = assigned.find(key);
+            if (it != assigned.end()) {
+                return it->second;
+            }
+
+            const uint32_t binding = next[resourceClass];
+            next[resourceClass] += location.arraySize;
+            assigned[key] = binding;
+            return binding;
+        }
+    };
+
+    static GLuint compileStage(GLenum stageType, const std::string &source, const char *label) {
+        GLuint shader = GLCALL(glCreateShader)(stageType);
+        const GLchar *text = source.c_str();
+        GLCALL(glShaderSource)(shader, 1, &text, nullptr);
+        GLCALL(glCompileShader)(shader);
+        GLint status = 0;
+        GLCALL(glGetShaderiv)(shader, GL_COMPILE_STATUS, &status);
+        if (status == 0) {
+            GLint logLength = 0;
+            GLCALL(glGetShaderiv)(shader, GL_INFO_LOG_LENGTH, &logLength);
+            std::string log(size_t(std::max(logLength, 1)), '\0');
+            GLCALL(glGetShaderInfoLog)(shader, logLength, nullptr, log.data());
+            fprintf(stderr, "plume_gles: %s shader failed to compile:\n%s\n", label, log.c_str());
+            GLCALL(glDeleteShader)(shader);
+            return 0;
+        }
+
+        return shader;
+    }
+
+    // libmali has no shader cache of its own, unlike Mesa, so every run compiled each program again on the GL thread, at up to
+    // seconds per program. Programs are kept in the port's shader cache folder, named by a hash of their sources and the driver.
+    static std::string programCachePath(const GLDevice *device, const std::string &sourceA, const std::string &sourceB) {
+        static const std::string directory = []() {
+            const char *custom = getenv("TK64_PROGRAM_CACHE_DIR");
+            const char *mesa = getenv("MESA_SHADER_CACHE_DIR");
+            std::string path = (custom != nullptr) ? custom : ((mesa != nullptr) ? mesa : "shadercache");
+            std::error_code error;
+            std::filesystem::create_directories(path, error);
+            return path;
+        }();
+
+        uint64_t hash = 14695981039346656037ULL;
+        const auto add = [&](const char *text, size_t size) {
+            for (size_t i = 0; i < size; i++) {
+                hash = (hash ^ uint8_t(text[i])) * 1099511628211ULL;
+            }
+        };
+
+        const char *version = (const char *)(GLCALL(glGetString)(GL_VERSION));
+        add(version, strlen(version));
+        add(sourceA.data(), sourceA.size());
+        add(sourceB.data(), sourceB.size());
+        char name[32];
+        snprintf(name, sizeof(name), "/tk64-%016llx.bin", (unsigned long long)hash);
+        return directory + name;
+    }
+
+    static GLuint loadCachedProgram(const GLDevice *device, const std::string &sourceA, const std::string &sourceB) {
+        if (!device->armDriver) {
+            return 0;
+        }
+
+        FILE *file = fopen(programCachePath(device, sourceA, sourceB).c_str(), "rb");
+        if (file == nullptr) {
+            return 0;
+        }
+
+        GLenum binaryFormat = 0;
+        std::vector<uint8_t> binary;
+        const bool headerRead = (fread(&binaryFormat, sizeof(binaryFormat), 1, file) == 1);
+        fseek(file, 0, SEEK_END);
+        const long fileSize = ftell(file);
+        if (headerRead && (fileSize > long(sizeof(binaryFormat)))) {
+            binary.resize(size_t(fileSize) - sizeof(binaryFormat));
+            fseek(file, long(sizeof(binaryFormat)), SEEK_SET);
+            if (fread(binary.data(), 1, binary.size(), file) != binary.size()) {
+                binary.clear();
+            }
+        }
+
+        fclose(file);
+        if (binary.empty()) {
+            return 0;
+        }
+
+        const GLuint program = GLCALL(glCreateProgram)();
+        GLCALL(glProgramBinary)(program, binaryFormat, binary.data(), GLsizei(binary.size()));
+        GLint status = 0;
+        GLCALL(glGetProgramiv)(program, GL_LINK_STATUS, &status);
+        if (status == 0) {
+            GLCALL(glDeleteProgram)(program);
+            return 0;
+        }
+
+        return program;
+    }
+
+    static void saveCachedProgram(const GLDevice *device, GLuint program, const std::string &sourceA, const std::string &sourceB) {
+        if (!device->armDriver) {
+            return;
+        }
+
+        GLint length = 0;
+        GLCALL(glGetProgramiv)(program, 0x8741, &length); // GL_PROGRAM_BINARY_LENGTH
+        if (length <= 0) {
+            return;
+        }
+
+        std::vector<uint8_t> binary(size_t(length), 0);
+        GLenum binaryFormat = 0;
+        GLsizei written = 0;
+        GLCALL(glGetProgramBinary)(program, length, &written, &binaryFormat, binary.data());
+        if (written <= 0) {
+            return;
+        }
+
+        const std::string path = programCachePath(device, sourceA, sourceB);
+        const std::string temporary = path + ".tmp";
+        FILE *file = fopen(temporary.c_str(), "wb");
+        if (file != nullptr) {
+            const bool ok = (fwrite(&binaryFormat, sizeof(binaryFormat), 1, file) == 1) && (fwrite(binary.data(), 1, size_t(written), file) == size_t(written));
+            fclose(file);
+            if (ok) {
+                std::error_code error;
+                std::filesystem::rename(temporary, path, error);
+            }
+        }
+    }
+
+    static bool linkProgram(GLuint program, const char *label) {
+        GLCALL(glLinkProgram)(program);
+        GLint status = 0;
+        GLCALL(glGetProgramiv)(program, GL_LINK_STATUS, &status);
+        if (status == 0) {
+            GLint logLength = 0;
+            GLCALL(glGetProgramiv)(program, GL_INFO_LOG_LENGTH, &logLength);
+            std::string log(size_t(std::max(logLength, 1)), '\0');
+            GLCALL(glGetProgramInfoLog)(program, logLength, nullptr, log.data());
+            fprintf(stderr, "plume_gles: %s program failed to link:\n%s\n", label, log.c_str());
+            return false;
+        }
+
+        return true;
+    }
+
+    static void collectPushConstants(GLuint program, const tk64::TranslatedShader &translated, std::vector<GLPipeline::PushConstantUniform> &pushConstants) {
+        for (const tk64::PushConstantMember &member : translated.pushConstantMembers) {
+            bool known = false;
+            for (const GLPipeline::PushConstantUniform &uniform : pushConstants) {
+                known = known || (uniform.member.offset == member.offset);
+            }
+
+            if (known) {
+                continue;
+            }
+
+            const std::string name = translated.pushConstantBlockName + "." + member.name;
+            GLPipeline::PushConstantUniform uniform;
+            uniform.location = GLCALL(glGetUniformLocation)(program, name.c_str());
+            uniform.member = member;
+            if (uniform.location >= 0) {
+                pushConstants.emplace_back(uniform);
+            }
+        }
+    }
+
+    static void appendResources(const tk64::TranslatedShader &translated, std::vector<tk64::CombinedSampler> &combinedSamplers, std::vector<tk64::BoundResource> &resources) {
+        combinedSamplers.insert(combinedSamplers.end(), translated.combinedSamplers.begin(), translated.combinedSamplers.end());
+        for (const tk64::BoundResource &resource : translated.resources) {
+            if (resource.resourceClass == tk64::ResourceClass::Sampler) {
+                continue;
+            }
+
+            bool known = false;
+            for (const tk64::BoundResource &existing : resources) {
+                known = known || ((existing.resourceClass == resource.resourceClass) && (existing.set == resource.set) && (existing.binding == resource.binding));
+            }
+
+            if (!known) {
+                resources.emplace_back(resource);
+            }
+        }
+    }
+
+    GLPipeline::GLPipeline(GLDevice *device, const RenderGraphicsPipelineDesc &desc) : device(device), type(Type::Graphics), graphicsDesc(desc) {
+        layout = static_cast<const GLPipelineLayout *>(desc.pipelineLayout);
+        inputSlots.assign(desc.inputSlots, desc.inputSlots + desc.inputSlotsCount);
+
+        // Translate both stages with one binding allocator; the pixel shader's texture units follow the vertex shader's.
+        GLBindingAllocator allocator;
+        tk64::BindingMapper mapper = [&](const tk64::ResourceLocation &location) { return allocator(location); };
+        const GLShader *vertexShader = static_cast<const GLShader *>(desc.vertexShader);
+        const GLShader *pixelShader = static_cast<const GLShader *>(desc.pixelShader);
+        tk64::TranslationOptions vertexOptions;
+        vertexOptions.glClipSpaceFixup = !device->zeroToOneDepth;
+        vertexOptions.clampVertexDepth = !device->depthClampSupported && !desc.depthClipEnabled;
+        tk64::TranslatedShader vertex = tk64::translateSpirv(vertexShader->words.data(), vertexShader->words.size(), device->shaderLanguage(), mapper, vertexOptions);
+        uint32_t textureUnitBase = 0;
+        for (const tk64::CombinedSampler &combined : vertex.combinedSamplers) {
+            textureUnitBase = std::max(textureUnitBase, combined.textureUnit + combined.arraySize);
+        }
+
+        uint32_t nextUnit = textureUnitBase;
+        tk64::BindingMapper pixelMapper = [&](const tk64::ResourceLocation &location) {
+            if (location.resourceClass == tk64::ResourceClass::Texture) {
+                const uint32_t unit = nextUnit;
+                nextUnit += location.arraySize;
+                return unit;
+            }
+
+            return allocator(location);
+        };
+
+        tk64::TranslatedShader pixel;
+        if (pixelShader != nullptr) {
+            tk64::TranslationOptions pixelOptions;
+            pixelOptions.dropLastTmemSlot = (device->maxFragmentTextures < 17);
+            pixelOptions.depthFetch = device->depthFetchSupported;
+            pixelOptions.depthFetchSet = 3; // RT64's gBackgroundDepth.
+            pixelOptions.depthFetchBinding = 2;
+            const auto driverHas = [&](const char *name) { return std::find(device->extensions.begin(), device->extensions.end(), name) != device->extensions.end(); };
+            if ((device->shaderLanguage() == tk64::ShaderLanguage::GLSL_ES_310) && !driverHas("GL_EXT_blend_func_extended") && driverHas("GL_EXT_shader_framebuffer_fetch")) {
+                const RenderBlendDesc &blend = desc.renderTargetBlend[0];
+                blendInShader = blend.blendEnabled && (blend.srcBlend == RenderBlend::SRC1_ALPHA) && (blend.dstBlend == RenderBlend::INV_SRC1_ALPHA);
+                pixelOptions.dualSourceAsVariable = true;
+                pixelOptions.dualSourceBlend = blendInShader;
+                pixelOptions.dualSourceAddDstAlpha = (blend.dstBlendAlpha == RenderBlend::ONE);
+            }
+
+            pixel = tk64::translateSpirv(pixelShader->words.data(), pixelShader->words.size(), device->shaderLanguage(), pixelMapper, pixelOptions);
+        }
+
+        if (!vertex.ok || ((pixelShader != nullptr) && !pixel.ok)) {
+            fprintf(stderr, "plume_gles: shader translation failed: %s%s\n", vertex.error.c_str(), pixel.error.c_str());
+            return;
+        }
+
+        for (const std::string &extension : pixel.requiredExtensions) {
+            if (std::find(device->extensions.begin(), device->extensions.end(), extension) == device->extensions.end()) {
+                fprintf(stderr, "plume_gles: the pixel shader needs %s, which the driver does not report.\n", extension.c_str());
+            }
+        }
+
+        appendResources(vertex, combinedSamplers, resources);
+        appendResources(pixel, combinedSamplers, resources);
+
+        device->thread.call([&]() {
+            program = loadCachedProgram(device, vertex.source, pixel.source);
+            valid = (program != 0);
+            if (!valid) {
+                GLuint vertexStage = compileStage(GL_VERTEX_SHADER, vertex.source, "vertex");
+                GLuint pixelStage = (pixelShader != nullptr) ? compileStage(GL_FRAGMENT_SHADER, pixel.source, "pixel") : 0;
+                if ((vertexStage == 0) || ((pixelShader != nullptr) && (pixelStage == 0))) {
+                    return;
+                }
+
+                program = GLCALL(glCreateProgram)();
+                GLCALL(glAttachShader)(program, vertexStage);
+                if (pixelStage != 0) {
+                    GLCALL(glAttachShader)(program, pixelStage);
+                }
+
+                if (device->armDriver) {
+                    GLCALL(glProgramParameteri)(program, 0x8257, GL_TRUE); // GL_PROGRAM_BINARY_RETRIEVABLE_HINT
+                }
+
+                valid = linkProgram(program, "graphics");
+                GLCALL(glDeleteShader)(vertexStage);
+                if (pixelStage != 0) {
+                    GLCALL(glDeleteShader)(pixelStage);
+                }
+
+                if (!valid) {
+                    return;
+                }
+
+                saveCachedProgram(device, program, vertex.source, pixel.source);
+            }
+
+            collectPushConstants(program, vertex, pushConstants);
+            collectPushConstants(program, pixel, pushConstants);
+
+            // Vertex input layout lives in a vertex array object; buffers are attached at draw time.
+            GLCALL(glGenVertexArrays)(1, &vertexArray);
+            GLCALL(glBindVertexArray)(vertexArray);
+            for (uint32_t i = 0; i < desc.inputElementsCount; i++) {
+                const RenderInputElement &element = desc.inputElements[i];
+                GLint size = 4;
+                GLenum attributeType = GL_FLOAT;
+                GLboolean normalized = GL_FALSE;
+                bool integer = false;
+                toGLVertexFormat(element.format, size, attributeType, normalized, integer);
+                GLCALL(glEnableVertexAttribArray)(element.location);
+                if (integer) {
+                    GLCALL(glVertexAttribIFormat)(element.location, size, attributeType, element.alignedByteOffset);
+                }
+                else {
+                    GLCALL(glVertexAttribFormat)(element.location, size, attributeType, normalized, element.alignedByteOffset);
+                }
+
+                GLCALL(glVertexAttribBinding)(element.location, element.slotIndex);
+            }
+
+            for (const RenderInputSlot &slot : inputSlots) {
+                GLCALL(glVertexBindingDivisor)(slot.index, (slot.classification == RenderInputSlotClassification::PER_INSTANCE_DATA) ? 1 : 0);
+            }
+
+            GLCALL(glBindVertexArray)(0);
+        });
+    }
+
+    GLPipeline::GLPipeline(GLDevice *device, const RenderComputePipelineDesc &desc) : device(device), type(Type::Compute) {
+        layout = static_cast<const GLPipelineLayout *>(desc.pipelineLayout);
+        GLBindingAllocator allocator;
+        tk64::BindingMapper mapper = [&](const tk64::ResourceLocation &location) { return allocator(location); };
+        const GLShader *computeShader = static_cast<const GLShader *>(desc.computeShader);
+        tk64::TranslatedShader compute = tk64::translateSpirv(computeShader->words.data(), computeShader->words.size(), device->shaderLanguage(), mapper);
+        if (!compute.ok) {
+            fprintf(stderr, "plume_gles: compute shader translation failed: %s\n", compute.error.c_str());
+            return;
+        }
+
+        appendResources(compute, combinedSamplers, resources);
+        if (device->profile == RenderGLProfile::ES) {
+            for (const tk64::BoundResource &resource : resources) {
+                if (resource.writeOnly && computeWords.empty()) {
+                    computeWords = computeShader->words;
+                }
+            }
+        }
+
+        device->thread.call([&]() {
+            program = loadCachedProgram(device, compute.source, std::string());
+            valid = (program != 0);
+            if (!valid) {
+                GLuint computeStage = compileStage(GL_COMPUTE_SHADER, compute.source, "compute");
+                if (computeStage == 0) {
+                    return;
+                }
+
+                program = GLCALL(glCreateProgram)();
+                GLCALL(glAttachShader)(program, computeStage);
+                if (device->armDriver) {
+                    GLCALL(glProgramParameteri)(program, 0x8257, GL_TRUE); // GL_PROGRAM_BINARY_RETRIEVABLE_HINT
+                }
+
+                valid = linkProgram(program, "compute");
+                GLCALL(glDeleteShader)(computeStage);
+                if (valid) {
+                    saveCachedProgram(device, program, compute.source, std::string());
+                }
+            }
+
+            if (valid) {
+                collectPushConstants(program, compute, pushConstants);
+            }
+        });
+    }
+
+    GLPipeline::~GLPipeline() {
+        std::vector<GLuint> programIds = { program };
+        for (const auto &variant : computeVariants) {
+            programIds.emplace_back(variant.second.program);
+        }
+
+        const GLuint vertexArrayId = vertexArray;
+        device->thread.post([programIds, vertexArrayId]() {
+            for (GLuint programId : programIds) {
+                if (programId != 0) {
+                    GLCALL(glDeleteProgram)(programId);
+                }
+            }
+
+            if (vertexArrayId != 0) {
+                GLCALL(glDeleteVertexArrays)(1, &vertexArrayId);
+            }
+        });
+    }
+
+    // GLFramebuffer
+
+    GLFramebuffer::GLFramebuffer(GLDevice *device, const RenderFramebufferDesc &desc) : device(device) {
+        colorCount = desc.colorAttachmentsCount;
+        hasDepth = (desc.depthAttachment != nullptr);
+        device->thread.call([&]() {
+            GLCALL(glGenFramebuffers)(1, &id);
+            GLCALL(glBindFramebuffer)(GL_FRAMEBUFFER, id);
+            std::vector<GLenum> drawBuffers;
+            for (uint32_t i = 0; i < desc.colorAttachmentsCount; i++) {
+                const GLTexture *texture = static_cast<const GLTexture *>(desc.colorAttachments[i]);
+                GLCALL(glFramebufferTexture2D)(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0 + i, texture->target, texture->id, 0);
+                drawBuffers.emplace_back(GL_COLOR_ATTACHMENT0 + i);
+                attachments.emplace_back(texture->id);
+                multisampled = multisampled || (texture->desc.multisampling.sampleCount > 1);
+                width = texture->desc.width;
+                height = texture->desc.height;
+            }
+
+            if (desc.depthAttachment != nullptr) {
+                const GLTexture *texture = static_cast<const GLTexture *>(desc.depthAttachment);
+                const GLenum attachment = texture->format.stencil ? GL_DEPTH_STENCIL_ATTACHMENT : GL_DEPTH_ATTACHMENT;
+                GLCALL(glFramebufferTexture2D)(GL_FRAMEBUFFER, attachment, texture->target, texture->id, 0);
+                attachments.emplace_back(texture->id);
+                width = texture->desc.width;
+                height = texture->desc.height;
+            }
+
+            if (drawBuffers.empty()) {
+                const GLenum none = GL_NONE;
+                GLCALL(glDrawBuffers)(1, &none);
+            }
+            else {
+                GLCALL(glDrawBuffers)(GLsizei(drawBuffers.size()), drawBuffers.data());
+            }
+
+            const GLenum status = GLCALL(glCheckFramebufferStatus)(GL_FRAMEBUFFER);
+            if (status != GL_FRAMEBUFFER_COMPLETE) {
+                fprintf(stderr, "plume_gles: incomplete framebuffer (0x%X).\n", status);
+            }
+
+            GLCALL(glBindFramebuffer)(GL_FRAMEBUFFER, 0);
+        });
+    }
+
+    GLFramebuffer::~GLFramebuffer() {
+        const GLuint framebufferId = id;
+        device->thread.post([framebufferId]() { GLCALL(glDeleteFramebuffers)(1, &framebufferId); });
+    }
+
+    // Binding of a pipeline's resources from the bound descriptor sets, done before each draw or dispatch.
+
+    static const GLDescriptorSet::Entry *findDescriptorEntry(const GLPipelineLayout *layout, const GLDescriptorSet *const *sets, uint32_t set, uint32_t binding,
+        uint32_t arrayIndex, const RenderSampler **immutableSampler)
+    {
+        uint32_t descriptorIndex = 0;
+        if ((layout == nullptr) || !layout->findDescriptor(set, binding, arrayIndex, descriptorIndex, immutableSampler)) {
+            return nullptr;
+        }
+
+        if ((set >= 8) || (sets[set] == nullptr) || (descriptorIndex >= sets[set]->entries.size())) {
+            return nullptr;
+        }
+
+        return &sets[set]->entries[descriptorIndex];
+    }
+
+    // The GL internal format of the image a storage image descriptor holds, or 0 when it holds none.
+    static GLenum boundImageFormat(const tk64::BoundResource &resource, const GLDescriptorSet::Entry &entry) {
+        if (resource.texelBuffer && (entry.formattedView != nullptr)) {
+            return toGL(entry.formattedView->format).internalFormat;
+        }
+        else if (!resource.texelBuffer && (entry.texture != nullptr)) {
+            return entry.texture->format.internalFormat;
+        }
+
+        return 0;
+    }
+
+    static const GLPipeline::ProgramVariant *selectComputeVariant(const GLPipeline *pipeline, const GLPipelineLayout *layout, const GLDescriptorSet *const *sets) {
+        if (pipeline->computeWords.empty()) {
+            return nullptr;
+        }
+
+        if (layout == nullptr) {
+            layout = pipeline->layout;
+        }
+
+        // The formats of the first element bound to each write-only image decide the variant.
+        std::vector<uint32_t> formats;
+        tk64::TranslationOptions options;
+        bool translatedFormats = true;
+        for (const tk64::BoundResource &resource : pipeline->resources) {
+            if ((resource.resourceClass != tk64::ResourceClass::StorageImage) || !resource.writeOnly) {
+                continue;
+            }
+
+            const GLDescriptorSet::Entry *entry = findDescriptorEntry(layout, sets, resource.set, resource.binding, 0, nullptr);
+            const GLenum bound = (entry != nullptr) ? boundImageFormat(resource, *entry) : 0;
+            tk64::TranslationOptions::ImageFormat imageFormat;
+            imageFormat.set = resource.set;
+            imageFormat.binding = resource.binding;
+            imageFormat.glFormat = (bound != 0) ? bound : resource.glImageFormat;
+            translatedFormats = translatedFormats && (imageFormat.glFormat == resource.glImageFormat);
+            formats.emplace_back(imageFormat.glFormat);
+            options.imageFormats.emplace_back(imageFormat);
+        }
+
+        if (translatedFormats) {
+            return nullptr;
+        }
+
+        auto it = pipeline->computeVariants.find(formats);
+        if (it != pipeline->computeVariants.end()) {
+            return (it->second.program != 0) ? &it->second : nullptr;
+        }
+
+        // A variant that fails to build is remembered as empty, and the pipeline's own program runs instead.
+        GLPipeline::ProgramVariant &variant = pipeline->computeVariants[formats];
+        GLBindingAllocator allocator;
+        tk64::BindingMapper mapper = [&](const tk64::ResourceLocation &location) { return allocator(location); };
+        const tk64::TranslatedShader compute = tk64::translateSpirv(pipeline->computeWords.data(), pipeline->computeWords.size(), pipeline->device->shaderLanguage(), mapper, options);
+        if (!compute.ok) {
+            fprintf(stderr, "plume_gles: compute shader variant translation failed: %s\n", compute.error.c_str());
+            return nullptr;
+        }
+
+        variant.program = loadCachedProgram(pipeline->device, compute.source, std::string());
+        if (variant.program == 0) {
+            const GLuint computeStage = compileStage(GL_COMPUTE_SHADER, compute.source, "compute variant");
+            if (computeStage == 0) {
+                return nullptr;
+            }
+
+            variant.program = GLCALL(glCreateProgram)();
+            GLCALL(glAttachShader)(variant.program, computeStage);
+            if (pipeline->device->armDriver) {
+                GLCALL(glProgramParameteri)(variant.program, 0x8257, GL_TRUE); // GL_PROGRAM_BINARY_RETRIEVABLE_HINT
+            }
+
+            const bool linked = linkProgram(variant.program, "compute variant");
+            GLCALL(glDeleteShader)(computeStage);
+            if (!linked) {
+                GLCALL(glDeleteProgram)(variant.program);
+                variant.program = 0;
+                return nullptr;
+            }
+
+            saveCachedProgram(pipeline->device, variant.program, compute.source, std::string());
+        }
+
+        collectPushConstants(variant.program, compute, variant.pushConstants);
+        return &variant;
+    }
+
+    // What is bound to the indexed targets and texture units. A driver marks a stage's whole descriptor state dirty for every
+    // bind, even of the same object, and RT64 draws hundreds of times per frame with the same resources. Only the GL thread uses
+    // it, and it is reset at the start of a replay because objects may have been deleted between replays.
+    struct GLBindCache {
+        static constexpr GLuint Unknown = GLuint(-1);
+        struct Buffer { GLuint id = Unknown; GLintptr offset = 0; GLsizeiptr size = 0; };
+        struct Texture { GLenum target = 0; GLuint id = Unknown; };
+        struct Image { GLuint id = Unknown; GLenum format = 0; };
+        Buffer storageBuffers[64];
+        Buffer uniformBuffers[128];
+        Texture textures[192];
+        GLuint samplers[192];
+        Image images[64];
+        GLuint activeUnit = Unknown;
+
+        GLBindCache() {
+            reset();
+        }
+
+        void reset() {
+            for (Buffer &buffer : storageBuffers) { buffer = Buffer(); }
+            for (Buffer &buffer : uniformBuffers) { buffer = Buffer(); }
+            for (Texture &texture : textures) { texture = Texture(); }
+            for (GLuint &sampler : samplers) { sampler = Unknown; }
+            for (Image &image : images) { image = Image(); }
+            activeUnit = Unknown;
+        }
+
+        void setActiveUnit(GLuint unit) {
+            if (activeUnit != unit) {
+                GLCALL(glActiveTexture)(GL_TEXTURE0 + unit);
+                activeUnit = unit;
+            }
+        }
+    };
+
+    static GLBindCache bindCache;
+
+    // A texel buffer view over a few zeros. libmali does not run a dispatch that has a texel buffer unit with nothing bound, which
+    // any shader with an optional texel buffer does; this keeps what such a read gives elsewhere. Binds it to the active unit.
+    static GLuint emptyTexelBufferView() {
+        static GLuint view = 0;
+        if (view == 0) {
+            static const float zeros[4] = {};
+            GLuint buffer = 0;
+            GLCALL(glGenBuffers)(1, &buffer);
+            GLCALL(glBindBuffer)(GL_COPY_WRITE_BUFFER, buffer);
+            GLCALL(glBufferData)(GL_COPY_WRITE_BUFFER, sizeof(zeros), zeros, GL_DYNAMIC_DRAW);
+            GLCALL(glGenTextures)(1, &view);
+            GLCALL(glBindTexture)(GL_TEXTURE_BUFFER, view);
+            GLCALL(glTexBuffer)(GL_TEXTURE_BUFFER, GL_RGBA32F, buffer);
+        }
+
+        return view;
+    }
+
+    static void bindResources(const GLPipeline *pipeline, const GLPipelineLayout *layout, const GLDescriptorSet *const *sets) {
+        if (layout == nullptr) {
+            layout = pipeline->layout;
+        }
+
+        auto findEntry = [&](uint32_t set, uint32_t binding, uint32_t arrayIndex, const RenderSampler **immutableSampler) {
+            return findDescriptorEntry(layout, sets, set, binding, arrayIndex, immutableSampler);
+        };
+
+        for (const tk64::BoundResource &resource : pipeline->resources) {
+            for (uint32_t a = 0; a < resource.arraySize; a++) {
+                const GLDescriptorSet::Entry *entry = findEntry(resource.set, resource.binding, a, nullptr);
+                if (entry == nullptr) {
+                    continue;
+                }
+
+                const GLuint target = resource.targetBinding + a;
+                switch (resource.resourceClass) {
+                case tk64::ResourceClass::UniformBuffer:
+                case tk64::ResourceClass::StorageBuffer:
+                case tk64::ResourceClass::ReadOnlyStorageBuffer: {
+                    if (entry->buffer == nullptr) {
+                        break;
+                    }
+
+                    const GLenum bufferTarget = (resource.resourceClass == tk64::ResourceClass::UniformBuffer) ? GL_UNIFORM_BUFFER : GL_SHADER_STORAGE_BUFFER;
+                    const uint64_t offset = uint64_t(entry->firstElement) * entry->structureStride;
+                    const uint64_t available = (entry->buffer->desc.size > offset) ? (entry->buffer->desc.size - offset) : 0;
+                    const uint64_t size = (entry->bufferSize > 0) ? std::min(entry->bufferSize, available) : available;
+                    GLBindCache::Buffer *cached = nullptr;
+                    if (resource.resourceClass == tk64::ResourceClass::UniformBuffer) {
+                        cached = (target < 128) ? &bindCache.uniformBuffers[target] : nullptr;
+                    }
+                    else {
+                        cached = (target < 64) ? &bindCache.storageBuffers[target] : nullptr;
+                    }
+
+                    if ((cached != nullptr) && (cached->id == entry->buffer->id) && (cached->offset == GLintptr(offset)) && (cached->size == GLsizeiptr(size))) {
+                        break;
+                    }
+
+                    if (cached != nullptr) {
+                        *cached = { entry->buffer->id, GLintptr(offset), GLsizeiptr(size) };
+                    }
+
+                    if ((offset == 0) && (size == entry->buffer->desc.size)) {
+                        GLCALL(glBindBufferBase)(bufferTarget, target, entry->buffer->id);
+                    }
+                    else {
+                        GLCALL(glBindBufferRange)(bufferTarget, target, entry->buffer->id, GLintptr(offset), GLsizeiptr(size));
+                    }
+
+                    break;
+                }
+                case tk64::ResourceClass::StorageImage: {
+                    GLuint textureId = 0;
+                    if (resource.texelBuffer && (entry->formattedView != nullptr)) {
+                        textureId = entry->formattedView->texture;
+                    }
+                    else if (entry->texture != nullptr) {
+                        textureId = entry->texture->id;
+                    }
+
+                    // A write-only image is bound with the format of the image itself: desktop GLSL declares it without a
+                    // format, and GLSL ES runs a variant declared with this format (selectComputeVariant).
+                    const GLenum declaredFormat = GLenum(resource.glImageFormat);
+                    const GLenum boundFormat = boundImageFormat(resource, *entry);
+                    const GLenum imageFormat = ((resource.writeOnly || (declaredFormat == 0)) && (boundFormat != 0)) ? boundFormat : declaredFormat;
+                    if (textureId != 0) {
+                        if ((target < 64) && (bindCache.images[target].id == textureId) && (bindCache.images[target].format == imageFormat)) {
+                            break;
+                        }
+
+                        if (target < 64) {
+                            bindCache.images[target] = { textureId, imageFormat };
+                        }
+
+                        GLCALL(glBindImageTexture)(target, textureId, 0, GL_FALSE, 0, GL_READ_WRITE, imageFormat);
+                    }
+
+                    break;
+                }
+                default:
+                    break;
+                }
+            }
+        }
+
+        for (const tk64::CombinedSampler &combined : pipeline->combinedSamplers) {
+            for (uint32_t a = 0; a < combined.arraySize; a++) {
+                const GLuint unit = combined.textureUnit + a;
+                const GLDescriptorSet::Entry *imageEntry = findEntry(combined.imageSet, combined.imageBinding, a, nullptr);
+                if (imageEntry == nullptr) {
+                    continue;
+                }
+
+                GLenum textureTarget = 0;
+                GLuint textureId = 0;
+                if (combined.texelBuffer) {
+                    textureTarget = GL_TEXTURE_BUFFER;
+                    textureId = (imageEntry->formattedView != nullptr) ? imageEntry->formattedView->texture : 0;
+                    if ((textureId == 0) && pipeline->device->armDriver) {
+                        bindCache.setActiveUnit(unit);
+                        textureId = emptyTexelBufferView();
+                        if (unit < 192) {
+                            bindCache.textures[unit] = { GLenum(0), GLuint(0) };
+                        }
+                    }
+                }
+                else if (imageEntry->texture != nullptr) {
+                    textureTarget = imageEntry->texture->target;
+                    textureId = imageEntry->texture->id;
+                }
+
+                if (textureTarget != 0) {
+                    const bool known = (unit < 192);
+                    if (!known || (bindCache.textures[unit].target != textureTarget) || (bindCache.textures[unit].id != textureId)) {
+                        bindCache.setActiveUnit(unit);
+
+                        // After an unbind of the sampler for another texture on this unit, libmali only recovers the texel buffer
+                        // when its binding really changes. See the sampler note below.
+                        if ((textureTarget == GL_TEXTURE_BUFFER) && pipeline->device->armDriver) {
+                            GLCALL(glBindTexture)(textureTarget, 0);
+                        }
+
+                        GLCALL(glBindTexture)(textureTarget, textureId);
+                        if (known) {
+                            bindCache.textures[unit] = { textureTarget, textureId };
+                        }
+                    }
+                }
+
+                // libmali crashes in the next dispatch that reads a texel buffer on a unit that got glBindSampler(unit, 0). Texel
+                // buffers ignore sampler state, so whatever is on the unit can stay. Other textures need the unbind: with a
+                // leftover linear sampler, an integer texture is incomplete and texelFetch reads zero.
+                if (combined.texelBuffer && pipeline->device->armDriver) {
+                    continue;
+                }
+
+                GLuint samplerId = 0;
+                if (!combined.dummySampler) {
+                    const RenderSampler *immutableSampler = nullptr;
+                    const GLDescriptorSet::Entry *samplerEntry = findEntry(combined.samplerSet, combined.samplerBinding, 0, &immutableSampler);
+                    if (immutableSampler != nullptr) {
+                        samplerId = static_cast<const GLSampler *>(immutableSampler)->id;
+                    }
+                    else if ((samplerEntry != nullptr) && (samplerEntry->sampler != nullptr)) {
+                        samplerId = samplerEntry->sampler->id;
+                    }
+                }
+
+                if ((unit >= 192) || (bindCache.samplers[unit] != samplerId)) {
+                    GLCALL(glBindSampler)(unit, samplerId);
+                    if (unit < 192) {
+                        bindCache.samplers[unit] = samplerId;
+                    }
+                }
+            }
+        }
+    }
+
+    static void uploadPushConstants(const std::vector<GLPipeline::PushConstantUniform> &pushConstants, const uint8_t *data) {
+        for (const GLPipeline::PushConstantUniform &uniform : pushConstants) {
+            const tk64::PushConstantMember &member = uniform.member;
+            const uint8_t *bytes = data + member.offset;
+            const GLsizei count = GLsizei(std::max(member.arraySize, 1U));
+            const size_t memberBytes = (((member.columns == 4) && (member.vectorSize == 4)) ? 64 : size_t(member.vectorSize) * 4) * size_t(count);
+            if (memberBytes <= sizeof(uniform.last)) {
+                if (uniform.lastValid && (std::memcmp(uniform.last, bytes, memberBytes) == 0)) {
+                    continue;
+                }
+
+                std::memcpy(uniform.last, bytes, memberBytes);
+                uniform.lastValid = true;
+            }
+
+            if ((member.columns == 4) && (member.vectorSize == 4)) {
+                GLCALL(glUniformMatrix4fv)(uniform.location, count, member.rowMajor ? GL_TRUE : GL_FALSE, reinterpret_cast<const GLfloat *>(bytes));
+                continue;
+            }
+
+            switch (member.type) {
+            case tk64::ScalarType::UInt: {
+                const GLuint *values = reinterpret_cast<const GLuint *>(bytes);
+                switch (member.vectorSize) {
+                case 1: GLCALL(glUniform1uiv)(uniform.location, count, values); break;
+                case 2: GLCALL(glUniform2uiv)(uniform.location, count, values); break;
+                case 3: GLCALL(glUniform3uiv)(uniform.location, count, values); break;
+                default: GLCALL(glUniform4uiv)(uniform.location, count, values); break;
+                }
+
+                break;
+            }
+            case tk64::ScalarType::Int: {
+                const GLint *values = reinterpret_cast<const GLint *>(bytes);
+                switch (member.vectorSize) {
+                case 1: GLCALL(glUniform1iv)(uniform.location, count, values); break;
+                case 2: GLCALL(glUniform2iv)(uniform.location, count, values); break;
+                case 3: GLCALL(glUniform3iv)(uniform.location, count, values); break;
+                default: GLCALL(glUniform4iv)(uniform.location, count, values); break;
+                }
+
+                break;
+            }
+            default: {
+                const GLfloat *values = reinterpret_cast<const GLfloat *>(bytes);
+                switch (member.vectorSize) {
+                case 1: GLCALL(glUniform1fv)(uniform.location, count, values); break;
+                case 2: GLCALL(glUniform2fv)(uniform.location, count, values); break;
+                case 3: GLCALL(glUniform3fv)(uniform.location, count, values); break;
+                default: GLCALL(glUniform4fv)(uniform.location, count, values); break;
+                }
+
+                break;
+            }
+            }
+        }
+    }
+
+    // Fixed-function state of a graphics pipeline, applied when the pipeline is bound.
+    static void applyGraphicsState(const GLPipeline *pipeline) {
+        const RenderGraphicsPipelineDesc &desc = pipeline->graphicsDesc;
+        if (desc.depthEnabled) {
+            GLCALL(glEnable)(GL_DEPTH_TEST);
+            GLCALL(glDepthFunc)(toGL(desc.depthFunction));
+        }
+        else {
+            GLCALL(glDisable)(GL_DEPTH_TEST);
+        }
+
+        GLCALL(glDepthMask)(desc.depthWriteEnabled ? GL_TRUE : GL_FALSE);
+        if (pipeline->device->depthClampSupported) {
+            if (desc.depthClipEnabled) {
+                GLCALL(glDisable)(GL_DEPTH_CLAMP);
+            }
+            else {
+                GLCALL(glEnable)(GL_DEPTH_CLAMP);
+            }
+        }
+
+        if (desc.cullMode == RenderCullMode::NONE) {
+            GLCALL(glDisable)(GL_CULL_FACE);
+        }
+        else {
+            GLCALL(glEnable)(GL_CULL_FACE);
+            GLCALL(glCullFace)((desc.cullMode == RenderCullMode::FRONT) ? GL_FRONT : GL_BACK);
+        }
+
+        // GL classifies winding with Y up, Vulkan with Y down; the same window coordinates give the opposite orientation.
+        GLCALL(glFrontFace)((desc.frontFace == RenderFrontFace::CLOCKWISE) ? GL_CCW : GL_CW);
+
+        if ((desc.depthBias != 0) || (desc.slopeScaledDepthBias != 0.0f)) {
+            GLCALL(glEnable)(GL_POLYGON_OFFSET_FILL);
+            GLCALL(glPolygonOffset)(desc.slopeScaledDepthBias, float(desc.depthBias));
+        }
+        else {
+            GLCALL(glDisable)(GL_POLYGON_OFFSET_FILL);
+        }
+
+        for (uint32_t i = 0; i < std::min(RenderGraphicsPipelineDesc::MaxRenderTargets, uint32_t(pipeline->device->maxDrawBuffers)); i++) {
+            const RenderBlendDesc &blend = desc.renderTargetBlend[i];
+            if (i >= desc.renderTargetCount) {
+                GLCALL(glDisablei)(GL_BLEND, i);
+                continue;
+            }
+
+            if (blend.blendEnabled && !((i == 0) && pipeline->blendInShader)) {
+                GLCALL(glEnablei)(GL_BLEND, i);
+                GLCALL(glBlendFuncSeparatei)(i, toGL(blend.srcBlend), toGL(blend.dstBlend), toGL(blend.srcBlendAlpha), toGL(blend.dstBlendAlpha));
+                GLCALL(glBlendEquationSeparatei)(i, toGL(blend.blendOp), toGL(blend.blendOpAlpha));
+            }
+            else {
+                GLCALL(glDisablei)(GL_BLEND, i);
+            }
+
+            const uint8_t mask = blend.renderTargetWriteMask;
+            GLCALL(glColorMaski)(i, (mask & 0x1) != 0, (mask & 0x2) != 0, (mask & 0x4) != 0, (mask & 0x8) != 0);
+        }
+    }

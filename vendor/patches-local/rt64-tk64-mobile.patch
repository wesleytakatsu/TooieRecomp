+    // GLBufferFormattedView
+
+    GLBufferFormattedView::GLBufferFormattedView(GLBuffer *buffer, RenderFormat format) : device(buffer->device), format(format) {
+        const GLuint bufferId = buffer->id;
+        device->thread.call([&]() {
+            GLCALL(glGenTextures)(1, &texture);
+            GLCALL(glBindTexture)(GL_TEXTURE_BUFFER, texture);
+            GLCALL(glTexBuffer)(GL_TEXTURE_BUFFER, toGL(format).internalFormat, bufferId);
+        });
+    }
+
+    GLBufferFormattedView::~GLBufferFormattedView() {
+        const GLuint textureId = texture;
+        device->thread.post([textureId]() { GLCALL(glDeleteTextures)(1, &textureId); });
+    }
+
+    // GLTexture
+
+    GLTexture::GLTexture(GLDevice *device, const RenderTextureDesc &desc) : device(device), desc(desc) {
+        format = toGL(desc.format);
+        const bool multisampled = (desc.multisampling.sampleCount > RenderSampleCount::COUNT_1);
+        switch (desc.dimension) {
+        case RenderTextureDimension::TEXTURE_1D:
+            target = device->textureTarget1D();
+            break;
+        case RenderTextureDimension::TEXTURE_3D:
+            target = GL_TEXTURE_3D;
+            break;
+        case RenderTextureDimension::TEXTURE_2D:
+        default:
+            target = multisampled ? GL_TEXTURE_2D_MULTISAMPLE : GL_TEXTURE_2D;
+            break;
+        }
+
+        device->thread.call([&]() {
+            const GLsizei levels = GLsizei(std::max(desc.mipLevels, 1U));
+            const GLsizei width = GLsizei(std::max(desc.width, 1U));
+            const GLsizei height = GLsizei(std::max(desc.height, 1U));
+            GLCALL(glGenTextures)(1, &id);
+            GLCALL(glBindTexture)(target, id);
+            if (target == GL_TEXTURE_1D) {
+                GLCALL(glTexStorage1D)(target, levels, format.internalFormat, width);
+            }
+            else if (target == GL_TEXTURE_3D) {
+                GLCALL(glTexStorage3D)(target, levels, format.internalFormat, width, height, GLsizei(std::max(desc.depth, 1U)));
+            }
+            else if (target == GL_TEXTURE_2D_MULTISAMPLE) {
+                GLCALL(glTexStorage2DMultisample)(target, GLsizei(desc.multisampling.sampleCount), format.internalFormat, width, height, GL_TRUE);
+            }
+            else {
+                GLCALL(glTexStorage2D)(target, levels, format.internalFormat, width, height);
+            }
+
+            if (target != GL_TEXTURE_2D_MULTISAMPLE) {
+                GLCALL(glTexParameteri)(target, GL_TEXTURE_BASE_LEVEL, 0);
+                GLCALL(glTexParameteri)(target, GL_TEXTURE_MAX_LEVEL, levels - 1);
+                GLCALL(glTexParameteri)(target, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+                GLCALL(glTexParameteri)(target, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            }
+        });
+    }
+
+    GLTexture::~GLTexture() {
+        const GLuint textureId = id;
+        device->thread.post([textureId]() { GLCALL(glDeleteTextures)(1, &textureId); });
+    }

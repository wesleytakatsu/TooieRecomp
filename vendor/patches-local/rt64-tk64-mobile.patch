+    void GLPlatform::windowSize(uint32_t &width, uint32_t &height) const {
+        RECT rect = {};
+        GetClientRect(hwnd, &rect);
+        width = uint32_t(std::max<LONG>(rect.right - rect.left, 0));
+        height = uint32_t(std::max<LONG>(rect.bottom - rect.top, 0));

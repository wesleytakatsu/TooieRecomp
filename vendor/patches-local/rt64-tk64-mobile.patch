+            wl_egl_window_create = (PFN_wl_egl_window_create)(loadWayland("wl_egl_window_create"));
+            wl_egl_window_destroy = (PFN_wl_egl_window_destroy)(loadWayland("wl_egl_window_destroy"));
+            wl_egl_window_resize = (PFN_wl_egl_window_resize)(loadWayland("wl_egl_window_resize"));

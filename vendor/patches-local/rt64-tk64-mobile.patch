+    // GLBuffer
+
+    GLBuffer::GLBuffer(GLDevice *device, const RenderBufferDesc &desc) : device(device), desc(desc) {
+        if ((desc.heapType == RenderHeapType::UPLOAD) || (desc.heapType == RenderHeapType::READBACK) || (desc.heapType == RenderHeapType::GPU_UPLOAD)) {
+            shadow.resize(desc.size, 0);
+        }
+
+        // An upload buffer without usage flags can only be the source of a copy. It stays in CPU memory: a GL buffer in the
+        // middle costs a synchronous creation and a driver-side copy per upload, which dominate frame time on mobile drivers.
+        if ((desc.heapType == RenderHeapType::UPLOAD) && (desc.flags == RenderBufferFlag::NONE)) {
+            replayShadow = std::make_shared<std::vector<uint8_t>>(desc.size, uint8_t(0));
+            return;
+        }
+
+        device->thread.call([this]() {
+            GLCALL(glGenBuffers)(1, &id);
+            GLCALL(glBindBuffer)(GL_COPY_WRITE_BUFFER, id);
+            GLCALL(glBufferData)(GL_COPY_WRITE_BUFFER, GLsizeiptr(std::max(this->desc.size, uint64_t(1))), nullptr, (this->desc.heapType == RenderHeapType::READBACK) ? GL_STREAM_READ : GL_DYNAMIC_DRAW);
+        });
+    }
+
+    GLBuffer::~GLBuffer() {
+        if (replayShadow != nullptr) {
+            return;
+        }
+
+        const GLuint bufferId = id;
+        device->thread.post([bufferId]() { GLCALL(glDeleteBuffers)(1, &bufferId); });
+    }
+
+    void *GLBuffer::map(uint32_t subresource, const RenderRange *readRange) {
+        assert(!shadow.empty() && "Only upload and readback buffers can be mapped.");
+        return shadow.data();
+    }
+
+    void GLBuffer::unmap(uint32_t subresource, const RenderRange *writtenRange) {
+        if ((desc.heapType != RenderHeapType::UPLOAD) && (desc.heapType != RenderHeapType::GPU_UPLOAD)) {
+            return;
+        }
+
+        // The written bytes are copied now, so later writes to the shadow cannot race with the GL thread.
+        uint64_t begin = 0;
+        uint64_t end = desc.size;
+        if ((writtenRange != nullptr) && (writtenRange->end > writtenRange->begin)) {
+            begin = writtenRange->begin;
+            end = std::min(writtenRange->end, desc.size);
+        }
+
+        if (end <= begin) {
+            return;
+        }
+
+        std::shared_ptr<std::vector<uint8_t>> bytes = std::make_shared<std::vector<uint8_t>>(shadow.begin() + begin, shadow.begin() + end);
+        if (replayShadow != nullptr) {
+            std::shared_ptr<std::vector<uint8_t>> destination = replayShadow;
+            device->thread.post([destination, begin, bytes]() {
+                std::memcpy(destination->data() + begin, bytes->data(), bytes->size());
+            });
+
+            return;
+        }
+
+        const GLuint bufferId = id;
+        device->thread.post([bufferId, begin, bytes]() {
+            GLCALL(glBindBuffer)(GL_COPY_WRITE_BUFFER, bufferId);
+            GLCALL(glBufferSubData)(GL_COPY_WRITE_BUFFER, GLintptr(begin), GLsizeiptr(bytes->size()), bytes->data());
+        });
+    }

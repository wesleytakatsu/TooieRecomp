+    // TK64-DIAG-TEMP: time per GL task and per recorded command, TK64_GL_PROFILE=1.
+    struct GLProf {
+        struct Bucket { uint64_t ns = 0; uint64_t count = 0; };
+        static std::map<std::string, Bucket> &buckets() { static std::map<std::string, Bucket> b; return b; }
+        static bool enabled() { static const bool e = std::getenv("TK64_GL_PROFILE") != nullptr; return e; }
+        static uint64_t now() { return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+        struct Scope {
+            const char *name; uint64_t t0;
+            Scope(const char *name) : name(name), t0(enabled() ? now() : 0) { }
+            ~Scope() {
+                if (!enabled()) { return; }
+                static uint64_t last = now();
+                const uint64_t t1 = now();
+                Bucket &bucket = buckets()[name];
+                bucket.ns += t1 - t0;
+                bucket.count++;
+                if ((t1 - last) > 5000000000ull) {
+                    const double seconds = double(t1 - last) / 1e9;
+                    std::vector<std::pair<std::string, Bucket>> sorted(buckets().begin(), buckets().end());
+                    std::sort(sorted.begin(), sorted.end(), [](const auto &x, const auto &y) { return x.second.ns > y.second.ns; });
+                    fprintf(stderr, "[gl-prof] window %.1f s\n", seconds);
+                    for (size_t i = 0; i < std::min<size_t>(sorted.size(), 26); i++) {
+                        fprintf(stderr, "[gl-prof] %6.1f ms/s %7.1f calls/s  %s\n", double(sorted[i].second.ns) / 1e6 / seconds, double(sorted[i].second.count) / seconds, sorted[i].first.c_str());
+                    }
+                    buckets().clear();
+                    last = t1;
+                }
+            }
+        };
+    };
+
+    struct GLThread {
+        std::thread thread;
+        std::mutex mutex;
+        std::condition_variable condition;
+        std::deque<std::function<void()>> tasks;
+        std::thread::id threadId;
+        bool stopping = false;
+
+        void start() {
+            thread = std::thread([this]() {
+                threadId = std::this_thread::get_id();
+                loop();
+            });
+        }
+
+        void loop() {
+            while (true) {
+                std::function<void()> task;
+                {
+                    std::unique_lock<std::mutex> lock(mutex);
+                    condition.wait(lock, [this]() { return stopping || !tasks.empty(); });
+                    if (tasks.empty()) {
+                        return;
+                    }
+
+                    task = std::move(tasks.front());
+                    tasks.pop_front();
+                }
+
+                { GLProf::Scope prof(task.target_type().name()); task(); }
+            }
+        }
+
+        bool onThread() const {
+            return std::this_thread::get_id() == threadId;
+        }
+
+        void post(std::function<void()> task) {
+            if (onThread()) {
+                task();
+                return;
+            }
+
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                tasks.emplace_back(std::move(task));
+            }
+
+            condition.notify_one();
+        }
+
+        void call(const std::function<void()> &task) {
+            if (onThread()) {
+                task();
+                return;
+            }
+
+            std::mutex doneMutex;
+            std::condition_variable doneCondition;
+            bool done = false;
+            post([&]() {
+                { GLProf::Scope prof(task.target_type().name()); task(); }
+                std::unique_lock<std::mutex> lock(doneMutex);
+                done = true;
+                doneCondition.notify_one();
+            });
+
+            std::unique_lock<std::mutex> lock(doneMutex);
+            doneCondition.wait(lock, [&]() { return done; });
+        }
+
+        void stop() {
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                stopping = true;
+            }
+
+            condition.notify_one();
+            if (thread.joinable()) {
+                thread.join();
+            }
+        }
+    };

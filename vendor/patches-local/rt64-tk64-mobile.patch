+    void GLCommandList::setViewports(const RenderViewport *viewports, uint32_t count) {
+        if ((viewports == nullptr) || (count == 0)) {
+            return;
+        }
+
+        const RenderViewport viewport = viewports[0];
+        recordViewportSet = true;
+        record([viewport](GLReplayState &) {
+            GLCALL(glViewport)(GLint(viewport.x), GLint(viewport.y), GLsizei(viewport.width), GLsizei(viewport.height));
+            GLCALL(glDepthRangef)(viewport.minDepth, viewport.maxDepth);
+        });
+    }
+
+    void GLCommandList::setScissors(const RenderRect *scissorRects, uint32_t count) {
+        if ((scissorRects == nullptr) || (count == 0)) {
+            return;
+        }
+
+        const RenderRect rect = scissorRects[0];
+        recordScissorSet = true;
+        record([rect](GLReplayState &state) {
+            state.scissor = rect;
+            state.scissorSet = true;
+            GLCALL(glScissor)(rect.left, rect.top, std::max(rect.right - rect.left, 0), std::max(rect.bottom - rect.top, 0));
+        });
+    }
+
+    void GLCommandList::setFramebuffer(const RenderFramebuffer *framebuffer) {
+        const GLFramebuffer *glFramebuffer = static_cast<const GLFramebuffer *>(framebuffer);
+        // As in D3D12 and Vulkan, binding a framebuffer keeps the viewport and scissor: RT64 sets the scissor only when it
+        // changes, also across its switches between the depth-write and depth-read framebuffers of one pass (resetting it
+        // here let the 3D scene draw over the letterbox bars of cutscenes). Only a list that has not set them yet
+        // starts with ones covering the framebuffer, because the GL context carries them over from other lists.
+        const bool resetViewport = !recordViewportSet;
+        const bool resetScissor = !recordScissorSet;
+        const bool depthFetch = device->depthFetchSupported;
+        record([glFramebuffer, resetViewport, resetScissor, depthFetch](GLReplayState &state) {
+            // RT64 switches between a depth-write and a depth-read framebuffer of the same textures around decals. They are the same
+            // thing in GL, and binding the other one ends the pass on libmali: 350 us, against 20 us for a draw, and reloading both targets.
+            // Decals only need that pass ended when they read the depth from a texture.
+            const bool sameTargets = depthFetch && (state.framebuffer != nullptr) && (glFramebuffer != nullptr) && !glFramebuffer->multisampled && (state.framebuffer->attachments == glFramebuffer->attachments);
+            state.framebuffer = glFramebuffer;
+            if (!sameTargets) {
+                GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, (glFramebuffer != nullptr) ? glFramebuffer->id : 0);
+            }
+
+            if (glFramebuffer != nullptr) {
+                if (resetViewport) {
+                    GLCALL(glViewport)(0, 0, GLsizei(glFramebuffer->width), GLsizei(glFramebuffer->height));
+                }
+
+                if (resetScissor) {
+                    GLCALL(glScissor)(0, 0, GLsizei(glFramebuffer->width), GLsizei(glFramebuffer->height));
+                    state.scissor = RenderRect(0, 0, int32_t(glFramebuffer->width), int32_t(glFramebuffer->height));
+                    state.scissorSet = true;
+                }
+            }
+        });
+    }
+
+    void GLCommandList::setDepthBias(float depthBias, float depthBiasClamp, float slopeScaledDepthBias) {
+        record([=](GLReplayState &) {
+            GLCALL(glEnable)(GL_POLYGON_OFFSET_FILL);
+            GLCALL(glPolygonOffset)(slopeScaledDepthBias, depthBias);
+        });
+    }
+
+    // Clears ignore the pipeline's write masks and the current scissor, like D3D's and Vulkan's clear commands.
+    template <typename ClearFunction>
+    static void clearWithRects(GLReplayState &state, const std::vector<RenderRect> &rects, ClearFunction clear) {
+        const uint32_t width = (state.framebuffer != nullptr) ? state.framebuffer->width : 0;
+        const uint32_t height = (state.framebuffer != nullptr) ? state.framebuffer->height : 0;
+        if (rects.empty()) {
+            GLCALL(glScissor)(0, 0, GLsizei(width), GLsizei(height));
+            clear();
+        }
+        else {
+            for (const RenderRect &rect : rects) {
+                GLCALL(glScissor)(rect.left, rect.top, std::max(rect.right - rect.left, 0), std::max(rect.bottom - rect.top, 0));
+                clear();
+            }
+        }
+
+        const RenderRect &scissor = state.scissor;
+        GLCALL(glScissor)(scissor.left, scissor.top, std::max(scissor.right - scissor.left, 0), std::max(scissor.bottom - scissor.top, 0));
+    }
+
+    void GLCommandList::clearColor(uint32_t attachmentIndex, RenderColor colorValue, const RenderRect *clearRects, uint32_t clearRectsCount) {
+        std::vector<RenderRect> rects;
+        if (clearRects != nullptr) {
+            rects.assign(clearRects, clearRects + clearRectsCount);
+        }
+
+        record([=](GLReplayState &state) {
+            GLCALL(glColorMaski)(attachmentIndex, GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+            clearWithRects(state, rects, [&]() { GLCALL(glClearBufferfv)(GL_COLOR, GLint(attachmentIndex), colorValue.rgba); });
+            if (state.pipeline != nullptr) {
+                state.pipeline = nullptr;
+            }
+        });
+    }
+
+    void GLCommandList::clearDepthStencil(bool clearDepth, bool clearStencil, float depthValue, uint32_t stencilValue, const RenderRect *clearRects, uint32_t clearRectsCount) {
+        std::vector<RenderRect> rects;
+        if (clearRects != nullptr) {
+            rects.assign(clearRects, clearRects + clearRectsCount);
+        }
+
+        record([=](GLReplayState &state) {
+            depthWritesPending = true;
+            GLCALL(glDepthMask)(GL_TRUE);
+            clearWithRects(state, rects, [&]() {
+                if (clearDepth && clearStencil) {
+                    GLCALL(glClearBufferfi)(GL_DEPTH_STENCIL, 0, depthValue, GLint(stencilValue));
+                }
+                else if (clearDepth) {
+                    GLCALL(glClearBufferfv)(GL_DEPTH, 0, &depthValue);
+                }
+                else if (clearStencil) {
+                    const GLint stencil = GLint(stencilValue);
+                    GLCALL(glClearBufferiv)(GL_STENCIL, 0, &stencil);
+                }
+            });
+
+            // The pipeline's depth write state is restored when it is bound again.
+            state.pipeline = nullptr;
+        });
+    }
+
+    // Copies into a readback buffer refresh its CPU copy right away, so map() after the fence sees the data.
+    static void refreshReadback(const GLBuffer *buffer) {
+        if ((buffer->desc.heapType != RenderHeapType::READBACK) || buffer->shadow.empty()) {
+            return;
+        }
+
+        GLCALL(glBindBuffer)(GL_COPY_READ_BUFFER, buffer->id);
+        const void *data = GLCALL(glMapBufferRange)(GL_COPY_READ_BUFFER, 0, GLsizeiptr(buffer->desc.size), GL_MAP_READ_BIT);
+        if (data != nullptr) {
+            memcpy(const_cast<GLBuffer *>(buffer)->shadow.data(), data, size_t(buffer->desc.size));
+            GLCALL(glUnmapBuffer)(GL_COPY_READ_BUFFER);
+        }
+    }
+
+    // See tk64_depth_ram.h. The same conversion as RT64's FbWriteDepthCS, on a unit and with state the backend then asks for again.
+    void glesReadDepth16(RenderTexture *texture, uint32_t address, uint32_t width, uint32_t height, float scaleX, float scaleY) {
+        struct Read {
+            GLuint buffer = 0;
+            size_t bufferSize = 0;
+            GLsync fence = nullptr;
+            uint32_t address = 0;
+            uint32_t width = 0;
+            uint32_t height = 0;
+        };
+
+        const GLTexture *glTexture = static_cast<const GLTexture *>(texture);
+        glTexture->device->thread.call([&]() {
+            static const uint32_t ReadCount = 3;
+            static Read reads[ReadCount];
+            static uint32_t oldestRead = 0;
+            static uint32_t pendingReads = 0;
+            static Read *mappedRead = nullptr;
+            static GLuint programs[2] = {};
+            static bool programFailed = false;
+
+            // Fences signal in order, so the last one found signaled is the newest depth.
+            Read *finished = nullptr;
+            while (pendingReads > 0) {
+                Read &read = reads[oldestRead];
+                const GLenum status = GLCALL(glClientWaitSync)(read.fence, 0, 0);
+                if ((status != GL_ALREADY_SIGNALED) && (status != GL_CONDITION_SATISFIED)) {
+                    break;
+                }
+
+                GLCALL(glDeleteSync)(read.fence);
+                read.fence = nullptr;
+                finished = &read;
+                oldestRead = (oldestRead + 1) % ReadCount;
+                pendingReads--;
+            }
+
+            if (finished != nullptr) {
+                // Never wait for a thread that is reading the last depth: this one is skipped, and a newer one follows.
+                tk64::depthram::Frame &frame = tk64::depthram::frame();
+                const std::unique_lock<std::mutex> lock(frame.mutex, std::try_to_lock);
+                if (lock.owns_lock()) {
+                    if (mappedRead != nullptr) {
+                        GLCALL(glBindBuffer)(GL_SHADER_STORAGE_BUFFER, mappedRead->buffer);
+                        GLCALL(glUnmapBuffer)(GL_SHADER_STORAGE_BUFFER);
+                    }
+
+                    GLCALL(glBindBuffer)(GL_SHADER_STORAGE_BUFFER, finished->buffer);
+                    frame.mapped = static_cast<const uint8_t *>(GLCALL(glMapBufferRange)(GL_SHADER_STORAGE_BUFFER, 0, GLsizeiptr(finished->bufferSize), GL_MAP_READ_BIT));
+                    frame.address = finished->address;
+                    frame.width = finished->width;
+                    frame.height = finished->height;
+                    frame.rowBytes = size_t((finished->width + 1) / 2) * sizeof(uint32_t);
+                    frame.fresh = (frame.mapped != nullptr);
+                    mappedRead = (frame.mapped != nullptr) ? finished : nullptr;
+                }
+            }
+
+            // With nothing pending, a failed try_lock above can leave the mapped buffer next. Only a finished read remaps it, so go past it.
+            if ((pendingReads == 0) && (&reads[oldestRead] == mappedRead)) {
+                oldestRead = (oldestRead + 1) % ReadCount;
+            }
+
+            // The GPU is behind by the whole ring, or the next buffer is the mapped one: this frame's depth is skipped, the game keeps seeing the last one.
+            Read &read = reads[(oldestRead + pendingReads) % ReadCount];
+            if ((pendingReads == ReadCount) || (&read == mappedRead)) {
+                return;
+            }
+
+            if (programFailed) {
+                return;
+            }
+
+            const bool multisampled = (glTexture->target == GL_TEXTURE_2D_MULTISAMPLE);
+            GLuint &program = programs[multisampled ? 1 : 0];
+            if (program == 0) {
+                const std::string source = std::string(
+                    "#version 310 es\n"
+                    "precision highp float;\n"
+                    "precision highp int;\n"
+                    "layout(local_size_x = 16, local_size_y = 16) in;\n"
+                    "layout(binding = 40) uniform highp ") + (multisampled ? "sampler2DMS" : "sampler2D") + " gDepth;\n"
+                    "layout(std430, binding = 0) writeonly buffer Output { uint values[]; };\n"
+                    "layout(location = 0) uniform uvec2 size;\n"
+                    "layout(location = 1) uniform vec2 scale;\n"
+                    "uint depthAt(uvec2 c) {\n"
+                    "    ivec2 texel = min(ivec2((vec2(c) + 0.5) * scale), textureSize(gDepth" + (multisampled ? "" : ", 0") + ") - 1);\n"
+                    "    float z = clamp(texelFetch(gDepth, texel, 0).r, 0.0, 1.0);\n"
+                    "    uint zFixed = uint(round(z * 262143.0));\n"
+                    "    uint shifted = zFixed << 14;\n"
+                    "    uint exponent = uint(clamp(31 - findMSB(~shifted), 0, 7));\n"
+                    "    uint mantissa = zFixed >> (6u - min(6u, exponent));\n"
+                    "    return (exponent << 13) | ((mantissa << 2) & 0x1FFCu);\n"
+                    "}\n"
+                    "void main() {\n"
+                    "    uvec2 word = gl_GlobalInvocationID.xy;\n"
+                    "    uint rowWords = (size.x + 1u) / 2u;\n"
+                    "    if ((word.x >= rowWords) || (word.y >= size.y)) { return; }\n"
+                    "    uvec2 c = uvec2(word.x * 2u, word.y);\n"
+                    "    values[word.y * rowWords + word.x] = (depthAt(c) << 16) | depthAt(c + uvec2(1u, 0u));\n"
+                    "}\n";
+                const GLuint shader = compileStage(GL_COMPUTE_SHADER, source.c_str(), "depth to RAM");
+                if (shader == 0) {
+                    programFailed = true;
+                    return;
+                }
+
+                program = GLCALL(glCreateProgram)();
+                GLCALL(glAttachShader)(program, shader);
+                programFailed = !linkProgram(program, "depth to RAM");
+                GLCALL(glDeleteShader)(shader);
+                if (programFailed) {
+                    return;
+                }
+            }
+
+            const uint32_t rowWords = (width + 1) / 2;
+            const size_t bytes = size_t(rowWords) * size_t(height) * sizeof(uint32_t);
+            if (read.buffer == 0) {
+                GLCALL(glGenBuffers)(1, &read.buffer);
+            }
+
+            GLCALL(glBindBuffer)(GL_SHADER_STORAGE_BUFFER, read.buffer);
+            if (read.bufferSize != bytes) {
+                GLCALL(glBufferData)(GL_SHADER_STORAGE_BUFFER, GLsizeiptr(bytes), nullptr, GL_STREAM_READ);
+                read.bufferSize = bytes;
+            }
+
+            // The depth is still in the driver's pass.
+            GLint boundFramebuffer = 0;
+            GLCALL(glGetIntegerv)(0x8CA6, &boundFramebuffer); // GL_DRAW_FRAMEBUFFER_BINDING
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, 0);
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, GLuint(boundFramebuffer));
+            depthWritesPending = false;
+            if (!glTexture->device->armDriver) {
+                GLCALL(glFlush)();
+            }
+
+            const GLuint unit = 40;
+            bindCache.setActiveUnit(unit);
+            GLCALL(glBindTexture)(glTexture->target, glTexture->id);
+            bindCache.textures[unit] = { glTexture->target, glTexture->id };
+            GLCALL(glBindSampler)(unit, 0);
+            bindCache.samplers[unit] = 0;
+            if (!multisampled) {
+                GLCALL(glTexParameteri)(glTexture->target, 0x2801, 0x2600); // GL_TEXTURE_MIN_FILTER, GL_NEAREST
+            }
+
+            GLCALL(glBindBufferBase)(GL_SHADER_STORAGE_BUFFER, 0, read.buffer);
+            bindCache.storageBuffers[0] = GLBindCache::Buffer();
+            GLCALL(glUseProgram)(program);
+            const GLuint sizeValue[2] = { width, height };
+            const float scaleValue[2] = { scaleX, scaleY };
+            GLCALL(glUniform2uiv)(0, 1, sizeValue);
+            GLCALL(glUniform2fv)(1, 1, scaleValue);
+            GLCALL(glDispatchCompute)((rowWords + 15) / 16, (height + 15) / 16, 1);
+            GLCALL(glMemoryBarrier)(GL_BUFFER_UPDATE_BARRIER_BIT);
+
+            // A fence only signals once the driver has sent the work to the GPU.
+            read.fence = GLCALL(glFenceSync)(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+            GLCALL(glFlush)();
+            read.address = address;
+            read.width = width;
+            read.height = height;
+            pendingReads++;
+        });
+    }
+
+    void GLCommandList::copyBufferRegion(RenderBufferReference dstBuffer, RenderBufferReference srcBuffer, uint64_t size) {
+        const GLBuffer *dst = static_cast<const GLBuffer *>(dstBuffer.ref);
+        const GLBuffer *src = static_cast<const GLBuffer *>(srcBuffer.ref);
+        const uint64_t dstOffset = dstBuffer.offset;
+        const uint64_t srcOffset = srcBuffer.offset;
+        const std::shared_ptr<std::vector<uint8_t>> srcShadow = src->replayShadow;
+        record([=](GLReplayState &state) {
+            if (dst->desc.flags & RenderBufferFlag::INDEX) {
+                if (srcShadow != nullptr) {
+                    dst->indexCopy.resize(size_t(dst->desc.size));
+                    std::memcpy(dst->indexCopy.data() + dstOffset, srcShadow->data() + srcOffset, size_t(size));
+                }
+                else {
+                    dst->indexCopy.clear();
+                }
+            }
+
+            if (srcShadow != nullptr) {
+                // A buffer rewritten from its start every frame may still be in use by the GPU, since a fence here only means
+                // the commands were replayed, and writing into it would make the driver wait for the GPU: up to a whole frame on
+                // a weak one. New storage needs no wait. The rest of its contents is in the staging buffer, at the same offsets.
+                const bool recentUpload = (dst->lastUploadFrame != UINT64_MAX) && ((glFrameCounter - dst->lastUploadFrame) < 3);
+                const bool newStorage = recentUpload && (dstOffset == 0) && (srcOffset == 0) && (src->desc.size == dst->desc.size) && ((dst->desc.flags & RenderBufferFlag::UNORDERED_ACCESS) == 0);
+                dst->lastUploadFrame = glFrameCounter;
+                dst->uploadEnd = std::max(dst->uploadEnd, dstOffset + size);
+                if (newStorage) {
+                    GLCALL(glBindBuffer)(GL_COPY_WRITE_BUFFER, dst->id);
+                    GLCALL(glBufferData)(GL_COPY_WRITE_BUFFER, GLsizeiptr(dst->desc.size), nullptr, GL_DYNAMIC_DRAW);
+                    GLCALL(glBufferSubData)(GL_COPY_WRITE_BUFFER, 0, GLsizeiptr(dst->uploadEnd), srcShadow->data());
+                    return;
+                }
+
+                // With a batch still pending that uses the buffer, drivers copy the whole buffer to a new allocation for each
+                // upload (Panfrost does). Handing them the pending work first makes the upload a plain write.
+                if (!state.uploadFlushed) {
+                    { GLProf::Scope prof("upload flush"); GLCALL(glFlush)(); }
+                    state.uploadFlushed = true;
+                }
+
+                GLCALL(glBindBuffer)(GL_COPY_WRITE_BUFFER, dst->id);
+                const char *uploadLabel = (size < 1024) ? "upload <1K" : (size < 16384) ? "upload <16K" : (size < 65536) ? "upload <64K" : (size < 262144) ? "upload <256K" : (size < 1048576) ? "upload <1M" : "upload >=1M";
+                const char *dstLabel = (dst->desc.size == size) ? "whole-dst" : ((dst->desc.size * 3 / 4) <= size) ? "most-dst" : "part-dst";
+                GLProf::Scope prof2(dstLabel);
+                GLProf::Scope prof(uploadLabel);
+                GLCALL(glBufferSubData)(GL_COPY_WRITE_BUFFER, GLintptr(dstOffset), GLsizeiptr(size), srcShadow->data() + srcOffset);
+                refreshReadback(dst);
+                return;
+            }
+
+            GLCALL(glBindBuffer)(GL_COPY_READ_BUFFER, src->id);
+            GLCALL(glBindBuffer)(GL_COPY_WRITE_BUFFER, dst->id);
+            { GLProf::Scope prof((src->desc.heapType == RenderHeapType::UPLOAD) ? "gpucopy from upload-with-flags" : (src->desc.heapType == RenderHeapType::DEFAULT) ? "gpucopy from default" : "gpucopy from other");
+            GLCALL(glCopyBufferSubData)(GL_COPY_READ_BUFFER, GL_COPY_WRITE_BUFFER, GLintptr(srcOffset), GLintptr(dstOffset), GLsizeiptr(size)); }
+            { GLProf::Scope prof("refreshReadback"); refreshReadback(dst); }
+        });
+    }
+
+    void GLCommandList::copyBuffer(const RenderBuffer *dstBuffer, const RenderBuffer *srcBuffer) {
+        const GLBuffer *dst = static_cast<const GLBuffer *>(dstBuffer);
+        const GLBuffer *src = static_cast<const GLBuffer *>(srcBuffer);
+        copyBufferRegion(RenderBufferReference(dst), RenderBufferReference(src), std::min(dst->desc.size, src->desc.size));
+    }
+
+    void GLCommandList::copyTextureRegion(const RenderTextureCopyLocation &dstLocation, const RenderTextureCopyLocation &srcLocation, uint32_t dstX, uint32_t dstY, uint32_t dstZ, const RenderBox *srcBox) {
+        const RenderTextureCopyLocation dst = dstLocation;
+        const RenderTextureCopyLocation src = srcLocation;
+        const bool hasBox = (srcBox != nullptr);
+        const RenderBox box = hasBox ? *srcBox : RenderBox();
+        record([=](GLReplayState &state) {
+            if ((dst.type == RenderTextureCopyType::SUBRESOURCE) && (src.type == RenderTextureCopyType::PLACED_FOOTPRINT)) {
+                // Buffer to texture.
+                const GLTexture *texture = static_cast<const GLTexture *>(dst.texture);
+                const GLBuffer *buffer = static_cast<const GLBuffer *>(src.buffer);
+                const uint32_t width = hasBox ? uint32_t(box.right - box.left) : src.placedFootprint.width;
+                const uint32_t height = hasBox ? uint32_t(box.bottom - box.top) : src.placedFootprint.height;
+                const uint32_t depth = hasBox ? uint32_t(box.back - box.front) : src.placedFootprint.depth;
+                const uint32_t blockWidth = RenderFormatBlockWidth(src.placedFootprint.format);
+                const uint64_t offset = src.placedFootprint.offset + (hasBox ? (uint64_t(box.top) * src.placedFootprint.rowWidth + box.left) * RenderFormatSize(src.placedFootprint.format) / blockWidth : 0);
+                GLCALL(glBindBuffer)(GL_PIXEL_UNPACK_BUFFER, (buffer->replayShadow != nullptr) ? 0 : buffer->id);
+                GLCALL(glPixelStorei)(GL_UNPACK_ALIGNMENT, 1);
+                GLCALL(glPixelStorei)(GL_UNPACK_ROW_LENGTH, GLint(src.placedFootprint.rowWidth));
+                GLCALL(glPixelStorei)(GL_UNPACK_IMAGE_HEIGHT, GLint(src.placedFootprint.height));
+                bindCache.reset();
+                GLCALL(glBindTexture)(texture->target, texture->id);
+                const void *pixels = (buffer->replayShadow != nullptr) ? static_cast<const void *>(buffer->replayShadow->data() + offset) : reinterpret_cast<const void *>(uintptr_t(offset));
+                const GLint level = GLint(dst.subresource.mipLevel);
+                if (texture->target == GL_TEXTURE_1D) {
+                    GLCALL(glTexSubImage1D)(texture->target, level, GLint(dstX), GLsizei(width), texture->format.format, texture->format.type, pixels);
+                }
+                else if (texture->target == GL_TEXTURE_3D) {
+                    GLCALL(glTexSubImage3D)(texture->target, level, GLint(dstX), GLint(dstY), GLint(dstZ), GLsizei(width), GLsizei(height), GLsizei(depth), texture->format.format, texture->format.type, pixels);
+                }
+                else {
+                    GLCALL(glTexSubImage2D)(texture->target, level, GLint(dstX), GLint(dstY), GLsizei(width), GLsizei(height), texture->format.format, texture->format.type, pixels);
+                }
+
+                GLCALL(glPixelStorei)(GL_UNPACK_ROW_LENGTH, 0);
+                GLCALL(glPixelStorei)(GL_UNPACK_IMAGE_HEIGHT, 0);
+                GLCALL(glBindBuffer)(GL_PIXEL_UNPACK_BUFFER, 0);
+            }
+            else if ((dst.type == RenderTextureCopyType::PLACED_FOOTPRINT) && (src.type == RenderTextureCopyType::SUBRESOURCE)) {
+                // Texture to buffer, through a read framebuffer.
+                const GLTexture *texture = static_cast<const GLTexture *>(src.texture);
+                const GLBuffer *buffer = static_cast<const GLBuffer *>(dst.buffer);
+                const int32_t x = hasBox ? box.left : 0;
+                const int32_t y = hasBox ? box.top : 0;
+                const uint32_t width = hasBox ? uint32_t(box.right - box.left) : dst.placedFootprint.width;
+                const uint32_t height = hasBox ? uint32_t(box.bottom - box.top) : dst.placedFootprint.height;
+                GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, texture->device->scratchFramebuffers[0]);
+                GLCALL(glFramebufferTexture2D)(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, texture->target, texture->id, GLint(src.subresource.mipLevel));
+                GLCALL(glReadBuffer)(GL_COLOR_ATTACHMENT0);
+                GLCALL(glBindBuffer)(GL_PIXEL_PACK_BUFFER, buffer->id);
+                GLCALL(glPixelStorei)(GL_PACK_ALIGNMENT, 1);
+                GLCALL(glPixelStorei)(GL_PACK_ROW_LENGTH, GLint(dst.placedFootprint.rowWidth));
+                GLCALL(glReadPixels)(x, y, GLsizei(width), GLsizei(height), texture->format.format, texture->format.type, reinterpret_cast<void *>(uintptr_t(dst.placedFootprint.offset)));
+                GLCALL(glPixelStorei)(GL_PACK_ROW_LENGTH, 0);
+                GLCALL(glBindBuffer)(GL_PIXEL_PACK_BUFFER, 0);
+                GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, 0);
+                refreshReadback(buffer);
+            }
+            else if ((dst.type == RenderTextureCopyType::SUBRESOURCE) && (src.type == RenderTextureCopyType::SUBRESOURCE)) {
+                const GLTexture *dstTexture = static_cast<const GLTexture *>(dst.texture);
+                const GLTexture *srcTexture = static_cast<const GLTexture *>(src.texture);
+                const int32_t x = hasBox ? box.left : 0;
+                const int32_t y = hasBox ? box.top : 0;
+                const int32_t z = hasBox ? box.front : 0;
+                const uint32_t width = hasBox ? uint32_t(box.right - box.left) : srcTexture->desc.width;
+                const uint32_t height = hasBox ? uint32_t(box.bottom - box.top) : std::max(srcTexture->desc.height, 1U);
+                const uint32_t depth = hasBox ? uint32_t(box.back - box.front) : 1;
+                GLCALL(glCopyImageSubData)(srcTexture->id, srcTexture->target, GLint(src.subresource.mipLevel), x, y, z,
+                    dstTexture->id, dstTexture->target, GLint(dst.subresource.mipLevel), GLint(dstX), GLint(dstY), GLint(dstZ), GLsizei(width), GLsizei(height), GLsizei(depth));
+            }
+        });
+    }
+
+    void GLCommandList::copyTexture(const RenderTexture *dstTexture, const RenderTexture *srcTexture) {
+        copyTextureRegion(RenderTextureCopyLocation::Subresource(dstTexture), RenderTextureCopyLocation::Subresource(srcTexture), 0, 0, 0, nullptr);
+    }
+
+    RenderSampleCounts GLDevice::getSampleCountsSupported(RenderFormat format) const {
+        RenderSampleCounts counts = RenderSampleCount::COUNT_1;
+        GLDevice *self = const_cast<GLDevice *>(this);
+        const GLenum internalFormat = toGL(format).internalFormat;
+        self->thread.call([&]() {
+            if (GLCALL(glGetInternalformativ) == nullptr) {
+                return;
+            }
+
+            GLint sampleCountCount = 0;
+            GLCALL(glGetInternalformativ)(GL_TEXTURE_2D_MULTISAMPLE, internalFormat, GL_NUM_SAMPLE_COUNTS, 1, &sampleCountCount);
+            if (sampleCountCount <= 0) {
+                return;
+            }
+
+            std::vector<GLint> samples(size_t(sampleCountCount), 0);
+            GLCALL(glGetInternalformativ)(GL_TEXTURE_2D_MULTISAMPLE, internalFormat, GL_SAMPLES, sampleCountCount, samples.data());
+            for (GLint sample : samples) {
+                if ((sample > 0) && (sample <= RenderSampleCount::COUNT_MAX) && ((sample & (sample - 1)) == 0)) {
+                    counts |= RenderSampleCounts(sample);
+                }
+            }
+        });
+
+        return counts;
+    }
+
+    void GLCommandList::resolveTexture(const RenderTexture *dstTexture, const RenderTexture *srcTexture) {
+        resolveTextureRegion(dstTexture, 0, 0, srcTexture, nullptr, RenderResolveMode::AVERAGE);
+    }
+
+    void GLCommandList::resolveTextureRegion(const RenderTexture *dstTexture, uint32_t dstX, uint32_t dstY, const RenderTexture *srcTexture, const RenderRect *srcRect, RenderResolveMode resolveMode) {
+        const GLTexture *dst = static_cast<const GLTexture *>(dstTexture);
+        const GLTexture *src = static_cast<const GLTexture *>(srcTexture);
+        const RenderRect rect = (srcRect != nullptr) ? *srcRect : RenderRect(0, 0, int32_t(src->desc.width), int32_t(src->desc.height));
+        record([=](GLReplayState &state) {
+            const GLuint *scratch = src->device->scratchFramebuffers;
+            GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, scratch[0]);
+            GLCALL(glFramebufferTexture2D)(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, src->target, src->id, 0);
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, scratch[1]);
+            GLCALL(glFramebufferTexture2D)(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, dst->target, dst->id, 0);
+            GLCALL(glScissor)(0, 0, GLsizei(dst->desc.width), GLsizei(dst->desc.height));
+            const int32_t width = rect.right - rect.left;
+            const int32_t height = rect.bottom - rect.top;
+            GLCALL(glBlitFramebuffer)(rect.left, rect.top, rect.right, rect.bottom, GLint(dstX), GLint(dstY), GLint(dstX) + width, GLint(dstY) + height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, 0);
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, (state.framebuffer != nullptr) ? state.framebuffer->id : 0);
+            const RenderRect &scissor = state.scissor;
+            GLCALL(glScissor)(scissor.left, scissor.top, std::max(scissor.right - scissor.left, 0), std::max(scissor.bottom - scissor.top, 0));
+        });
+    }
+
+    // GLCommandQueue
+
+    std::unique_ptr<RenderCommandList> GLCommandQueue::createCommandList() {
+        return std::make_unique<GLCommandList>(device);
+    }
+
+    std::unique_ptr<RenderSwapChain> GLCommandQueue::createSwapChain(const RenderSwapChainDesc &desc) {
+        return std::make_unique<GLSwapChain>(device, desc);
+    }
+
+    void GLCommandQueue::executeCommandLists(const RenderCommandList **commandLists, uint32_t commandListCount, RenderCommandSemaphore **waitSemaphores, uint32_t waitSemaphoreCount, RenderCommandSemaphore **signalSemaphores, uint32_t signalSemaphoreCount, RenderCommandFence *signalFence) {
+        // All queues replay on the one GL thread in submission order, so semaphores need no work.
+        std::vector<std::shared_ptr<std::vector<GLCommand>>> lists;
+        for (uint32_t i = 0; i < commandListCount; i++) {
+            lists.emplace_back(static_cast<const GLCommandList *>(commandLists[i])->commands);
+        }
+
+        GLCommandFence *fence = static_cast<GLCommandFence *>(signalFence);
+        uint64_t fenceValue = 0;
+        if (fence != nullptr) {
+            std::unique_lock<std::mutex> lock(fence->mutex);
+            fenceValue = ++fence->submitted;
+        }
+
+        device->thread.post([lists, fence, fenceValue]() {
+            GLReplayState state;
+            bindCache.reset();
+            for (const auto &list : lists) {
+                for (const GLCommand &command : *list) {
+                    GLProf::Scope prof(command.target_type().name());
+                    command(state);
+                }
+            }
+
+            // No glFlush: everything runs on one context, and a flush splits the driver's render passes.
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, 0);
+            if (fence != nullptr) {
+                std::unique_lock<std::mutex> lock(fence->mutex);
+                fence->completed = std::max(fence->completed, fenceValue);
+                fence->condition.notify_all();
+            }
+        });
+    }
+
+    void GLCommandQueue::waitForCommandFence(RenderCommandFence *fence) {
+        GLCommandFence *glFence = static_cast<GLCommandFence *>(fence);
+        std::unique_lock<std::mutex> lock(glFence->mutex);
+        const uint64_t target = glFence->submitted;
+        glFence->condition.wait(lock, [&]() { return glFence->completed >= target; });
+    }
+
+    // GLSwapChain
+
+    GLSwapChain::GLSwapChain(GLDevice *device, const RenderSwapChainDesc &desc) : device(device), desc(desc) {
+        queryWindowSize(width, height);
+        device->thread.call([this]() { GLCALL(glGenFramebuffers)(1, &readFramebuffer); });
+        createTextures();
+        setVsyncEnabled(true);
+    }
+
+    GLSwapChain::~GLSwapChain() {
+        textures.clear();
+        const GLuint framebufferId = readFramebuffer;
+        device->thread.post([framebufferId]() { GLCALL(glDeleteFramebuffers)(1, &framebufferId); });
+    }
+
+    void GLSwapChain::queryWindowSize(uint32_t &w, uint32_t &h) const {
+        // The platform looks at EGL or the Wayland window, which has to happen on the thread that owns the context.
+        device->thread.call([&]() {
+            device->platform.windowSize(w, h);
+        });
+    }
+
+    void GLSwapChain::createTextures() {
+        textures.clear();
+        if ((width == 0) || (height == 0)) {
+            return;
+        }
+
+        const uint32_t count = std::max(desc.textureCount, 2U);
+        for (uint32_t i = 0; i < count; i++) {
+            RenderTextureDesc textureDesc = RenderTextureDesc::ColorTarget(width, height, desc.format);
+            textures.emplace_back(std::make_unique<GLTexture>(device, textureDesc));
+        }
+    }
+
+    bool GLSwapChain::acquireTexture(RenderCommandSemaphore *signalSemaphore, uint32_t *textureIndex) {
+        if (textures.empty()) {
+            return false;
+        }
+
+        *textureIndex = nextIndex;
+        nextIndex = (nextIndex + 1) % uint32_t(textures.size());
+        return true;
+    }
+
+    bool GLSwapChain::present(uint32_t textureIndex, RenderCommandSemaphore **waitSemaphores, uint32_t waitSemaphoreCount) {
+        if (textureIndex >= textures.size()) {
+            return false;
+        }
+
+        const GLTexture *texture = textures[textureIndex].get();
+        const GLint w = GLint(width);
+        const GLint h = GLint(height);
+        device->thread.call([&]() {
+            // The image is stored with row 0 at the top; the window's row 0 is at the bottom, so the blit flips it.
+            GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, readFramebuffer);
+            GLCALL(glFramebufferTexture2D)(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, texture->target, texture->id, 0);
+            GLCALL(glBindFramebuffer)(GL_DRAW_FRAMEBUFFER, 0);
+            // Blits are clipped by the scissor test; the whole image is copied.
+            GLCALL(glDisable)(GL_SCISSOR_TEST);
+            GLCALL(glBlitFramebuffer)(0, 0, w, h, 0, h, w, 0, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            GLCALL(glEnable)(GL_SCISSOR_TEST);
+            GLCALL(glBindFramebuffer)(GL_READ_FRAMEBUFFER, 0);
+            device->platform.swapBuffers();
+            glFrameCounter++;
+        });
+
+        return true;
+    }
+
+    bool GLSwapChain::resize() {
+        queryWindowSize(width, height);
+        createTextures();
+        nextIndex = 0;
+        return !textures.empty();
+    }
+
+    bool GLSwapChain::needsResize() const {
+        uint32_t w = 0;
+        uint32_t h = 0;
+        queryWindowSize(w, h);
+        return (w != width) || (h != height);
+    }
+
+    void GLSwapChain::setVsyncEnabled(bool enabled) {
+        vsyncEnabled = enabled;
+        device->thread.call([this]() {
+            device->platform.setSwapInterval(vsyncEnabled ? 1 : 0);
+        });
+    }
+
+    // Entry point.
+
+    std::unique_ptr<RenderInterface> CreateGLESInterface(RenderWindow renderWindow, RenderGLProfile profile) {
+        return std::make_unique<GLInterface>(renderWindow, profile);
+    }
+};
+
+#else
+
+namespace plume {
+    std::unique_ptr<RenderInterface> CreateGLESInterface(RenderWindow renderWindow, RenderGLProfile profile) {
+        // Windows (WGL) and Linux and Android (EGL) are built above. Other platforms have no OpenGL backend.
+        return nullptr;
+    }
+};
+
+#endif

+    // Vertex attribute layout of a format: component count, type, normalised, integer.
+    static void toGLVertexFormat(RenderFormat format, GLint &size, GLenum &type, GLboolean &normalized, bool &integer) {
+        normalized = GL_FALSE;
+        integer = false;
+        switch (format) {
+        case RenderFormat::R32G32B32A32_FLOAT: size = 4; type = GL_FLOAT; break;
+        case RenderFormat::R32G32B32_FLOAT: size = 3; type = GL_FLOAT; break;
+        case RenderFormat::R32G32_FLOAT: size = 2; type = GL_FLOAT; break;
+        case RenderFormat::R32_FLOAT: size = 1; type = GL_FLOAT; break;
+        case RenderFormat::R32G32B32A32_UINT: size = 4; type = GL_UNSIGNED_INT; integer = true; break;
+        case RenderFormat::R32G32_UINT: size = 2; type = GL_UNSIGNED_INT; integer = true; break;
+        case RenderFormat::R32_UINT: size = 1; type = GL_UNSIGNED_INT; integer = true; break;
+        case RenderFormat::R32_SINT: size = 1; type = GL_INT; integer = true; break;
+        case RenderFormat::R8G8B8A8_UNORM:
+        case RenderFormat::B8G8R8A8_UNORM: size = 4; type = GL_UNSIGNED_BYTE; normalized = GL_TRUE; break;
+        case RenderFormat::R8G8B8A8_UINT: size = 4; type = GL_UNSIGNED_BYTE; integer = true; break;
+        case RenderFormat::R16G16_FLOAT: size = 2; type = GL_HALF_FLOAT; break;
+        case RenderFormat::R16G16B16A16_FLOAT: size = 4; type = GL_HALF_FLOAT; break;
+        default: size = 4; type = GL_FLOAT; break;
+        }
+    }

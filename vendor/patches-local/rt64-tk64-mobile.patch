+    void GLCommandList::setVertexBuffers(uint32_t startSlot, const RenderVertexBufferView *views, uint32_t viewCount, const RenderInputSlot *inputSlots) {
+        std::vector<RenderVertexBufferView> copies;
+        if (views != nullptr) {
+            copies.assign(views, views + viewCount);
+        }
+
+        record([startSlot, copies](GLReplayState &state) {
+            for (uint32_t i = 0; i < 8; i++) {
+                state.vertexBufferViews[i] = RenderVertexBufferView();
+            }
+
+            for (size_t i = 0; (i < copies.size()) && ((startSlot + i) < 8); i++) {
+                state.vertexBufferViews[startSlot + i] = copies[i];
+            }
+        });
+    }

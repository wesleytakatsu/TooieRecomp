                     lock.unlock();
                     const std::string err = writeJob(d, number, job);
                     lock.lock();
-                    if (!err.empty()) { finishLocked(Result::ERROR, err); continue; }
+                    if (!err.empty()) { finishLocked(Result::FAILED, err); continue; }
                     saved = number;

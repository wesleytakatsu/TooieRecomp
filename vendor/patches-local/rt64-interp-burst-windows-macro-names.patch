# TooieRecomp local patch: rename interpBurst enumerators Reason::DUPLICATE -> DUPLICATE_KEY and Controller::Result::ERROR -> FAILED (Windows SDK macros DUPLICATE/nb30.h and ERROR/wingdi.h break the enums on MSVC/clang-cl). Printed names unchanged.
diff --git a/src/hle/rt64_interp_burst.h b/src/hle/rt64_interp_burst.h
index fef89a7..d33de6a 100644
--- a/src/hle/rt64_interp_burst.h
+++ b/src/hle/rt64_interp_burst.h
@@ -53,7 +53,7 @@ namespace interpBurst {
 
     enum class Reason : uint8_t {
         ACCEPTED, NO_META, NATIVE, PAUSED, FORCED_CURRENT, ENDPOINT_CURRENT, WEIGHT_RANGE, UNMATCHED,
-        META_MISMATCH, DUPLICATE, SURPLUS, COUNT
+        META_MISMATCH, DUPLICATE_KEY, SURPLUS, COUNT
     };
 
     inline const char *reasonName(Reason r) {
@@ -158,7 +158,7 @@ namespace interpBurst {
     class Controller {
     public:
         enum Phase : int { IDLE, REQUESTED, CAPTURING, FINISHING };
-        enum class Result : int { NONE, DONE, TIMEOUT, NO_INTERPOLATION_ACTIVE, ERROR };
+        enum class Result : int { NONE, DONE, TIMEOUT, NO_INTERPOLATION_ACTIVE, FAILED };
 
         explicit Controller(int64_t timeoutMs = kTimeoutMs, uint32_t images = kImages) : timeoutMs(timeoutMs), images(images) {}
 
@@ -228,10 +228,10 @@ namespace interpBurst {
             if ((r == Reason::ACCEPTED) && (meta.workloadId != presentWorkloadId)) r = Reason::META_MISMATCH;
             if (r == Reason::ACCEPTED) {

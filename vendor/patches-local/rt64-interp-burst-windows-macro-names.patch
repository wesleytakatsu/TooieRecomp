                 else if (!formatOk) {
-                    finishLocked(Result::ERROR, "UNSUPPORTED_FORMAT: scene target is not R8G8B8A8_UNORM (HDR); refusing to mis-encode");
+                    finishLocked(Result::FAILED, "UNSUPPORTED_FORMAT: scene target is not R8G8B8A8_UNORM (HDR); refusing to mis-encode");
                     return Reason::SURPLUS;
                 }
                 else {
@@ -264,7 +264,7 @@ namespace interpBurst {
 

-//
-// TK64
-//
-// Copyright (c) 2026 The TK64 contributors. Licensed under the MIT license. See LICENSE file for details.
-//
-
-#include "tk64_frame_stats.h"
-
-#include <chrono>
-#include <cstdio>
-#include <cstdlib>
-#include <cstring>
-#include <ctime>
-
-namespace tk64 {
-    static bool frameStatsEnabled() {
-        static const bool enabled = []() {
-            const char *value = std::getenv("TK64_FRAME_STATS");
-            return (value != nullptr) && (std::strcmp(value, "1") == 0);
-        }();
-
-        return enabled;
-    }
-
-    void framePresented() {
-        if (!frameStatsEnabled()) {
-            return;
-        }
-
-        // Only the present thread calls this, so the state needs no lock.
-        using Clock = std::chrono::steady_clock;
-        static Clock::time_point windowStart;
-        static Clock::time_point lastPresent;
-        static double worstMs = 0.0;
-        static unsigned frames = 0;
-        static bool started = false;
-
-        const Clock::time_point now = Clock::now();
-        if (!started) {
-            windowStart = now;
-            lastPresent = now;
-            started = true;
-        }
-
-        const double intervalMs = std::chrono::duration<double, std::milli>(now - lastPresent).count();
-        if (intervalMs > worstMs) {
-            worstMs = intervalMs;
-        }
-
-        lastPresent = now;
-        frames++;
-
-        if ((now - windowStart) >= std::chrono::seconds(1)) {
-            const std::time_t wall = std::time(nullptr);
-            std::tm local = {};
-#       ifdef _WIN32
-            localtime_s(&local, &wall);
-#       else
-            localtime_r(&wall, &local);
-#       endif
-            char clock[16];
-            std::strftime(clock, sizeof(clock), "%H:%M:%S", &local);
-            const double windowMs = std::chrono::duration<double, std::milli>(now - windowStart).count();
-            fprintf(stdout, "TK64: frames %s %u in %.0f ms, worst %.1f ms\n", clock, frames, windowMs, worstMs);
-            fflush(stdout);
-            windowStart = now;
-            worstMs = 0.0;
-            frames = 0;
-        }
-    }
-};

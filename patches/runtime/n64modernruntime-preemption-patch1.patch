diff --git a/ultramodern/src/intmask.cpp b/ultramodern/src/intmask.cpp
new file mode 100644
index 0000000..476a045
--- /dev/null
+++ b/ultramodern/src/intmask.cpp
@@ -0,0 +1,31 @@
+#include <cstdint>
+
+// PATCH 1: software interrupt-mask defaults only.
+// No osSetIntMask / __osDisableInt / __osRestoreInt / cop0_status_write
+// wiring. PATCH 2 owns those translations and the preemptible check.
+
+namespace ultramodern::intmask {
+
+constexpr uint32_t SR_IE = 0x00000001u;
+constexpr uint32_t SR_EXL = 0x00000002u;
+constexpr uint32_t SR_ERL = 0x00000004u;
+constexpr uint32_t SR_IMASK = 0x0000FF00u;
+constexpr uint32_t OS_IM_NONE = 0x00000001u;
+constexpr uint32_t OS_IM_ALL = 0x003FFF01u;
+constexpr uint32_t RCP_IMASK = 0x003F0000u;
+
+uint32_t g_mi_mask = 0x3Fu;
+uint32_t g_global_int_mask = ~0u;
+
+// Keep the TU live without exporting a PATCH 2 API.
+uint32_t default_status_reg() {
+    (void)SR_IE;
+    (void)SR_EXL;
+    (void)SR_ERL;
+    (void)SR_IMASK;
+    (void)OS_IM_NONE;
+    (void)RCP_IMASK;
+    return OS_IM_ALL;
+}
+
+} // namespace ultramodern::intmask
diff --git a/ultramodern/src/preemption.cpp b/ultramodern/src/preemption.cpp
new file mode 100644
index 0000000..12ae34a
--- /dev/null
+++ b/ultramodern/src/preemption.cpp
@@ -0,0 +1,33 @@
+#include "ultramodern/ultramodern.hpp"
+
+#include <atomic>
+
+// PATCH 1: infrastructure only. No epoch publication, no message drain,
+// no scheduler interaction. Env ULTRAMODERN_GUEST_PREEMPTION is PATCH 4.
+
+namespace {
+
+std::atomic<bool> g_guest_preemption_enabled{false};
+
+} // namespace
+
+void ultramodern::set_guest_preemption_safepoints(bool enabled) {
+    g_guest_preemption_enabled.store(enabled, std::memory_order_relaxed);
+}
+
+bool ultramodern::guest_preemption_safepoints_enabled() {
+    return g_guest_preemption_enabled.load(std::memory_order_relaxed);
+}
+
+extern "C" bool ultramodern_preemption_hint(void) {
+    // PATCH 1 stub: always false, even if the process flag was set.
+    // PATCH 2 will honor the flag and compare work_epoch vs TLS last_seen.
+    return false;
+}
+
+extern "C" void ultramodern_service_preemption(uint8_t* rdram, void* ctx) {
+    (void)rdram;
+    (void)ctx;
+    // PATCH 1 stub: safe if called, but must not drain external messages
+    // or reschedule guest threads.
+}
diff --git a/ultramodern/test/preemption_harness.cpp b/ultramodern/test/preemption_harness.cpp
new file mode 100644
index 0000000..0fc1631
--- /dev/null
+++ b/ultramodern/test/preemption_harness.cpp
@@ -0,0 +1,242 @@
+// PATCH 1 standalone harness for Hybrid F' guest preemption.
+// T01 is implemented against stub infrastructure (feature OFF).
+// T02–T12 are named placeholders: SKIPPED / NOT_IMPLEMENTED, not PASS.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+
+#include "ultramodern/ultra64.h"
+#include "ultramodern/ultramodern.hpp"
+
+extern "C" void yield_self_1ms(uint8_t* rdram);
+
+// Provided by librecomp in the game. The harness supplies the same symbols
+// so it can link ultramodern alone.
+std::atomic_bool exited{false};
+
+namespace {
+
+int g_pass = 0;
+int g_fail = 0;
+int g_skip = 0;
+
+#define CHECK(cond)                                                          \
+    do {                                                                     \
+        if (cond) {                                                          \
+            ++g_pass;                                                        \
+        } else {                                                             \
+            ++g_fail;                                                        \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); \
+        }                                                                    \
+    } while (0)
+
+void skip(const char* id, const char* why) {
+    ++g_skip;
+    std::printf("SKIPPED %s — %s\n", id, why);
+}
+
+constexpr uint32_t kGuestBase = 0x80000000u;
+constexpr size_t kRdramBytes = 0x8000;
+constexpr uint32_t kOffMainThread = 0x1000;
+constexpr uint32_t kOffAudioThread = 0x1100;
+constexpr uint32_t kOffAudioMq = 0x1200;
+constexpr uint32_t kOffDummyMq = 0x1280;
+constexpr uint32_t kOffAudioMsg = 0x1300;
+constexpr uint32_t kOffDummyMsg = 0x1340;
+constexpr uint32_t kOffMainSp = 0x2000;
+constexpr uint32_t kOffAudioSp = 0x3000;
+
+constexpr int32_t kEntryMain = 1;
+constexpr int32_t kEntryAudio = 2;
+constexpr OSPri kPriMain = 20;
+constexpr OSPri kPriAudio = 50;
+
+uint8_t* g_rdram = nullptr;
+
+PTR(void) gptr(uint32_t off) {
+    return static_cast<int32_t>(kGuestBase + off);
+}
+
+template <typename Pred>
+bool wait_until(Pred pred, int timeout_ms) {
+    const auto start = std::chrono::steady_clock::now();
+    while (!pred()) {
+        if (std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - start)
+                .count() > timeout_ms) {
+            return false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    return true;
+}
+
+struct CoopState {
+    std::atomic<bool> audio_blocked{false};
+    std::atomic<bool> audio_ran{false};
+    std::atomic<bool> service_did_not_wake{false};
+    std::atomic<bool> host_enqueued{false};
+    std::atomic<bool> main_resumed{false};
+    std::atomic<bool> send_recv_ok{false};
+};
+
+CoopState* g_coop = nullptr;
+
+void audio_entry(uint8_t* rdram, uint64_t /*arg*/) {
+    g_coop->audio_blocked.store(true, std::memory_order_release);
+    OSMesg got = 0;
+    const s32 rc = osRecvMesg(rdram, gptr(kOffAudioMq), gptr(kOffAudioMsg), OS_MESG_BLOCK);
+    (void)got;
+    if (rc == 0) {
+        g_coop->audio_ran.store(true, std::memory_order_release);
+    }
+    // Park so the token returns to MAIN via the existing coop path.
+    osRecvMesg(rdram, gptr(kOffAudioMq), gptr(kOffAudioMsg), OS_MESG_BLOCK);
+}
+
+void main_entry(uint8_t* rdram, uint64_t /*arg*/) {
+    // Same-thread cooperative send/recv must still work.
+    const OSMesg sent = 42;
+    const s32 send_rc = osSendMesg(rdram, gptr(kOffDummyMq), sent, OS_MESG_NOBLOCK);
+    const s32 recv_rc = osRecvMesg(rdram, gptr(kOffDummyMq), gptr(kOffDummyMsg), OS_MESG_NOBLOCK);
+    const OSMesg got = *TO_PTR(OSMesg, gptr(kOffDummyMsg));
+    g_coop->send_recv_ok.store(send_rc == 0 && recv_rc == 0 && got == sent, std::memory_order_release);
+
+    osStartThread(rdram, gptr(kOffAudioThread));
+
+    while (!g_coop->audio_blocked.load(std::memory_order_acquire)) {
+        std::this_thread::yield();
+    }
+
+    // Service stub must not drain the external queue or wake AUDIO.
+    ultramodern_service_preemption(rdram, nullptr);
+    if (!g_coop->audio_ran.load(std::memory_order_acquire)) {
+        g_coop->service_did_not_wake.store(true, std::memory_order_release);
+    }
+
+    while (!g_coop->host_enqueued.load(std::memory_order_acquire)) {
+        std::this_thread::yield();
+    }
+
+    // Existing cooperative drain: osSendMesg dequeues externals then
+    // check_running_queue. Feature is OFF; this is not service().
+    (void)osSendMesg(rdram, gptr(kOffDummyMq), 1, OS_MESG_NOBLOCK);
+
+    g_coop->main_resumed.store(true, std::memory_order_release);
+
+    // Stay on the token without blocking-recv (that calls run_next_thread
+    // and throws "No threads left" when AUDIO is also parked).
+    while (true) {
+        yield_self_1ms(rdram);
+    }
+}
+
+} // namespace
+
+void run_thread_function(uint8_t* rdram, uint64_t addr, uint64_t /*sp*/, uint64_t arg) {
+    switch (static_cast<int32_t>(addr)) {
+        case kEntryMain:
+            main_entry(rdram, arg);
+            break;
+        case kEntryAudio:
+            audio_entry(rdram, arg);
+            break;
+        default:
+            std::fprintf(stderr, "unknown harness entry %d\n", static_cast<int32_t>(addr));
+            std::abort();
+    }
+}
+
+namespace {
+
+void t01_flag_and_hint() {
+    std::printf("T01-A flag/hint/service isolation\n");
+    CHECK(ultramodern::guest_preemption_safepoints_enabled() == false);
+    CHECK(ultramodern_preemption_hint() == false);
+
+    ultramodern::set_guest_preemption_safepoints(true);
+    CHECK(ultramodern::guest_preemption_safepoints_enabled() == true);
+    CHECK(ultramodern_preemption_hint() == false); // PATCH 1 stub
+
+    ultramodern::set_guest_preemption_safepoints(false);
+    CHECK(ultramodern::guest_preemption_safepoints_enabled() == false);
+    CHECK(ultramodern_preemption_hint() == false);
+
+    ultramodern_service_preemption(nullptr, nullptr);
+}
+
+void t01_cooperative_scheduler() {
+    std::printf("T01-B cooperative scheduler regression (feature OFF)\n");
+
+    g_rdram = new uint8_t[kRdramBytes]{};
+    CoopState coop{};
+    g_coop = &coop;
+
+    osCreateMesgQueue(g_rdram, gptr(kOffAudioMq), gptr(kOffAudioMsg), 4);
+    osCreateMesgQueue(g_rdram, gptr(kOffDummyMq), gptr(kOffDummyMsg), 4);
+
+    osCreateThread(g_rdram, gptr(kOffMainThread), 6, kEntryMain, 0, gptr(kOffMainSp), kPriMain);
+    osCreateThread(g_rdram, gptr(kOffAudioThread), 4, kEntryAudio, 0, gptr(kOffAudioSp), kPriAudio);
+
+    CHECK(ultramodern_preemption_hint() == false);
+    CHECK(ultramodern::guest_preemption_safepoints_enabled() == false);
+
+    osStartThread(g_rdram, gptr(kOffMainThread));
+
+    CHECK(wait_until([&] { return coop.audio_blocked.load(std::memory_order_acquire); }, 2000));
+    CHECK(coop.audio_ran.load(std::memory_order_acquire) == false);
+
+    // Host-side enqueue. With feature OFF this only becomes visible on the
+    // existing osSend/osRecv/yield cooperative drain.
+    ultramodern::enqueue_external_message(gptr(kOffAudioMq), 7, false, false);
+    coop.host_enqueued.store(true, std::memory_order_release);
+
+    CHECK(wait_until([&] { return coop.audio_ran.load(std::memory_order_acquire); }, 2000));
+    CHECK(wait_until([&] { return coop.main_resumed.load(std::memory_order_acquire); }, 2000));
+    CHECK(coop.service_did_not_wake.load(std::memory_order_acquire));
+    CHECK(coop.send_recv_ok.load(std::memory_order_acquire));
+    CHECK(ultramodern_preemption_hint() == false);
+
+    // Guest threads remain parked until process exit. Do not free rdram
+    // while they still touch it, and do not let them return from
+    // run_thread_function (that throws "No threads left to run!").
+    g_rdram = nullptr;
+    g_coop = nullptr;
+}
+
+void t_not_implemented(const char* id, const char* title) {
+    skip(id, title);
+}
+
+} // namespace
+
+int main() {
+    t01_flag_and_hint();
+    t01_cooperative_scheduler();
+
+    t_not_implemented("T02", "high-priority async preemption — PATCH 2");
+    t_not_implemented("T03", "interrupts-disabled no-preempt — PATCH 2");
+    t_not_implemented("T04", "pending event after interrupt re-enable — PATCH 2");
+    t_not_implemented("T05", "same-priority no-preempt — PATCH 2");
+    t_not_implemented("T06", "lower-priority no-preempt — PATCH 2");
+    t_not_implemented("T07", "simultaneous VI+AI — PATCH 2");
+    t_not_implemented("T08", "lost-wakeup stress — PATCH 2");
+    t_not_implemented("T09", "repeated thread swaps — PATCH 2");
+    t_not_implemented("T10", "message ordering — PATCH 2");
+    t_not_implemented("T11", "static vs LiveRecomp equivalence — PATCH 3");
+    t_not_implemented("T12", "threadqueue Fix B unit test (NEW; no pre-existing harness) — PATCH 2");
+
+    std::printf("T01 %s  (pass=%d fail=%d skipped=%d)\n",
+                g_fail == 0 ? "PASS" : "FAIL", g_pass, g_fail, g_skip);
+    std::fflush(stdout);
+    std::fflush(stderr);
+    // Parked guest OSThreads throw "No threads left to run!" if they
+    // return during process teardown. PATCH 1 does not own thread
+    // lifetime; skip destructors after the report.
+    std::_Exit(g_fail == 0 ? 0 : 1);
+}

+// PATCH 2 standalone harness for Hybrid F' guest preemption.
+// T01 repaired (service after enqueue). T02–T10 and T12 implemented.
+// T11 is PATCH 3. Threaded tests run in a child process so leftover
+// guest std::threads cannot poison later cases.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <sys/wait.h>

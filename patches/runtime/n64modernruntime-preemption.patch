+    osStartThread(rdram, gptr(kOffWaiterThread));
+    g_coop->started_waiter.store(true, std::memory_order_release);
+    while (!g_coop->host_enqueued.load(std::memory_order_acquire)) {
+        std::this_thread::yield();

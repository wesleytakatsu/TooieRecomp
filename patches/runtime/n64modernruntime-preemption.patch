+    CHECK(ultramodern::held_ineligible_count() == 1);
+    CHECK(ultramodern::held_ineligible_cause_at(0) == ultramodern::InterruptCause::AI);
+    (void)ultramodern::intmask::apply_os_set_int_mask(

+using test_fn = void (*)();
+
+int run_isolated(const char* id, test_fn fn) {
+    std::fflush(stdout);
+    std::fflush(stderr);
+    const pid_t pid = fork();
+    if (pid < 0) {
+        std::perror("fork");
+        ++g_fail;
+        return 1;
+    }
+    if (pid == 0) {
+        g_pass = 0;
+        g_fail = 0;
+        fn();
+        std::fflush(stdout);
+        std::fflush(stderr);
+        std::_Exit(g_fail == 0 ? 0 : 1);
+    }
+    int st = 0;
+    if (waitpid(pid, &st, 0) < 0) {
+        std::perror("waitpid");
+        ++g_fail;
+        return 1;
+    }
+    if (WIFEXITED(st) && WEXITSTATUS(st) == 0) {
+        ++g_pass;
+        std::printf("%s PASS\n", id);
+        return 0;
+    }
+    ++g_fail;
+    std::printf("%s FAIL status=%d\n", id, st);
+    return 1;
+}

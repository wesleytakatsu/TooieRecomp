+    CHECK(ultramodern::held_ineligible_count() == 0);
+    (void)ultramodern::intmask::apply_os_set_int_mask(
+        rdram, &g_coop->status, ultramodern::intmask::OS_IM_VI);
+    ultramodern::service_preemption(rdram, &g_coop->status);

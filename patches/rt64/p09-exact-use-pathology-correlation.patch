+        // Eligibility walk. Caller enters only for P09PreWalk::Walk.
+        // Waiting, exhaustion, and cooldown must not enter here.
+        // dispatchesSeen counts walks only.
+        bool p09CorrGate(const RSPProcessor::ProcessParams &p, P09RspEndpointBindingStats &st,
+            uint32_t dispatchVertexCount, uint64_t nowMs) {
+            P09CorrSession &cs = g_p09Corr;
+            cs.dispatchesSeen++;
+            P09CorrelationEligibilityInput in;
+            if ((p.workloadQueue != nullptr) && (p.workloadIndex < WORKLOAD_QUEUE_SIZE) &&
+                (p.curFrame != nullptr) && (p.prevFrame != nullptr)) {
+                const Workload &workload = p.workloadQueue->workloads[p.workloadIndex];
+                in.hasWorkload = (workload.workloadId != 0);
+                if (in.hasWorkload) {
+                    const DrawData &dd = workload.drawData;
+                    in.hasGeometry = (dispatchVertexCount > 0u) && (dd.vertexCount() > 0u) &&
+                        !dd.faceIndices.empty() && (workload.fbPairCount > 0u);
+                    const GameFrameMap::WorkloadMap *map = (p.workloadIndex < p.curFrame->frameMap.workloads.size())
+                        ? &p.curFrame->frameMap.workloads[p.workloadIndex] : nullptr;
+                    in.frameMatched = p.prevFrame->matched && (map != nullptr) && map->mapped;
+                    in.intermediate = (p.curFrameWeight > 1.0e-4f) && (p.curFrameWeight < (1.0f - 1.0e-4f));
+                    const uint64_t modelBin = p09ResolveModelBin(st);
+                    in.hasModelBin = (modelBin != 0);
+                    if (in.hasGeometry && in.hasModelBin) {
+                        for (uint32_t f = 0; f < workload.fbPairCount && !in.hasTargetCall; f++) {
+                            const FramebufferPair &fbPair = workload.fbPairs[f];
+                            for (uint32_t pr = 0; pr < fbPair.projectionCount && !in.hasTargetCall; pr++) {
+                                const Projection &proj = fbPair.projections[pr];
+                                for (uint32_t d = 0; d < proj.gameCallCount; d++) {
+                                    const GameCall &call = proj.gameCalls[d];
+                                    if ((call.callDesc.triangleCount > 0u) &&
+                                        (p09V4VisibleTargetIndex(call.callDesc.sourceDl, modelBin) >= 0)) {
+                                        in.hasTargetCall = true;
+                                        break;
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            return p09CorrelationDecide(cs.budget, p09CorrelationEligibility(in), &nowMs) == P09CorrelationDecision::Collect;
+        }

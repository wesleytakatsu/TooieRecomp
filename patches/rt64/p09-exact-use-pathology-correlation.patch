+        void p09CorrNotePendingPair(P09CorrAttempt &at, const P09JoinVert &child, const P09JoinVert &parent,
+            bool tie, bool pathological) {
+            if (pathological) {
+                at.pathPairs++;
+            }
+            P09CorrPendingPair pending;
+            pending.a = child.key;
+            pending.b = parent.key;
+            pending.aOk = child.keyOk;
+            pending.bOk = parent.keyOk;
+            pending.tie = tie;
+            pending.pathological = pathological;
+            if (!p09ExactUseAppendCapped(at.pairs, kP09ExactUseMaxPendingPairs, at.pairsDroppedCap, pending)) {
+                return;
+            }
+        }

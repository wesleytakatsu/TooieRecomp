+        // Second pass over the same prev/cur filter and the same gap==bestGap
+        // test the selector used. Does not change best, bestTie, or counters.
+        void p09CorrRecordPathologicalTie(const P09CorrAttempt &at, const P09JoinVert &child,
+            const std::vector<P09JoinVert> &parents, size_t best, float bestGap) {
+            P09TieMemberInput members[kP09TieMemberCap];
+            uint32_t stored = 0;
+            uint32_t multiplicity = 0;
+            for (size_t pi = 0; pi < parents.size(); pi++) {
+                const P09JoinVert &parent = parents[pi];
+                if (!parent.prevOk || !parent.curOk || !child.prevOk || !child.curOk) {
+                    continue;
+                }
+                const float gap = p09NdcDistXY(child.prev, parent.prev) + p09NdcDistXY(child.cur, parent.cur);
+                if (gap != bestGap) {
+                    continue;
+                }
+                multiplicity++;
+                if (stored >= uint32_t(kP09TieMemberCap)) {
+                    continue;
+                }
+                P09TieMemberInput &m = members[stored];
+                m = P09TieMemberInput{};
+                m.key = parent.key;
+                m.keyComplete = parent.keyOk;
+                m.selected = (pi == best);
+                m.gap = gap;
+                m.gapEqualsBest = true;
+                m.prevNdcX = parent.prev.x;
+                m.prevNdcY = parent.prev.y;
+                m.curNdcX = parent.cur.x;
+                m.curNdcY = parent.cur.y;
+                m.prevNdcOk = parent.prevOk;
+                m.curNdcOk = parent.curOk;
+                if (parent.prevWorldOk) {
+                    m.prevWorldX = parent.prevWorld.x;
+                    m.prevWorldY = parent.prevWorld.y;
+                    m.prevWorldZ = parent.prevWorld.z;
+                    m.prevWorldOk = true;
+                }
+                if (parent.curWorldOk) {
+                    m.curWorldX = parent.curWorld.x;
+                    m.curWorldY = parent.curWorld.y;
+                    m.curWorldZ = parent.curWorld.z;
+                    m.curWorldOk = true;
+                }
+                stored++;
+            }
+            P09TieGroupInput in;
+            in.child = child.key;
+            in.childComplete = child.keyOk;
+            in.bestGap = bestGap;
+            in.multiplicity = multiplicity;
+            in.attemptGeneration = at.generation;
+            in.members = members;
+            in.memberCount = stored;
+            p09TieSampleRecord(g_p09Corr.tieSample, in);
+        }

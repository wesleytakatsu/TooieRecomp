+        // At most once per second, and once on the first enabled dispatch.
+        // Removal runs before any arm, rearm, or stale count. Failure leaves
+        // the session unchanged and latches in the shared controller.
+        void p09CorrPollArm(uint64_t nowMs) {
+            P09CorrSession &cs = g_p09Corr;
+            if (cs.armPollStarted && ((nowMs - cs.lastArmPollMs) < 1000ull)) {
+                return;
+            }
+            cs.armPollStarted = true;
+            cs.lastArmPollMs = nowMs;
+            const bool visible = p09CorrMarkerVisible();
+            bool consumed = false;
+            if (visible) {
+                consumed = (::remove(kP09CorrArmPath) == 0);
+            }
+            const P09ArmEvent ev = p09CaptureObserveMarker(cs.capture, visible, consumed);
+            if (ev == P09ArmEvent::Rearmed) {
+                p09CorrResetCorrelationOnly();
+            }
+        }

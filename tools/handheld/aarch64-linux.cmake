# Cross-compiles for aarch64 Linux handhelds with clang and lld, from a Windows or Linux host.
# HANDHELD_SYSROOT: the sysroot from tools/handheld/fetch_sysroot.py (Debian 12 arm64, glibc older than the devices').
# HANDHELD_DEVICE: a file in tools/handheld/devices (default rk3326). HANDHELD_LLVM: folder of clang, lld and llvm-ar; empty uses
# PATH, and on Windows build-handheld.ps1 passes Visual Studio's. The XU10_* names of the first port are still read.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

# try_compile runs this file again in a new project, which sees only the environment.
foreach(name SYSROOT DEVICE LLVM)
  if(NOT DEFINED HANDHELD_${name})
    if(DEFINED ENV{HANDHELD_${name}})
      set(HANDHELD_${name} "$ENV{HANDHELD_${name}}")
    elseif(DEFINED ENV{XU10_${name}})
      set(HANDHELD_${name} "$ENV{XU10_${name}}")
    endif()
  endif()
  if(DEFINED HANDHELD_${name})
    file(TO_CMAKE_PATH "${HANDHELD_${name}}" HANDHELD_${name})
    set(ENV{HANDHELD_${name}} "${HANDHELD_${name}}")
  endif()
endforeach()

if(NOT HANDHELD_SYSROOT)
  message(FATAL_ERROR "Set HANDHELD_SYSROOT to the sysroot from tools/handheld/fetch_sysroot.py")
endif()
if(NOT HANDHELD_DEVICE)
  set(HANDHELD_DEVICE rk3326)
endif()
set(HANDHELD_DEVICE_FILE "${CMAKE_CURRENT_LIST_DIR}/devices/${HANDHELD_DEVICE}.cmake")
if(NOT EXISTS "${HANDHELD_DEVICE_FILE}")
  message(FATAL_ERROR "No device file ${HANDHELD_DEVICE_FILE}")
endif()
include("${HANDHELD_DEVICE_FILE}")

set(CMAKE_SYSROOT "${HANDHELD_SYSROOT}")

if(CMAKE_HOST_WIN32)
  set(HANDHELD_EXE ".exe")
else()
  set(HANDHELD_EXE "")
endif()
if(HANDHELD_LLVM)
  set(HANDHELD_LLVM_PREFIX "${HANDHELD_LLVM}/")
else()
  set(HANDHELD_LLVM_PREFIX "")
endif()
set(CMAKE_C_COMPILER "${HANDHELD_LLVM_PREFIX}clang${HANDHELD_EXE}")
set(CMAKE_CXX_COMPILER "${HANDHELD_LLVM_PREFIX}clang++${HANDHELD_EXE}")
set(CMAKE_ASM_COMPILER "${HANDHELD_LLVM_PREFIX}clang${HANDHELD_EXE}")
set(CMAKE_AR "${HANDHELD_LLVM_PREFIX}llvm-ar${HANDHELD_EXE}" CACHE FILEPATH "")
set(CMAKE_RANLIB "${HANDHELD_LLVM_PREFIX}llvm-ranlib${HANDHELD_EXE}" CACHE FILEPATH "")
set(CMAKE_STRIP "${HANDHELD_LLVM_PREFIX}llvm-strip${HANDHELD_EXE}" CACHE FILEPATH "")
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET aarch64-linux-gnu)

set(HANDHELD_ARCH_FLAGS "${HANDHELD_CPU_FLAGS} -ffp-contract=off -fno-omit-frame-pointer")
set(CMAKE_C_FLAGS_INIT "${HANDHELD_ARCH_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${HANDHELD_ARCH_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -Wl,--allow-shlib-undefined")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")

set(CMAKE_FIND_ROOT_PATH "${HANDHELD_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_LIBRARY_ARCHITECTURE aarch64-linux-gnu)

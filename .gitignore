# --- Standalone vendoring (vendor/README.md) ---------------------------------------------------------------------------
# lib/, decomp/, assets/ and tools/wheelhouse/ are REGULAR tracked content (no submodules/gitlinks/third_party clones).
# The upstream Git-only control files (.gitignore/.gitattributes/.gitmodules/.github) were intentionally NOT imported; the
# rules that kept private / generated / proprietary-toolchain files out of git upstream are translated to the new prefix here.
# decomp/ is vendored SOURCE ONLY. tools/build_linux.sh runs it in <build>/decomp-work, but guard in-tree runs too:
/decomp/baserom*.z64
# rom_decompressor writes ROM-derived assets/overlays/*/relocs.bin relative to its CWD (tools/extract_rom.sh runs it in a work dir): never versioned
/assets/overlays/
/decomp/baseroms/
/decomp/decompressed*
/decomp/asm/
/decomp/assets/
/decomp/build/
/decomp/bin/
/decomp/mod/
/decomp/banjotooie.ld
/decomp/*.map
/decomp/*auto*.txt
/decomp/.splat_cache*
/decomp/.venv/
/decomp/venv/
/decomp/tools/ido/
/decomp/tools/rom_decompressor
/decomp/tools/syscall_builder
/decomp/tools/overlay_processor
/decomp/tools/rom_compressor
/decomp/tools/n64crc
/decomp/tools/*.o
/decomp/lib/ultralib/tools/ido/
/decomp/lib/ultralib/tools/gcc/
/decomp/lib/ultralib/build/
/decomp/lib/ultralib/extracted/
/decomp/lib/ultralib/base_*/
# Legacy MIPS compiler kit (licence UNVERIFIED, explicit input): never inside the repo
/toolchain-kit/
